# ---------------------------------------------------------------- server
PORT=3000
NODE_ENV=development
# "true" behind a reverse proxy (Render, Nginx) so HTTPS and the client IP are detected.
TRUST_PROXY=false
# Public HTTPS address of the store, e.g. https://havenlume.onrender.com (no trailing slash).
# Required for iyzico (callback URL) and used for the origin check.
PUBLIC_URL=
# SQLite file. On Render, point this to a persistent disk, e.g. /var/data/havenlume.sqlite
DB_PATH=./data/havenlume.sqlite
# Daily backups are written next to the database (BACKUP_DIR) and the last BACKUP_KEEP are kept.
# BACKUP_DIR=./data/backups
BACKUP_KEEP=14
# Long random value; keeps order-status links valid across restarts.
STATUS_LINK_SECRET=

# ---------------------------------------------------------------- admin
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your long password"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HOURS=8

# ---------------------------------------------------------------- store
STORE_NAME=HavenLume
STORE_SUPPORT_EMAIL=
# Legal seller name and address shown in the Terms of Sale.
STORE_BUSINESS_NAME=
STORE_BUSINESS_ADDRESS=
STORE_PRICE_USD=74.99
# Shipping charged to the customer per order (0 = free shipping).
STORE_SHIPPING_USD=0
RETURN_WINDOW_DAYS=30
# Supplier's product reference used in the "Copy Supplier Order" text.
SUPPLIER_PRODUCT_SKU=
SUPPLIER_INSTRUCTIONS=
# Delivery estimate from the supplier. It is only shown to customers once verified.
SUPPLIER_MIN_DELIVERY_DAYS=2
SUPPLIER_MAX_DELIVERY_DAYS=8
DELIVERY_ESTIMATE_VERIFIED=false

# ---------------------------------------------------------------- payments (iyzico)
# Sandbox (free, test cards only): https://sandbox-merchant.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_URI=https://sandbox-api.iyzipay.com
# Live: IYZICO_URI=https://api.iyzipay.com — only works when BOTH flags below are true.
LIVE_PAYMENTS_ENABLED=false
PRODUCT_COMPLIANCE_VERIFIED=false
# iyzico requires a buyer identity number. Ask iyzico what to send for non-Turkish buyers.
IYZICO_BUYER_IDENTITY_NUMBER=11111111111
# Reject webhooks without a valid X-IYZ-SIGNATURE-V3 (ask iyzico to enable signatures).
IYZICO_REQUIRE_WEBHOOK_SIGNATURE=true

# ---------------------------------------------------------------- email & alerts
# Resend (https://resend.com). Without these, emails are prepared in the admin, not sent.
RESEND_API_KEY=
EMAIL_FROM=
# New paid orders and contact messages: email and/or Discord/Slack webhook.
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_WEBHOOK_URL=

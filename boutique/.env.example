PORT=3000
NODE_ENV=development
# Set to "true" when running behind a reverse proxy (Render, Nginx...) so HTTPS is detected.
TRUST_PROXY=false
# Public URL of the store (e.g. https://shop.example.com) — required for iyzico's
# callback URL, and used for the origin check.
PUBLIC_URL=
DB_PATH=./data/havenlume.sqlite

# Admin — generate the hash with the command in README.md
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Pricing / supplier references (USD)
STORE_PRICE_USD=74.99
SUPPLIER_PRODUCT_COST_USD=27.24
SUPPLIER_SHIPPING_COST_USD=15
SUPPLIER_MIN_DELIVERY_DAYS=2
SUPPLIER_MAX_DELIVERY_DAYS=8

# Store currency sent to iyzico (USD, EUR, TRY, GBP...). Your iyzico merchant
# account must be enabled for this currency.
STORE_CURRENCY=USD

# iyzico card payments (hosted Checkout Form).
# Sandbox (free, test cards only): https://sandbox-merchant.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_URI=https://sandbox-api.iyzipay.com
# Live: IYZICO_URI=https://api.iyzipay.com — only works if BOTH flags below are true.
# Identity number sent for buyers (iyzico requires one). Confirm with iyzico what
# to send for non-Turkish buyers before going live.
IYZICO_BUYER_IDENTITY_NUMBER=11111111111

# Keep these false until a real payment provider and compliance review are done.
# Live iyzico checkout stays disabled unless BOTH are "true".
LIVE_PAYMENTS_ENABLED=false
PRODUCT_COMPLIANCE_VERIFIED=false

PORT=3000
NODE_ENV=development
# Set to "true" when running behind a reverse proxy (Render, Nginx...) so HTTPS is detected.
TRUST_PROXY=false
# Public URL of the store (e.g. https://shop.example.com) — used for the origin check.
PUBLIC_URL=
DB_PATH=./data/havenlume.sqlite

# Admin — generate the hash with the command in README.md
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Pricing / supplier references (USD)
STORE_PRICE_USD=74.99
SUPPLIER_PRODUCT_COST_USD=27.24
SUPPLIER_SHIPPING_COST_USD=15
SUPPLIER_MIN_DELIVERY_DAYS=2
SUPPLIER_MAX_DELIVERY_DAYS=8

# Keep these false until a real payment provider and compliance review are done.
LIVE_PAYMENTS_ENABLED=false
PRODUCT_COMPLIANCE_VERIFIED=false

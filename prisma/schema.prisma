// ── Intelligence ─────────────────────────────────────────────────────────────

// ── Référentiels ─────────────────────────────────────────────────────────────

/// Pays desservi par Touma. Le corridor pilote (TD, CM) est une simple donnée :
/// ouvrir un nouveau marché = insérer une ligne, sans toucher au code.
/// Cycle de vie d'un marché (V26 §2, §3).
///
/// Trois booléens tenaient lieu d'état : `active`, `buyingEnabled`,
/// `sellingEnabled`. Ils disent ce qui est *ouvert*, jamais où en est le
/// marché — et surtout, rien n'empêchait de passer `active` à vrai sans la
/// moindre dépendance configurée. Le Cameroun était dans ce cas : déclaré
/// actif, aucune géographie, aucun transporteur réel. C'est précisément le
/// « faux pays » que §79 interdit, et il était déjà dans le seed.
///
/// L'ordre compte : une activation ne saute pas d'étape.
enum CountryStatus {
  /// Le marché est envisagé. Rien n'est configuré.
  PLANNED
  /// Configuration en cours : devise, langues, géographie, prestataires.
  CONFIGURING
  /// Configuré, en cours de vérification technique.
  TESTING
  /// Ouvert à un volume limité, sous surveillance.
  PILOT
  /// Ouvert.
  ACTIVE
  /// Ouvert avec restrictions — un service au moins est indisponible.
  LIMITED
  /// Fermé aux nouvelles transactions. L'historique reste lisible et les
  /// commandes en cours continuent d'être traitées (§45).
  SUSPENDED
  /// Marché abandonné. Conservé pour l'historique.
  DEPRECATED
}

model Country {
  /// ISO-3166-1 alpha-2 (TD, CM, NG, CI…).
  code           String        @id
  name           String
  /// Nom du pays dans sa langue principale. Nul quand on ne le sait pas :
  /// une translittération inventée vaut moins qu'une absence.
  nativeName     String?
  /// Devise par défaut du pays (ISO-4217, ex. XAF).
  currency       String
  /// Indicatif téléphonique international (ex. +235).
  dialCode       String        @default("")
  /// Fuseau horaire IANA (ex. Africa/Ndjamena). Une date de livraison affichée
  /// dans le fuseau du serveur est fausse pour celui qui attend le colis.
  timezone       String        @default("UTC")
  /// Où en est ce marché. `PLANNED` par défaut : un pays n'est jamais ouvert
  /// parce qu'on a inséré sa ligne.
  status         CountryStatus @default(PLANNED)
  /// Le pays accepte-t-il les commandes / les vendeurs ?
  ///
  /// Ces interrupteurs restent, et ne font pas double emploi avec `status` :
  /// ils portent §46 — un marché ouvert dont un service est suspendu. Le
  /// statut dit où en est le pays, ceux-ci ce qui est ouvert aujourd'hui.
  buyingEnabled  Boolean       @default(true)
  sellingEnabled Boolean       @default(true)
  active         Boolean       @default(true)

  users     User[]
  stores    ToumaStore[]
  addresses ToumaAddress[]
  products  ToumaProduct[]
  provinces ToumaProvince[]

  /// Configuration **commerciale** du pays (V24). Distincte de son identité :
  /// un pays peut exister sans commercer.
  tradeConfig ToumaTradeCountryConfig?

  /// Journal des changements de statut (V26 §44) : qui a activé quoi, quand,
  /// et sur la foi de quel contrôle de préparation.
  statusChanges  ToumaCountryStatusChange[]
  /// Niveaux administratifs de ce pays (V26 §7).
  divisionLevels ToumaCountryDivisionLevel[]
  /// Prestataires raccordés à ce marché (V26 §11).
  providers      ToumaCountryProvider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_countries")
}

// ── Géographie administrative ────────────────────────────────────────────────
//
// Jusqu'ici une localisation était une chaîne saisie à la main : « N'Djamena »,
// « Ndjamena » et « N’Djaména » étaient trois villes différentes pour la base,
// et aucun regroupement, aucun filtre, aucune statistique par province n'était
// possible. Ces quatre tables remplacent le texte libre par une hiérarchie
// officielle.
//
// Les données viennent de GeoNames (CC BY 4.0) et sont chargées par un seed
// reproductible. Ce que la source ne dit pas n'est pas inventé : voir
// docs/chad-geography-sources.md.

/// Type d'une localité. Prudent par construction : la source distingue la
/// capitale et les chefs-lieux, mais ne dit pas si un lieu habité est une ville
/// ou un village. Tout le reste est donc LOCALITY plutôt qu'affirmé.
enum LocalityType {
  CITY
  TOWN
  /// Section d'une ville — les arrondissements de N'Djamena en relèvent.
  DISTRICT
  VILLAGE
  RURAL_AREA
  /// Lieu habité que la source ne qualifie pas davantage.
  LOCALITY
  OTHER
}

/// Premier niveau administratif (ADM1). 23 au Tchad.
model ToumaProvince {
  id          String   @id @default(cuid())
  countryCode String
  country     Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  /// Code officiel du niveau dans la source (ex. « 21 » pour N'Djamena).
  code        String
  name        String
  /// Nom arabe, seconde langue officielle du Tchad. Nul quand la source ne le
  /// donne pas : un nom translittéré au hasard vaut moins que rien.
  nameAr      String?
  /// Identifiant GeoNames : permet de retrouver la ligne d'origine et de
  /// rejouer une mise à jour de la source sans deviner les correspondances.
  sourceId    String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  /// Une province désactivée n'est plus proposée à la saisie — mais les
  /// commandes qui la référencent restent lisibles.
  active      Boolean  @default(true)

  departments  ToumaDepartment[]
  localities   ToumaLocality[]
  addresses    ToumaAddress[]
  stores       ToumaStore[]
  pickupPoints ToumaPickupPoint[]

  codRules      ToumaCodRule[]
  deliveryZones ToumaDeliveryZone[]

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  storeServiceZones ToumaStoreServiceZone[]

  @@unique([countryCode, code])
  @@index([countryCode])
  @@map("touma_provinces")
}

/// Deuxième niveau administratif (ADM2). 133 au Tchad.
model ToumaDepartment {
  id         String        @id @default(cuid())
  provinceId String
  province   ToumaProvince @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  code       String
  name       String
  nameAr     String?
  sourceId   String?
  active     Boolean       @default(true)

  subPrefectures ToumaSubPrefecture[]
  localities     ToumaLocality[]
  deliveryZones  ToumaDeliveryZone[]
  addresses      ToumaAddress[]
  pickupPoints   ToumaPickupPoint[]

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  storeServiceZones ToumaStoreServiceZone[]

  @@unique([provinceId, code])
  @@index([provinceId])
  @@map("touma_departments")
}

/// Troisième niveau administratif.
///
/// **Cette table est volontairement vide au Tchad.** Aucune source exploitable
/// ne descend à ce niveau, et remplir de mémoire les sous-préfectures d'un État
/// reviendrait à inventer une donnée officielle. Le modèle existe pour que le
/// jour où une source paraît, rien n'ait à être remanié.
model ToumaSubPrefecture {
  id           String          @id @default(cuid())
  departmentId String
  department   ToumaDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  nameAr       String?
  sourceId     String?
  active       Boolean         @default(true)

  localities ToumaLocality[]
  addresses  ToumaAddress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@map("touma_sub_prefectures")
}

/// Lieu habité : ville, quartier, village.
model ToumaLocality {
  id              String              @id @default(cuid())
  provinceId      String
  province        ToumaProvince       @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  /// Nul dans l'immense majorité des cas : la source rattache les localités à
  /// leur province, presque jamais à leur département. Les rattacher « au plus
  /// proche » serait une invention de masse présentée comme officielle.
  departmentId    String?
  department      ToumaDepartment?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subPrefectureId String?
  subPrefecture   ToumaSubPrefecture? @relation(fields: [subPrefectureId], references: [id], onDelete: SetNull)

  name       String
  nameAr     String?
  type       LocalityType @default(LOCALITY)
  sourceId   String?      @unique
  latitude   Decimal?     @db.Decimal(9, 6)
  longitude  Decimal?     @db.Decimal(9, 6)
  /// Population quand la source la connaît. Nulle veut dire « inconnue », pas
  /// « personne n'y habite » : sur 12 277 localités, 75 seulement sont chiffrées.
  population Int?
  active     Boolean      @default(true)

  addresses     ToumaAddress[]
  deliveryZones ToumaDeliveryZone[]
  stores        ToumaStore[]
  pickupPoints  ToumaPickupPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provinceId])
  @@index([departmentId])
  @@index([provinceId, name])
  @@map("touma_localities")
}

/// Adresse d'un utilisateur (livraison, facturation, enlèvement).
model ToumaAddress {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        AddressKind @default(SHIPPING)
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?
  countryCode String
  country     Country     @relation(fields: [countryCode], references: [code])
  isDefault   Boolean     @default(false)

  /// Réalité des adresses d'Afrique centrale : beaucoup de lieux n'ont ni rue
  /// nommée ni code postal. Le quartier et le point de repère sont ce qui
  /// permet réellement au livreur de trouver le destinataire.
  district     String?
  landmark     String?
  instructions String?

  /// Rattachement à la géographie officielle. Tout est nullable : les adresses
  /// créées avant cette version n'en ont pas, et une adresse saisie hors d'un
  /// pays cartographié n'en aura pas non plus. Le texte libre (`city`,
  /// `region`) reste la valeur de repli — on ne rend pas inaccessible une
  /// adresse existante pour faire propre.
  provinceId      String?
  province        ToumaProvince?      @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      ToumaDepartment?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subPrefectureId String?
  subPrefecture   ToumaSubPrefecture? @relation(fields: [subPrefectureId], references: [id], onDelete: SetNull)
  localityId      String?
  locality        ToumaLocality?      @relation(fields: [localityId], references: [id], onDelete: SetNull)

  /// Second numéro : au Tchad, joindre le destinataire tient souvent au fait
  /// d'avoir deux opérateurs.
  alternativePhone String?
  /// Coordonnées facultatives. Donnée sensible : jamais exposée publiquement,
  /// transmise au seul transporteur de la commande concernée.
  latitude         Decimal? @db.Decimal(9, 6)
  longitude        Decimal? @db.Decimal(9, 6)

  orders ToumaOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([provinceId])
  @@index([localityId])
  @@map("touma_addresses")
}

// ── Vendeurs & boutiques ─────────────────────────────────────────────────────

/// Boutique d'un vendeur.
model ToumaStore {
  id                 String             @id @default(cuid())
  ownerId            String
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  slug               String             @unique
  description        String?
  logoUrl            String?
  bannerUrl          String?
  countryCode        String
  country            Country            @relation(fields: [countryCode], references: [code])
  city               String?
  /// Où se trouve réellement la boutique. Sans cela, « vendeurs au Ouaddaï »
  /// n'est pas une requête possible.
  provinceId         String?
  province           ToumaProvince?     @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  localityId         String?
  locality           ToumaLocality?     @relation(fields: [localityId], references: [id], onDelete: SetNull)
  phone              String?
  status             StoreStatus        @default(DRAFT)
  /// Confiance Touma Verified (dénormalisé depuis la dernière vérification).
  verificationStatus VerificationStatus @default(UNVERIFIED)
  /// Niveau de vérification en cours de validité, accordé par l’administration.
  verificationLevel  VerificationLevel  @default(NONE)
  /// Note moyenne (0–5) et nombre d'avis, recalculés à chaque avis publié.
  ratingAverage      Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount        Int                @default(0)

  products       ToumaProduct[]
  orders         ToumaOrder[]
  quotes         ToumaQuote[]
  conversations  ToumaConversation[]
  verifications  ToumaSellerVerification[]
  promotions     ToumaPromotion[]
  payouts        ToumaSellerPayout[]
  commissions    ToumaCommission[]
  returns        ToumaReturnRequest[]
  tickets        ToumaSupportTicket[]
  coupons        ToumaCoupon[]
  documents      ToumaDocument[]
  reputation     ToumaStoreReputation?
  rfqInvitations ToumaRfqInvitation[]
  ledger         ToumaLedgerEntry[]
  allocations    ToumaSettlementAllocation[]

  codRules        ToumaCodRule[]
  commissionRules ToumaCommissionRule[]
  serviceZones    ToumaStoreServiceZone[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ToumaFlashSale ToumaFlashSale[]

  @@index([ownerId])
  @@index([status])
  @@index([countryCode])
  @@index([provinceId])
  @@index([countryCode, provinceId])
  @@map("touma_stores")
}

/// Dossier « Touma Verified » : vérification d'identité / d'entreprise d'un vendeur.
model ToumaSellerVerification {
  id      String     @id @default(cuid())
  storeId String
  store   ToumaStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// INDIVIDUAL | COMPANY
  businessType    String
  legalName       String
  registrationNo  String?
  taxId           String?
  contactPhone    String
  contactEmail    String
  /// Documents (privés) : [{ kind, url, uploadedAt }] — jamais exposés publiquement.
  documents       Json               @default("[]")
  status          VerificationStatus @default(PENDING)
  /// Niveau demandé, puis niveau accordé. Les deux, parce qu'un dossier peut
  /// être accepté à un niveau inférieur à celui qui était visé.
  requestedLevel  VerificationLevel  @default(BASIC)
  grantedLevel    VerificationLevel  @default(NONE)
  /// Une vérification ne vaut pas éternellement : un registre de commerce se
  /// périme. Null tant qu'aucune échéance n'est fixée.
  expiresAt       DateTime?
  reviewerId      String?
  reviewer        User?              @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerComment String?
  reviewedAt      DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@map("touma_seller_verifications")
}

// ── Catalogue ────────────────────────────────────────────────────────────────

/// Catégorie du catalogue (arborescence simple parent → enfants).
model ToumaCategory {
  id       String          @id @default(cuid())
  name     String
  slug     String          @unique
  parentId String?
  parent   ToumaCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ToumaCategory[] @relation("CategoryTree")
  rfqItems ToumaRfqItem[]
  /// B2B | B2C | BOTH — segment principal visé.
  segment  String          @default("BOTH")
  position Int             @default(0)
  active   Boolean         @default(true)

  products ToumaProduct[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  codRules        ToumaCodRule[]
  commissionRules ToumaCommissionRule[]

  crossBorderRules ToumaCrossBorderProductRule[]

  @@index([parentId])
  @@map("touma_categories")
}

/// Produit publié par une boutique.
model ToumaProduct {
  id         String         @id @default(cuid())
  storeId    String
  store      ToumaStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ToumaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title          String
  slug           String        @unique
  description    String        @default("")
  brand          String?
  sku            String?
  /// Prix unitaire TTC exprimé dans `currency` (jamais un Float).
  price          Decimal       @db.Decimal(18, 4)
  /// Prix barré (avant remise), facultatif.
  compareAtPrice Decimal?      @db.Decimal(18, 4)
  currency       String
  /// Quantité minimale de commande (B2B : lots / gros).
  minOrderQty    Int           @default(1)
  status         ProductStatus @default(DRAFT)
  /// Note moyenne et nombre d'avis publiés, recalculés à chaque avis : évite une
  /// agrégation par produit à chaque affichage du catalogue.
  ratingAverage  Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount    Int           @default(0)
  /// Pays **d'expédition** : d'où part le colis. L'origine de la marchandise
  /// est portée par `countryOfOrigin` — ce sont deux faits distincts.
  countryCode    String
  country        Country       @relation(fields: [countryCode], references: [code])
  /// Poids unitaire en grammes (devis de transport).
  weightGrams    Int           @default(500)
  keywords       String        @default("")

  images       ToumaProductImage[]
  priceTiers   ToumaPriceTier[]
  variants     ToumaProductVariant[]
  inventory    ToumaInventory[]
  cartItems    ToumaCartItem[]
  orderItems   ToumaOrderItem[]
  reviews      ToumaReview[]
  priceHistory ToumaProductPriceHistory[]
  favorites    ToumaFavorite[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  publishedAt    DateTime?
  ToumaFlashSale ToumaFlashSale[]

  /// ── Origine de la marchandise (V24, §10 et §11) ────────────────────────
  ///
  /// `countryCode` ci-dessus est le pays **d'expédition** : d'où part le colis.
  /// Il n'a jamais dit d'où vient la marchandise, et son ancien commentaire
  /// laissait croire le contraire. Un savon fabriqué au Nigeria peut être
  /// expédié de N'Djamena par un revendeur tchadien : ce sont trois pays
  /// différents, et les confondre fausse tout document d'origine.
  ///
  /// Déclaré par le vendeur, donc `DECLARED` — jamais `VERIFIED` tant qu'aucune
  /// autorité ne l'a confirmé (§11).
  countryOfOrigin     String?
  manufacturerCountry String?
  originStatus        TradeOriginStatus @default(UNKNOWN)
  /// Ce sur quoi repose la déclaration : référence de document, mention du
  /// fabricant. Jamais une affirmation de Touma.
  originEvidence      String?
  originDeclaredAt    DateTime?

  crossBorderRules ToumaCrossBorderProductRule[]
  stockMovements   ToumaStockMovement[]

  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([countryCode])
  @@map("touma_products")
}

/// Image d'un produit.
/// Palier de prix B2B : au-delà d'une quantité, le prix unitaire baisse.
///
/// C'est la base du commerce de gros, et jusqu'ici TOUMA ne savait pas
/// l'exprimer : un produit avait un prix, un seul, qu'on en achète dix ou dix
/// mille. Le palier retenu est **toujours choisi par le serveur** à partir de la
/// quantité commandée — un client qui réclamerait un palier est ignoré.
model ToumaPriceTier {
  id        String               @id @default(cuid())
  productId String
  product   ToumaProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Variante concernée, ou toutes les variantes du produit si vide.
  variantId String?
  variant   ToumaProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Quantité à partir de laquelle ce prix s'applique (incluse).
  minQuantity Int
  unitPrice   Decimal @db.Decimal(18, 4)
  currency    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un seul palier par quantité et par variante : deux prix pour « à partir de
  /// 100 » seraient une ambiguïté que le serveur devrait trancher au hasard.
  @@unique([productId, variantId, minQuantity])
  @@index([productId])
  @@map("touma_price_tiers")
}

model ToumaProductImage {
  id        String       @id @default(cuid())
  productId String
  product   ToumaProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int          @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("touma_product_images")
}

/// Variante (taille, couleur, conditionnement…). `priceDelta` s'ajoute au prix produit.
model ToumaProductVariant {
  id         String       @id @default(cuid())
  productId  String
  product    ToumaProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?      @unique
  priceDelta Decimal      @default(0) @db.Decimal(18, 4)
  position   Int          @default(0)
  active     Boolean      @default(true)

  inventory  ToumaInventory?
  cartItems  ToumaCartItem[]
  orderItems ToumaOrderItem[]
  priceTiers ToumaPriceTier[]

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  stockMovements ToumaStockMovement[]

  @@index([productId])
  @@map("touma_product_variants")
}

/// Stock d'un produit (ou d'une variante). Une ligne par couple produit/variante.
model ToumaInventory {
  id                String               @id @default(cuid())
  productId         String
  product           ToumaProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?              @unique
  variant           ToumaProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Quantité disponible à la vente (déjà nette des réservations).
  quantity          Int                  @default(0)
  /// Quantité réservée par des commandes non encore expédiées.
  reserved          Int                  @default(0)
  /// Seuil d'alerte de réapprovisionnement.
  lowStockThreshold Int                  @default(5)

  updatedAt DateTime @updatedAt

  @@unique([productId, variantId])
  @@index([productId])
  @@map("touma_inventory")
}

// ── Panier ───────────────────────────────────────────────────────────────────

/// Panier d'un acheteur (un panier actif par utilisateur).
model ToumaCart {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency String?

  items ToumaCartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_carts")
}

/// Ligne de panier. `unitPrice` = prix vu par l'acheteur (revérifié au checkout).
model ToumaCartItem {
  id        String               @id @default(cuid())
  cartId    String
  cart      ToumaCart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   ToumaProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ToumaProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int                  @default(1)
  unitPrice Decimal              @db.Decimal(18, 4)
  currency  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("touma_cart_items")
}

// ── Commandes ────────────────────────────────────────────────────────────────

/// Commande passée auprès d'UNE boutique (un panier multi-boutiques crée
/// plusieurs commandes, chacune avec son paiement et son expédition).
model ToumaOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  buyerId     String
  buyer       User             @relation(fields: [buyerId], references: [id])
  storeId     String
  store       ToumaStore       @relation(fields: [storeId], references: [id])
  status      ToumaOrderStatus @default(PENDING)

  /// Groupe de commande : un panier multi-vendeurs produit un paiement unique
  /// et autant de sous-commandes que de boutiques.
  groupId String?
  group   ToumaOrderGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  /// Mode de remise : domicile, point relais ou retrait chez le vendeur.
  deliveryMethod     DeliveryMethod    @default(HOME)
  pickupPointId      String?
  pickupPoint        ToumaPickupPoint? @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)
  /// Empreinte du code de retrait. **Jamais le code lui-même** : une base lue
  /// par un tiers ne doit pas lui permettre de retirer les colis des autres.
  /// Sans ce code, rien ne distinguait le destinataire de quiconque connaissait
  /// le numéro de commande — et le numéro de commande figure sur tous les
  /// écrans et tous les e-mails.
  pickupCodeHash     String?
  pickupCodeSetAt    DateTime?
  pickupCollectedAt  DateTime?
  /// Qui a remis le colis. Un retrait sans auteur ne se conteste pas.
  pickupReleasedById String?
  pickupReleasedBy   User?             @relation("PickupRelease", fields: [pickupReleasedById], references: [id], onDelete: SetNull)

  currency             String
  /// Somme des lignes (hors livraison).
  subtotal             Decimal @db.Decimal(18, 4)
  shippingTotal        Decimal @default(0) @db.Decimal(18, 4)
  /// Commission Touma retenue sur la commande.
  commissionTotal      Decimal @default(0) @db.Decimal(18, 4)
  /// Taux de commission **réellement appliqué** à cette commande, figé à la
  /// validation. Sans lui, un changement de taux entre le paiement et la
  /// facture ferait enregistrer un taux qui ne correspond pas au montant.
  commissionRate       Decimal @default(0) @db.Decimal(9, 6)
  /// Part de la remise du panier imputée à cette sous-commande — ce que
  /// l'acheteur ne paie pas.
  discountTotal        Decimal @default(0) @db.Decimal(18, 4)
  /// Part de cette remise réellement financée par le vendeur. Le reste est à la
  /// charge de TOUMA : sa commission reste alors assise sur le sous-total plein,
  /// pour qu'une campagne de la plateforme ne coûte rien à la boutique.
  sellerFundedDiscount Decimal @default(0) @db.Decimal(18, 4)
  total                Decimal @db.Decimal(18, 4)

  /// Adresse de livraison : référence + copie figée (l'adresse peut être modifiée après coup).
  shippingAddressId String?
  shippingAddress   ToumaAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingSnapshot  Json

  /// Commande transfrontalière (pays acheteur ≠ pays vendeur) — cœur de la promesse Touma.
  crossBorder   Boolean @default(false)
  buyerCountry  String?
  sellerCountry String?

  note         String?
  cancelReason String?
  /// Clé d'idempotence du checkout : rejouer la requête ne crée pas de doublon.
  checkoutKey  String?
  placedAt     DateTime  @default(now())
  paidAt       DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  items           ToumaOrderItem[]
  payments        ToumaPayment[]
  conversations   ToumaConversation[]
  shipments       ToumaShipment[]
  quotes          ToumaShippingQuote[]
  reviews         ToumaReview[]
  transactionRisk ToumaTransactionRisk?
  promotionUsages ToumaPromotionUsage[]
  disputes        ToumaDispute[]
  commissions     ToumaCommission[]
  returnRequests  ToumaReturnRequest[]
  refunds         ToumaRefund[]
  tickets         ToumaSupportTicket[]
  loyaltyEvents   ToumaLoyaltyEvent[]
  documents       ToumaDocument[]

  settlement ToumaSettlementAllocation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Volet commercial (V24). Ne duplique ni montants, ni articles, ni statut.
  tradeOrder ToumaTradeOrder?

  @@unique([buyerId, storeId, checkoutKey])
  @@index([groupId])
  @@index([buyerId])
  @@index([storeId])
  @@index([status])
  @@map("touma_orders")
}

/// Ligne de commande : instantané figé du produit au moment de l'achat.
/// Modifier le produit plus tard ne doit JAMAIS changer une commande passée.
model ToumaOrderItem {
  id        String               @id @default(cuid())
  orderId   String
  order     ToumaOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   ToumaProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ToumaProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// Instantané (snapshot) — source de vérité de la commande.
  titleSnapshot   String
  skuSnapshot     String?
  variantSnapshot String?
  imageSnapshot   String?
  unitPrice       Decimal @db.Decimal(18, 4)
  quantity        Int
  lineTotal       Decimal @db.Decimal(18, 4)
  currency        String
  /// Trace de ce qui a déterminé le prix : palier appliqué, prix catalogue
  /// d'origine. Sans elle, personne ne peut expliquer six mois plus tard
  /// pourquoi cette ligne a été facturée à ce prix-là.
  metadata        Json?

  returnItems ToumaReturnItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("touma_order_items")
}

// ── Touma Pay ────────────────────────────────────────────────────────────────

/// Paiement d'une commande, orchestré via un adaptateur (mock, PSP réel…).
model ToumaPayment {
  id             String           @id @default(cuid())
  /// Un paiement porte SOIT une commande unique, SOIT un groupe multi-vendeurs
  /// (l'acheteur paie une fois ; la somme est répartie par commande).
  orderId        String?
  order          ToumaOrder?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderGroupId   String?
  orderGroup     ToumaOrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  /// Code de l'adaptateur : mock | (PSP réel plus tard).
  provider       String
  /// Identifiant du paiement chez le prestataire.
  providerRef    String?
  /// Méthode retenue : MOBILE_MONEY | CARD | BANK_TRANSFER | CASH_ON_DELIVERY…
  method         String
  status         PaymentStatus    @default(PENDING)
  amount         Decimal          @db.Decimal(18, 4)
  currency       String
  refundedAmount Decimal          @default(0) @db.Decimal(18, 4)
  /// Clé d'idempotence fournie par le client (un seul paiement par clé).
  idempotencyKey String?          @unique
  /// Données NON sensibles renvoyées par le prestataire (jamais de données bancaires).
  metadata       Json             @default("{}")
  failureReason  String?

  events            ToumaPaymentEvent[]
  allocations       ToumaSettlementAllocation[]
  refunds           ToumaRefund[]
  webhookDeliveries ToumaWebhookDelivery[]

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  succeededAt    DateTime?
  /// Encaissement à la livraison, quand c'est la méthode retenue.
  cashCollection ToumaCashCollection?

  @@index([orderId])
  @@index([orderGroupId])
  @@index([status])
  @@map("touma_payments")
}

/// Journal d'audit d'un paiement (création, webhooks, remboursements).
model ToumaPaymentEvent {
  id         String       @id @default(cuid())
  paymentId  String
  payment    ToumaPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type       String
  /// Identifiant de l'événement chez le prestataire : rejoue = ignoré (unicité).
  externalId String?      @unique
  payload    Json         @default("{}")

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("touma_payment_events")
}

/// Issue d'un webhook reçu. Le rejet est une issue comme une autre : c'est même
/// la seule qu'on regrette de ne pas avoir tracée.
enum WebhookOutcome {
  ACCEPTED
  DUPLICATE
  INVALID_SIGNATURE
  STALE
  MALFORMED
  UNKNOWN_PROVIDER
  UNKNOWN_PAYMENT
  ERROR
}

/// Trace de **chaque** webhook reçu, accepté ou refusé.
///
/// `ToumaPaymentEvent` ne consigne que les événements appliqués : un webhook
/// rejeté pour signature invalide n'y laissait aucune trace. C'est pourtant
/// exactement celle qu'on voudra le jour où quelqu'un tente d'en forger un —
/// combien de tentatives, depuis quand, sur quelle référence.
///
/// Le point d'entrée est public et non authentifié : le corps n'est donc jamais
/// conservé tel quel. Il est rédigé, tronqué, et remplacé par son empreinte
/// pour corréler deux tentatives sans offrir une écriture sans borne en base.
model ToumaWebhookDelivery {
  id       String @id @default(cuid())
  provider String

  outcome WebhookOutcome
  /// Motif du rejet, pour l'exploitation. Jamais renvoyé à l'appelant : lui
  /// dire *pourquoi* sa signature est refusée l'aide à en forger une valide.
  reason  String?

  /// Renseignés seulement si le corps a pu être lu et vérifié.
  eventId     String?
  eventType   String?
  providerRef String?

  /// Nullable : un webhook refusé ne désigne aucun paiement connu. `SetNull`
  /// plutôt que `Cascade` — la trace d'une tentative doit survivre à la
  /// disparition de la commande qu'elle visait.
  paymentId String?
  payment   ToumaPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  signatureValid      Boolean
  /// Âge de l'horodatage signé à la réception, en secondes. Négatif = futur.
  signatureAgeSeconds Int?

  /// Empreinte SHA-256 du corps brut : deux tentatives identiques se repèrent
  /// sans conserver deux fois le corps.
  bodySha256  String
  bodyBytes   Int
  /// Extrait rédigé et borné. Ni jeton, ni secret, ni numéro de carte.
  bodyExcerpt String?

  sourceIp  String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([provider, createdAt])
  @@index([outcome, createdAt])
  @@index([bodySha256])
  @@index([paymentId])
  @@map("touma_webhook_deliveries")
}

/// Commission Touma calculée sur une commande (part plateforme).
model ToumaCommission {
  id       String             @id @default(cuid())
  orderId  String
  order    ToumaOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId  String
  store    ToumaStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Taux appliqué (ex. 0.0500 = 5 %) — jamais codé en dur, voir la configuration.
  rate     Decimal            @db.Decimal(6, 4)
  amount   Decimal            @db.Decimal(18, 4)
  currency String
  payoutId String?
  payout   ToumaSellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([storeId])
  @@map("touma_commissions")
}

/// Versement au vendeur (net de commission).
/// Registre comptable interne, **append-only**.
///
/// Chaque mouvement d'argent y laisse une ligne : la vente, la commission
/// prélevée, le remboursement, la contre-passation. Rien n'est jamais modifié
/// ni supprimé — une correction est une nouvelle ligne de sens inverse, comme
/// en comptabilité.
///
/// Ce que ce registre permet, et que le dépôt ne savait pas faire : répondre à
/// « combien cette boutique a-t-elle réellement gagné, et combien ne doit pas
/// encore partir ». Le solde est **calculé**, jamais stocké — un solde stocké
/// finit toujours par diverger de ses mouvements.
///
/// Ce qu'il n'est PAS : une comptabilité légale. Il ne remplace ni un livre
/// comptable, ni un expert-comptable, ni les obligations fiscales d'un vendeur.
model ToumaLedgerEntry {
  id      String      @id @default(cuid())
  storeId String?
  store   ToumaStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  type      LedgerEntryType
  /// Sens du mouvement du point de vue de la boutique : ce qu'elle gagne
  /// (CREDIT) ou ce qui lui est retiré (DEBIT).
  direction LedgerDirection

  amount   Decimal @db.Decimal(18, 4)
  currency String

  /// Ce à quoi la ligne se rattache : « ToumaOrder », « ToumaRefund »…
  referenceType String
  referenceId   String

  /// Retenu tant qu'un litige est ouvert sur la référence.
  heldByDisputeId String?
  heldByDispute   ToumaDispute? @relation(fields: [heldByDisputeId], references: [id], onDelete: SetNull)
  releasedAt      DateTime?

  note      String?
  createdAt DateTime @default(now())

  @@unique([referenceType, referenceId, type])
  @@index([storeId, currency])
  @@index([referenceType, referenceId])
  @@index([heldByDisputeId])
  @@map("touma_ledger_entries")
}

enum LedgerEntryType {
  /// Montant de la vente revenant à la boutique.
  SALE
  /// Commission retenue par TOUMA.
  COMMISSION
  /// Remboursement versé à l'acheteur.
  REFUND
  /// Commission rendue à la boutique au prorata d'un remboursement.
  COMMISSION_REVERSAL
  /// Versement effectué à la boutique (aucun n'est créé tant qu'aucun
  /// prestataire n'est raccordé — voir la documentation).
  PAYOUT
  ADJUSTMENT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

model ToumaSellerPayout {
  id        String       @id @default(cuid())
  storeId   String
  store     ToumaStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  amount    Decimal      @db.Decimal(18, 4)
  currency  String
  status    PayoutStatus @default(PENDING)
  reference String?      @unique
  paidAt    DateTime?

  /// Qui a exécuté, retenu ou annulé — et pourquoi. Un mouvement d'argent sans
  /// auteur ne se conteste pas.
  decidedById   String?
  decidedBy     User?   @relation("PayoutDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  holdReason    String?
  failureReason String?
  /// Référence du virement chez le prestataire, quand il y en a un.
  providerRef   String?

  commissions ToumaCommission[]
  allocations ToumaSettlementAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@map("touma_seller_payouts")
}

// ── Touma Logistics ──────────────────────────────────────────────────────────

/// Transporteur raccordé (un adaptateur par transporteur).
model ToumaShippingProvider {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  /// Pays desservis (codes ISO séparés par des virgules ; vide = tous).
  countries String  @default("")
  active    Boolean @default(true)

  quotes    ToumaShippingQuote[]
  shipments ToumaShipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_shipping_providers")
}

/// Devis de transport (prix + délai) proposé pour une commande / un panier.
model ToumaShippingQuote {
  id           String                 @id @default(cuid())
  providerId   String?
  provider     ToumaShippingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerCode String
  serviceName  String
  orderId      String?
  order        ToumaOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  originCountry      String
  originCity         String?
  destinationCountry String
  destinationCity    String?
  weightGrams        Int
  /// Dimensions en cm : { length, width, height }.
  dimensions         Json     @default("{}")
  amount             Decimal  @db.Decimal(18, 4)
  currency           String
  etaMinDays         Int
  etaMaxDays         Int
  /// Expire pour empêcher l'utilisation d'un vieux tarif.
  expiresAt          DateTime

  shipments ToumaShipment[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("touma_shipping_quotes")
}

/// Expédition réelle rattachée à une commande.
model ToumaShipment {
  id                 String                 @id @default(cuid())
  orderId            String
  order              ToumaOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteId            String?
  quote              ToumaShippingQuote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  providerId         String?
  provider           ToumaShippingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerCode       String
  trackingNumber     String                 @unique
  labelUrl           String?
  status             ShipmentStatus         @default(PENDING)
  amount             Decimal                @db.Decimal(18, 4)
  currency           String
  etaMinDays         Int                    @default(0)
  etaMaxDays         Int                    @default(0)
  originCountry      String
  destinationCountry String

  events ToumaTrackingEvent[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shippedAt   DateTime?
  deliveredAt DateTime?

  @@index([orderId])
  @@index([status])
  @@map("touma_shipments")
}

/// Événement de suivi d'une expédition.
model ToumaTrackingEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   ToumaShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  label      String
  location   String?
  occurredAt DateTime       @default(now())

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@map("touma_tracking_events")
}

// ── Avis, litiges, confiance ─────────────────────────────────────────────────

/// Avis d'un acheteur : uniquement sur un produit réellement acheté et livré.
model ToumaReview {
  id               String                 @id @default(cuid())
  orderId          String
  order            ToumaOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          ToumaProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId         String
  author           User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String?
  /// Modération. Était une chaîne libre commentée ; l'enum rend les états
  /// impossibles à mal écrire et ajoute ceux qui manquaient.
  status           ReviewModerationStatus @default(PUBLISHED)
  /// Pourquoi l'avis a été masqué ou rejeté, et par qui. Une décision de
  /// modération sans motif n'est pas contestable.
  moderationReason String?
  moderatedById    String?
  moderatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskScore ToumaReviewRiskScore?

  @@unique([orderId, productId])
  @@index([productId])
  @@index([status])
  @@map("touma_reviews")
}

/// Litige ouvert sur une commande.
model ToumaDispute {
  id         String          @id @default(cuid())
  orderId    String
  order      ToumaOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedById String
  openedBy   User            @relation(fields: [openedById], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     DisputeStatus   @default(OPEN)
  category   DisputeCategory @default(OTHER)
  /// Priorité **calculée** (montant, récidive, catégorie). Ce n'est pas une
  /// décision : c'est un ordre de passage. Le §18 le dit, et le code aussi.
  priority   DisputePriority @default(NORMAL)

  /// Agent d'assistance en charge, s'il y en a un.
  assignedToId String?
  assignedTo   User?   @relation("DisputeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Délais de réponse. Passés, le litige est escaladé par un balayage serveur —
  /// jamais par le navigateur. Un vendeur qui ne répond jamais ne doit pas
  /// pouvoir bloquer un acheteur indéfiniment, et réciproquement.
  sellerResponseDeadline DateTime?
  buyerResponseDeadline  DateTime?
  escalatedAt            DateTime?

  /// Décision de l'administrateur (auditée dans ToumaAuditLog).
  resolution         String?
  resolutionType     DisputeResolutionType?
  /// Instantané figé de la décision : montant, devise, preuves retenues,
  /// agent, horodatage. Une résolution ne se réécrit pas en silence.
  resolutionSnapshot Json?
  refundAmount       Decimal?               @db.Decimal(18, 4)
  resolvedAt         DateTime?

  messages    ToumaDisputeMessage[]
  evidence    ToumaDisputeEvidence[]
  heldEntries ToumaLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("touma_disputes")
}

/// Message échangé dans un litige.
model ToumaDisputeMessage {
  id        String       @id @default(cuid())
  disputeId String
  dispute   ToumaDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  /// Message interne (visible des seuls administrateurs).
  internal  Boolean      @default(false)

  createdAt DateTime @default(now())

  @@index([disputeId])
  @@map("touma_dispute_messages")
}

/// Preuve jointe à un litige (photo, facture…). Stockage privé.
/// Preuve versée à un litige ou à un retour.
///
/// C'est la pièce sur laquelle un arbitre décide qui garde l'argent. Elle ne
/// peut donc pas être une URL déclarée par un navigateur : le fichier est reçu
/// en corps brut, son type est reconnu à ses octets, il est empreinté et rangé
/// sous une clé non devinable dans le stockage privé — le même que celui des
/// pièces jointes de la messagerie.
///
/// Une preuve ne se modifie jamais. Son retrait est un acte d'administration
/// qui la **marque** retirée : on ne supprime pas une pièce d'un dossier après
/// qu'une décision a été prise dessus.
model ToumaDisputeEvidence {
  id              String              @id @default(cuid())
  disputeId       String?
  dispute         ToumaDispute?       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  /// Une preuve peut appartenir à un retour avant qu'un litige n'existe.
  returnRequestId String?
  returnRequest   ToumaReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  kind EvidenceKind @default(PHOTO)

  /// Qui l'a déposée. Sans cela, une preuve n'engage personne.
  uploadedById String
  uploadedBy   User   @relation("EvidenceAuthor", fields: [uploadedById], references: [id], onDelete: Cascade)

  /// Contenu réel, vérifié.
  storageKey String  @unique
  filename   String
  mimeType   String
  sizeBytes  Int
  checksum   String
  note       String?

  /// Retrait tracé, jamais effacement.
  removedAt     DateTime?
  removedById   String?
  removalReason String?

  createdAt DateTime @default(now())

  @@index([disputeId])
  @@index([returnRequestId])
  @@map("touma_dispute_evidence")
}

enum EvidenceKind {
  PHOTO
  VIDEO
  DOCUMENT
  INVOICE
  TRACKING
  OTHER
}

// ── Risque & fraude ──────────────────────────────────────────────────────────

/// Score de risque d'un utilisateur (informatif : ne bannit jamais tout seul).
model ToumaRiskScore {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 0 (sûr) → 100 (très risqué).
  score   Int    @default(0)
  /// LOW | MEDIUM | HIGH
  level   String @default("LOW")
  /// Signaux ayant contribué au score : [{ code, weight, detail }].
  signals Json   @default("[]")

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("touma_risk_scores")
}

/// Signal de fraude observé (paiement échoué, incohérence pays/adresse…).
model ToumaFraudEvent {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  code   String
  weight Int     @default(1)
  detail Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([code])
  @@map("touma_fraud_events")
}

// ── Divers ───────────────────────────────────────────────────────────────────

/// Produit mis en favori par un acheteur.
model ToumaFavorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   ToumaProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("touma_favorites")
}

/// Notification métier. Le canal (email/SMS/WhatsApp/push) est branché plus tard :
/// le domaine ne dépend d'aucun fournisseur.
model ToumaNotification {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ORDER_CREATED | PAYMENT_SUCCEEDED | SHIPMENT_UPDATED | VERIFICATION_APPROVED…
  type     String
  title    String
  body     String
  data     Json      @default("{}")
  readAt   DateTime?
  /// Canaux de diffusion demandés (IN_APP par défaut).
  channels String    @default("IN_APP")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, readAt])
  @@map("touma_notifications")
}

/// Jeton de rafraîchissement (rotation + révocation). Seul le hash est stocké.
/// Demande de suppression de compte (V25 §68).
///
/// Une suppression ne s'exécute pas au moment où on la demande. Un délai de
/// réflexion sépare les deux, pour deux raisons : on se ravise, et surtout un
/// compte pris en main par quelqu'un d'autre ne doit pas pouvoir s'effacer
/// dans la foulée avec ce qu'il a fait.
/// Drapeau de fonctionnalité (V25 §28-29).
///
/// À ne pas confondre avec les interrupteurs d'environnement (`TOUMA_*_ENABLED`),
/// qui disent ce que **l'instance peut faire** : un paiement sans prestataire
/// raccordé reste éteint quoi qu'il arrive. Un drapeau ne rallume jamais ce que
/// l'environnement a éteint ; il décide, parmi ce qui est possible, **qui le
/// voit**.
/// Incident d'exploitation (V25 §48).
///
/// Un incident est **tenu à la main**. Rien ne l'ouvre automatiquement, et
/// c'est délibéré : aucune alerte n'existe sur cette installation, et un
/// incident ouvert par une machine que personne ne lit ne sert à rien. Ce
/// modèle sert à ce qu'une astreinte écrive ce qu'elle constate pendant
/// qu'elle le constate — l'exercice que personne ne refait après coup.
model ToumaIncident {
  id        String           @id @default(cuid())
  /// Référence lisible : `INC-2026-0001`.
  reference String           @unique
  title     String
  severity  IncidentSeverity
  status    IncidentStatus   @default(OPEN)

  /// Ce qui est cassé, du point de vue de ceux qui l'subissent.
  impact String?

  /// Composant touché : `postgres`, `paiement`, `transport`, `ia`…
  component String?

  /// Qui tient l'incident. Un incident sans responsable n'avance pas.
  ownerId String?
  owner   User?   @relation("IncidentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  openedById String?
  openedBy   User?   @relation("IncidentOpener", fields: [openedById], references: [id], onDelete: SetNull)

  /// Cause établie. Nulle tant qu'elle ne l'est pas — « probablement » n'y a
  /// pas sa place.
  rootCause  String?
  /// Ce qui a rétabli le service, qui n'est pas toujours la correction.
  resolution String?

  detectedAt  DateTime  @default(now())
  mitigatedAt DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?

  events ToumaIncidentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity])
  @@index([detectedAt])
  @@map("touma_incidents")
}

/// Une ligne de chronologie. **Jamais modifiée ni supprimée.**
///
/// Un compte rendu d'incident ne vaut que si la chronologie n'a pas été
/// réécrite après coup, quand on sait déjà comment l'histoire finit.
model ToumaIncidentEvent {
  id         String        @id @default(cuid())
  incidentId String
  incident   ToumaIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  kind IncidentEventKind

  /// Ce qui a été constaté ou fait, écrit par quelqu'un.
  note String

  /// Changement d'état porté par cette ligne, le cas échéant.
  fromStatus IncidentStatus?
  toStatus   IncidentStatus?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("touma_incident_events")
}

enum IncidentSeverity {
  /// Service inutilisable, ou argent en jeu.
  P0
  /// Fonction majeure cassée, contournement pénible.
  P1
  /// Gêne réelle, contournement acceptable.
  P2
  /// À traiter, sans urgence.
  P3
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED
}

enum IncidentEventKind {
  /// Ce qu'on voit.
  OBSERVATION
  /// Ce qu'on fait.
  ACTION
  /// Changement d'état.
  STATUS
  /// Ce qu'on dit à l'extérieur.
  COMMUNICATION
}

model ToumaFeatureFlag {
  id  String @id @default(cuid())
  /// Identifiant stable employé dans le code : `ai_chat`, `trade_td_cm`.
  key String @unique

  label       String
  description String?

  /// Éteint, le drapeau ne s'applique à personne, quelles que soient les cibles.
  enabled Boolean @default(false)

  /// Part du public visé, de 0 à 100. L'attribution est **stable** par sujet.
  rolloutPercent Int @default(0)

  /// Ciblages. Vides = aucune restriction sur cette dimension.
  countries    String[] @default([])
  provinces    String[] @default([])
  storeIds     String[] @default([])
  userIds      String[] @default([])
  environments String[] @default([])

  /// Le drapeau peut-il être lu par le navigateur via `/features` ?
  /// Faux par défaut : un drapeau dit ce qui se prépare, et tout ce qui se
  /// prépare n'a pas à être public.
  exposedToClient Boolean @default(false)

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@map("touma_feature_flags")
}

model ToumaAccountDeletionRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status AccountDeletionStatus @default(PENDING)

  /// Date à partir de laquelle l'anonymisation peut s'exécuter.
  scheduledFor DateTime
  requestedAt  DateTime  @default(now())
  cancelledAt  DateTime?
  completedAt  DateTime?

  /// Motif donné par la personne. Facultatif, jamais exigé.
  reason String?

  /// Ce qui bloquait au moment de la demande, quand elle a été refusée.
  blockers String[] @default([])

  ip        String?
  userAgent String?

  @@index([userId])
  @@index([status, scheduledFor])
  @@map("touma_account_deletion_requests")
}

enum AccountDeletionStatus {
  /// Demandée, délai de réflexion en cours.
  PENDING
  /// Annulée par la personne avant l'échéance.
  CANCELLED
  /// Anonymisation effectuée.
  COMPLETED
}

model ToumaRefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 du jeton : un vol de base ne permet pas de rejouer le jeton.
  tokenHash  String    @unique
  /// Famille de jetons : une réutilisation détectée révoque toute la famille.
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Jeton émis en remplacement (chaîne de rotation).
  replacedBy String?
  userAgent  String?
  ip         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("touma_refresh_tokens")
}

// ── Touma AI ─────────────────────────────────────────────────────────────────

/// Requête envoyée à un fournisseur d'IA (traçabilité, quotas, coûts).
model ToumaAiRequest {
  id        String  @id @default(cuid())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider  String
  /// generate | classify | recommend
  kind      String
  /// Cas d'usage : product_description | product_title | category_suggestion…
  useCase   String
  input     Json    @default("{}")
  output    Json    @default("{}")
  /// OK | ERROR
  status    String  @default("OK")
  latencyMs Int     @default(0)
  error     String?

  recommendations ToumaAiRecommendation[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("touma_ai_requests")
}

/// Recommandation produite par l'IA. Toute action critique reste validée par un humain.
model ToumaAiRecommendation {
  id         String          @id @default(cuid())
  requestId  String?
  request    ToumaAiRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  /// PRODUCT | SUPPLIER | PRICE | CATEGORY
  targetType String
  targetId   String?
  score      Decimal         @default(0) @db.Decimal(6, 4)
  reason     String?
  payload    Json            @default("{}")
  /// L'utilisateur a-t-il accepté la recommandation ?
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@map("touma_ai_recommendations")
}

/// Journal d'audit : toute action sensible (admin, litige, vérification, paiement).
model ToumaAuditLog {
  id       String  @id @default(cuid())
  actorId  String?
  actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Ex. verification.approve, order.status.update, dispute.resolve.
  action   String
  entity   String
  entityId String?
  /// Détail non sensible (jamais de secrets, jetons ou données bancaires).
  metadata Json    @default("{}")
  ip       String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@map("touma_audit_logs")
}

// ═════════════════════════════════════════════════════════════════════════════
// TOUMA — COMMANDE MULTI-VENDEURS, POINTS RELAIS, B2B (RFQ) ET MESSAGERIE
// ═════════════════════════════════════════════════════════════════════════════

enum DeliveryMethod {
  /// Livraison à l'adresse de l'acheteur.
  HOME
  /// Retrait dans un point relais partenaire.
  PICKUP_POINT
  /// Retrait chez le vendeur.
  SELLER_PICKUP
}

/// Origine d'une commande globale.
enum OrderSourceType {
  /// Panier classique.
  CART
  /// Acceptation d'une offre issue d'un appel d'offres.
  RFQ
  /// Commande créée directement (assistance, reprise de commande hors ligne).
  DIRECT
  /// Recommande à l'identique.
  REORDER
}

/// Statut de la commande globale. Il n'est jamais écrit à la main : il est
/// **déduit** des sous-commandes (voir `orders/group-status.ts`). Une commande à
/// trois vendeurs dont un seul a livré ne peut pas afficher « livrée », et ne
/// doit pas afficher « payée » non plus.
enum OrderGroupStatus {
  PENDING
  PAID
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
}

/// Groupe de commande : le panier validé en une fois. Il porte le paiement
/// unique de l'acheteur ; chaque boutique reçoit sa propre sous-commande, avec
/// sa préparation, son expédition et sa commission.
model ToumaOrderGroup {
  id        String           @id @default(cuid())
  reference String           @unique
  buyerId   String
  buyer     User             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status    OrderGroupStatus @default(PENDING)

  currency      String
  itemsTotal    Decimal @db.Decimal(18, 4)
  shippingTotal Decimal @default(0) @db.Decimal(18, 4)
  discountTotal Decimal @default(0) @db.Decimal(18, 4)
  total         Decimal @db.Decimal(18, 4)

  /// Copie figée de l'adresse de livraison au moment de la validation.
  shippingSnapshot Json
  /// Clé d'idempotence du checkout (rejouer la requête ne crée pas de doublon).
  checkoutKey      String?
  /// Vrai dès qu'au moins une sous-commande franchit une frontière.
  crossBorder      Boolean @default(false)

  /// D'où vient la commande. Une commande née d'un appel d'offres n'a pas la
  /// même histoire qu'un panier : elle porte un prix négocié, et l'assistance
  /// doit pouvoir remonter à la négociation sans jouer aux devinettes.
  /// L'offre acceptée est déjà rattachée dans l'autre sens
  /// (`ToumaQuote.orderGroupId`) : on n'ajoute ici que ce qui manquait.
  sourceType OrderSourceType @default(CART)
  rfqId      String?
  rfq        ToumaRfq?       @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  orders        ToumaOrder[]
  payments      ToumaPayment[]
  quotes        ToumaQuote[]
  redemptions   ToumaCouponRedemption[]
  loyaltyEvents ToumaLoyaltyEvent[]
  documents     ToumaDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@unique([buyerId, checkoutKey])
  @@index([buyerId])
  @@index([status])
  @@map("touma_order_groups")
}

/// Point relais partenaire : essentiel là où la livraison à domicile est peu
/// fiable. Les horaires et le point de repère comptent autant que l'adresse.
model ToumaPickupPoint {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  countryCode  String
  provinceId   String?
  province     ToumaProvince?   @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  departmentId String?
  department   ToumaDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  localityId   String?
  locality     ToumaLocality?   @relation(fields: [localityId], references: [id], onDelete: SetNull)
  city         String
  district     String?
  landmark     String?
  addressLine  String
  phone        String?
  /// Horaires d'ouverture en clair (ex. « Lun–Sam 8h–18h »).
  openingHours String?
  latitude     Decimal?         @db.Decimal(9, 6)
  longitude    Decimal?         @db.Decimal(9, 6)
  active       Boolean          @default(true)

  orders ToumaOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode, city])
  @@index([provinceId])
  @@map("touma_pickup_points")
}

// ── TOUMA Business & appels d'offres (RFQ) ───────────────────────────────────

enum RfqStatus {
  /// Publié : les fournisseurs peuvent répondre.
  OPEN
  /// Au moins une offre reçue.
  QUOTED
  /// Une offre a été retenue.
  AWARDED
  CLOSED
  EXPIRED
  CANCELLED
}

enum QuoteStatus {
  SUBMITTED
  /// Contre-proposition en cours de négociation.
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum NegotiationKind {
  MESSAGE
  COUNTER_OFFER
  ACCEPT
  REJECT
}

/// Profil entreprise d'un acheteur professionnel (TOUMA Business).
model ToumaBusinessProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationSeats ToumaConversationParticipant[]

  legalName      String
  registrationNo String?
  taxId          String?
  /// Secteur d'activité déclaré (agroalimentaire, distribution, BTP…).
  sector         String?
  countryCode    String
  city           String?
  phone          String?
  website        String?
  /// Volume d'achat annuel déclaré, à titre indicatif (jamais présenté comme vérifié).
  annualVolume   String?

  rfqs ToumaRfq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_business_profiles")
}

/// Appel d'offres : « je recherche 500 kg de cacao au Cameroun ».
model ToumaRfq {
  id                String                @id @default(cuid())
  reference         String                @unique
  buyerId           String
  buyer             User                  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  businessProfileId String?
  business          ToumaBusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  title         String
  description   String    @default("")
  /// Pays de livraison souhaité.
  countryCode   String
  city          String?
  currency      String
  /// Pays d'origine souhaité pour la marchandise (facultatif).
  sourceCountry String?
  status        RfqStatus @default(OPEN)
  /// Date limite de réception des offres.
  deadline      DateTime?

  items         ToumaRfqItem[]
  quotes        ToumaQuote[]
  invitations   ToumaRfqInvitation[]
  conversations ToumaConversation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  /// Commandes nées de cet appel d'offres.
  orderGroups ToumaOrderGroup[]

  @@index([buyerId])
  @@index([status])
  @@index([countryCode])
  @@map("touma_rfqs")
}

/// Ligne d'un appel d'offres (produit recherché et quantité).
model ToumaRfqItem {
  id    String   @id @default(cuid())
  rfqId String
  rfq   ToumaRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  quantity        Int
  /// Unité : kg, tonne, sac, carton, pièce…
  unit            String         @default("pièce")
  /// Prix unitaire cible indiqué par l'acheteur (facultatif).
  targetUnitPrice Decimal?       @db.Decimal(18, 4)
  categoryId      String?
  category        ToumaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  quoteItems ToumaQuoteItem[]

  createdAt DateTime @default(now())

  @@index([rfqId])
  @@map("touma_rfq_items")
}

/// Offre d'un fournisseur en réponse à un appel d'offres.
model ToumaQuote {
  id        String     @id @default(cuid())
  reference String     @unique
  rfqId     String
  rfq       ToumaRfq   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  storeId   String
  store     ToumaStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User       @relation("QuoteSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  currency      String
  itemsTotal    Decimal     @db.Decimal(18, 4)
  shippingTotal Decimal     @default(0) @db.Decimal(18, 4)
  total         Decimal     @db.Decimal(18, 4)
  /// Délai de mise à disposition annoncé, en jours.
  leadTimeDays  Int         @default(7)
  /// Une offre expirée ne peut plus être acceptée.
  validUntil    DateTime
  status        QuoteStatus @default(SUBMITTED)
  message       String?

  /// Commande créée lorsque l'acheteur accepte l'offre.
  orderGroupId String?
  orderGroup   ToumaOrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: SetNull)

  items         ToumaQuoteItem[]
  negotiations  ToumaNegotiationMessage[]
  conversations ToumaConversation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  acceptedAt DateTime?

  @@unique([rfqId, storeId])
  @@index([rfqId])
  @@index([storeId])
  @@index([status])
  @@map("touma_quotes")
}

/// Ligne d'une offre fournisseur.
model ToumaQuoteItem {
  id        String        @id @default(cuid())
  quoteId   String
  quote     ToumaQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItemId String?
  rfqItem   ToumaRfqItem? @relation(fields: [rfqItemId], references: [id], onDelete: SetNull)

  name      String
  quantity  Int
  unit      String  @default("pièce")
  unitPrice Decimal @db.Decimal(18, 4)
  lineTotal Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("touma_quote_items")
}

/// Échange de négociation sur une offre : message, contre-proposition, décision.
/// L'historique complet est conservé — il fait foi en cas de litige.
model ToumaNegotiationMessage {
  id                   String          @id @default(cuid())
  quoteId              String
  quote                ToumaQuote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  authorId             String
  author               User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind                 NegotiationKind @default(MESSAGE)
  body                 String
  /// Total proposé par l'auteur lors d'une contre-proposition. Toujours
  /// recalculé par le serveur : le client propose des quantités et des prix
  /// unitaires, jamais un total.
  proposedTotal        Decimal?        @db.Decimal(18, 4)
  /// Détail de la proposition, pour que la carte d'offre soit vérifiable.
  proposedItemsTotal   Decimal?        @db.Decimal(18, 4)
  proposedShipping     Decimal?        @db.Decimal(18, 4)
  proposedLeadTimeDays Int?
  /// Lignes proposées (nom, quantité, unité, prix unitaire, total de ligne).
  proposedItems        Json?
  /// Validité propre à cette proposition ; au-delà, elle ne peut plus être acceptée.
  expiresAt            DateTime?

  /// Message de la conversation qui porte cette offre (carte affichée dans le fil).
  message ToumaMessage?

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([quoteId, createdAt])
  @@map("touma_negotiation_messages")
}

// ── Messagerie ───────────────────────────────────────────────────────────────

enum ConversationKind {
  /// Acheteur ↔ vendeur, hors contexte particulier (« DIRECT »).
  BUYER_SELLER
  /// Négociation autour d'un appel d'offres, un fil par fournisseur.
  RFQ
  /// Négociation d'une offre précise.
  QUOTE
  /// Suivi d'une commande passée.
  ORDER
  /// Assistance TOUMA.
  SUPPORT
}

enum ConversationStatus {
  ACTIVE
  /// Rangée par un participant : elle reste lisible et peut revenir.
  ARCHIVED
  /// Close : lecture seule (appel d'offres attribué, commande terminée).
  CLOSED
  /// Bloquée après signalement ou blocage mutuel : plus aucun message.
  BLOCKED
}

/// Nature d'un message. Seul le serveur produit SYSTEM, OFFER et COUNTER_OFFER.
enum MessageType {
  TEXT
  SYSTEM
  OFFER
  COUNTER_OFFER
  QUOTE
  ORDER_UPDATE
  ATTACHMENT
}

enum MessageReportReason {
  SPAM
  FRAUD
  ABUSE
  OFF_PLATFORM_PAYMENT
  PROHIBITED_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

/// Catégorie d'un signal de risque détecté dans un message.
enum RiskFlagCategory {
  OFF_PLATFORM_PAYMENT
  CONTACT_EXCHANGE
  SUSPICIOUS_LINK
  FLOOD
  REPEATED_CONTENT
}

enum RiskFlagStatus {
  OPEN
  CLEARED
  CONFIRMED
}

/// Fil de discussion entre participants identifiés.
model ToumaConversation {
  id      String             @id @default(cuid())
  kind    ConversationKind   @default(BUYER_SELLER)
  status  ConversationStatus @default(ACTIVE)
  subject String?

  /// Rattachements facultatifs, qui donnent son contexte à la conversation.
  storeId String?
  store   ToumaStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  orderId String?
  order   ToumaOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rfqId   String?
  rfq     ToumaRfq?   @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  quoteId String?
  quote   ToumaQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  /// Qui a ouvert le fil (utile pour l'anti-spam et l'audit).
  createdById String?
  createdBy   User?   @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  lastMessageAt DateTime @default(now())

  participants ToumaConversationParticipant[]
  messages     ToumaMessage[]
  reports      ToumaMessageReport[]
  riskFlags    ToumaRiskFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([lastMessageAt])
  @@index([rfqId])
  @@index([quoteId])
  @@index([orderId])
  @@map("touma_conversations")
}

/// Participation à une conversation : c'est elle qui autorise l'accès au fil.
model ToumaConversationParticipant {
  id                String                @id @default(cuid())
  conversationId    String
  conversation      ToumaConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Rôle tenu dans ce fil : BUYER | SELLER | ADMIN | SUPPORT.
  role              String                @default("BUYER")
  lastReadAt        DateTime?
  /// Entreprise au nom de laquelle le participant écrit, s'il en a une.
  businessProfileId String?
  business          ToumaBusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  /// Notifications coupées pour ce fil (le fil reste lisible).
  mutedAt           DateTime?
  /// Rangé par ce participant seulement : l'autre le voit toujours.
  archivedAt        DateTime?

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, lastReadAt])
  @@map("touma_conversation_participants")
}

model ToumaMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   ToumaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Nul pour un message système : il n'émane d'aucun utilisateur.
  authorId       String?
  author         User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  type           MessageType       @default(TEXT)
  body           String
  /// Contexte structuré du message (carte d'offre, mise à jour de commande).
  metadata       Json              @default("{}")

  /// Message cité (fil de réponse).
  replyToId String?
  replyTo   ToumaMessage?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ToumaMessage[] @relation("MessageReply")

  /// Offre commerciale portée par ce message : la source de vérité financière.
  negotiationMessageId String?                  @unique
  negotiation          ToumaNegotiationMessage? @relation(fields: [negotiationMessageId], references: [id], onDelete: SetNull)

  attachments ToumaMessageAttachment[]
  reports     ToumaMessageReport[]
  riskFlags   ToumaRiskFlag[]

  createdAt DateTime  @default(now())
  /// Dernière modification par l'auteur (fenêtre courte, puis immuable).
  editedAt  DateTime?
  /// Suppression douce : le fil garde sa trace, le contenu n'est plus affiché.
  deletedAt DateTime?

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([authorId, createdAt])
  @@map("touma_messages")
}

/// Signalement d'un message par un participant.
model ToumaMessageReport {
  id             String            @id @default(cuid())
  conversationId String
  conversation   ToumaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String
  message        ToumaMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  reason       MessageReportReason
  details      String              @default("")
  status       ReportStatus        @default(OPEN)
  /// Décision de l'administration.
  resolution   String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  /// Un même utilisateur ne signale un message qu'une fois.
  @@unique([messageId, reporterId])
  @@index([status])
  @@map("touma_message_reports")
}

/// Signal de risque détecté automatiquement. N'entraîne jamais de suppression :
/// il attire l'attention, l'humain tranche.
model ToumaRiskFlag {
  id             String            @id @default(cuid())
  conversationId String
  conversation   ToumaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        ToumaMessage?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  category RiskFlagCategory
  /// 0 à 100 : plus le score est élevé, plus le signal est net.
  score    Int              @default(0)
  /// Extrait déclencheur (jamais le message entier : confidentialité).
  excerpt  String           @default("")
  status   RiskFlagStatus   @default(OPEN)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([status, createdAt])
  @@map("touma_risk_flags")
}

/// Blocage d'un utilisateur par un autre : plus aucun fil ne peut être ouvert
/// ni alimenté entre eux.
model ToumaUserBlock {
  id        String @id @default(cuid())
  blockerId String
  blocker   User   @relation("BlockAuthor", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String @default("")

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("touma_user_blocks")
}

/// Réponse type enregistrée par un vendeur ou un acheteur professionnel.
model ToumaSavedReply {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title   String
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("touma_saved_replies")
}

/// Préférences de notification par catégorie et par canal.
model ToumaNotificationPreference {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// MESSAGES | NEGOTIATION | RFQ | ORDERS | MARKETING
  category String
  inApp    Boolean @default(true)
  email    Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@map("touma_notification_preferences")
}

/// Pièce jointe d'un message. Le type et la taille sont contrôlés au dépôt.
model ToumaMessageAttachment {
  id         String       @id @default(cuid())
  messageId  String
  message    ToumaMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Clé de stockage non devinable. Le fichier n'est jamais servi depuis une
  /// URL publique : il passe par une redirection signée, réservée aux participants.
  storageKey String?      @unique
  /// URL externe (contenu hébergé ailleurs, historique V13).
  url        String?
  name       String
  mimeType   String
  sizeBytes  Int          @default(0)
  /// Empreinte SHA-256 du contenu reçu : détecte les doublons et prouve l'intégrité.
  checksum   String?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("touma_message_attachments")
}

// ── Après-vente : retours, remboursements ────────────────────────────────────

/// Demande de retour émise par l'acheteur sur une commande livrée.
///
/// Le montant n'est **jamais** transmis par le client : il est recalculé à
/// partir des instantanés de la commande. Un retour ne rembourse rien par
/// lui-même — le remboursement est un acte financier distinct (ToumaRefund),
/// tracé et réversible uniquement par une décision humaine.
model ToumaReturnRequest {
  id        String       @id @default(cuid())
  reference String       @unique
  orderId   String
  order     ToumaOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  storeId   String
  store     ToumaStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status    ReturnStatus @default(REQUESTED)
  reason    ReturnReason
  comment   String       @default("")

  currency        String
  /// Montant réclamé, recalculé côté serveur à partir des lignes retournées.
  requestedAmount Decimal  @db.Decimal(18, 4)
  /// Montant validé par le vendeur ou l'administration (≤ montant réclamé).
  approvedAmount  Decimal? @db.Decimal(18, 4)
  /// Les frais de livraison sont remboursés quand le tort vient du vendeur.
  refundShipping  Boolean  @default(false)

  /// Preuves déposées par l'acheteur (URL + type), jamais de données sensibles.
  evidence Json @default("[]")

  sellerNote     String?
  rejectionNote  String?
  /// Numéro de suivi du colis retourné, fourni par l'acheteur.
  trackingNumber String?

  decidedById String?
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  receivedAt  DateTime?
  refundedAt  DateTime?
  closedAt    DateTime?

  items         ToumaReturnItem[]
  refunds       ToumaRefund[]
  evidenceFiles ToumaDisputeEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([buyerId])
  @@index([storeId])
  @@index([status])
  @@map("touma_return_requests")
}

/// Ligne retournée : rattachée à une ligne de commande, au prix figé d'achat.
model ToumaReturnItem {
  id              String             @id @default(cuid())
  returnRequestId String
  returnRequest   ToumaReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       ToumaOrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  titleSnapshot  String
  quantity       Int
  unitPrice      Decimal          @db.Decimal(18, 4)
  lineTotal      Decimal          @db.Decimal(18, 4)
  currency       String
  /// État constaté à réception (renseigné par le vendeur).
  condition      String?
  conditionGrade ReturnCondition?
  /// Motif propre à la ligne : un colis peut contenir un article cassé et un
  /// article simplement en trop.
  lineReason     ReturnReason?

  createdAt DateTime @default(now())

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("touma_return_items")
}

/// Remboursement : mouvement d'argent réel exécuté via le prestataire de
/// paiement. Toujours rattaché à une commande, et à la demande de retour
/// lorsqu'il en découle. Aucune donnée bancaire n'y est stockée.
model ToumaRefund {
  id        String        @id @default(cuid())
  reference String        @unique
  orderId   String
  order     ToumaOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId String?
  payment   ToumaPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  returnRequestId String?
  returnRequest   ToumaReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  amount   Decimal      @db.Decimal(18, 4)
  currency String
  status   RefundStatus @default(PENDING)
  reason   String       @default("")

  /// Adaptateur ayant exécuté le remboursement et référence renvoyée.
  provider      String
  providerRef   String?
  failureReason String?
  metadata      Json    @default("{}")

  /// Auteur de la décision : toujours un humain (vendeur ou administration).
  initiatedById String?
  initiatedBy   User?   @relation("RefundInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([orderId])
  @@index([paymentId])
  @@index([returnRequestId])
  @@index([status])
  @@map("touma_refunds")
}

// ── Assistance ───────────────────────────────────────────────────────────────

/// Ticket d'assistance. Un acheteur, un vendeur ou une entreprise ouvre un
/// ticket ; l'administration répond. Les notes internes ne sont jamais
/// visibles par le demandeur.
model ToumaSupportTicket {
  id          String         @id @default(cuid())
  reference   String         @unique
  requesterId String
  requester   User           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  subject     String
  category    TicketCategory @default(OTHER)
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)

  orderId String?
  order   ToumaOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  storeId String?
  store   ToumaStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  lastReplyAt DateTime  @default(now())
  resolvedAt  DateTime?
  closedAt    DateTime?

  messages ToumaSupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
  @@index([assignedToId])
  @@map("touma_support_tickets")
}

/// Message d'un ticket. `internal = true` : note d'équipe, jamais renvoyée au
/// demandeur.
model ToumaSupportMessage {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      ToumaSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  internal    Boolean            @default(false)
  /// Pièces jointes contrôlées au dépôt (type et taille).
  attachments Json               @default("[]")

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("touma_support_messages")
}

// ── Promotions ───────────────────────────────────────────────────────────────

/// Code de réduction. Deux natures bien distinctes :
///   • `PLATFORM` — promotion TOUMA : le vendeur est payé plein tarif, la
///     plateforme absorbe la remise sur sa commission ;
///   • `STORE` — promotion du vendeur : elle réduit son propre revenu.
/// Confondre les deux reviendrait à faire financer nos campagnes par les
/// boutiques.
model ToumaCoupon {
  id      String          @id @default(cuid())
  /// Normalisé en majuscules : la saisie de l'acheteur est insensible à la casse.
  code    String          @unique
  funding DiscountFunding @default(PLATFORM)
  /// Renseigné si et seulement si la promotion appartient à une boutique.
  storeId String?
  store   ToumaStore?     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  type        DiscountType
  /// Pourcentage (0–100) ou montant fixe, selon `type`. Ignoré pour la livraison offerte.
  value       Decimal      @default(0) @db.Decimal(18, 4)
  /// Devise obligatoire pour un montant fixe : aucune conversion approximative.
  currency    String?
  description String       @default("")

  /// Conditions d'éligibilité, toutes facultatives.
  minOrderAmount    Decimal? @db.Decimal(18, 4)
  /// Plafond de remise pour un pourcentage (évite qu'un -20 % sur un gros panier coûte une fortune).
  maxDiscountAmount Decimal? @db.Decimal(18, 4)
  /// Pays de livraison éligibles (codes ISO séparés par des virgules). Vide = tous.
  countryCodes      String   @default("")
  /// Réservé à une première commande.
  firstOrderOnly    Boolean  @default(false)

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  /// Nombre total d'utilisations autorisées, et par acheteur.
  usageLimit        Int?
  usageLimitPerUser Int?
  usageCount        Int          @default(0)
  status            CouponStatus @default(ACTIVE)

  createdById String?
  createdBy   User?   @relation("CouponAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  redemptions ToumaCouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@map("touma_coupons")
}

/// Utilisation effective d'un code sur un panier validé. L'unicité par panier
/// empêche qu'un même code soit compté deux fois sur la même commande.
model ToumaCouponRedemption {
  id           String          @id @default(cuid())
  couponId     String
  coupon       ToumaCoupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderGroupId String
  orderGroup   ToumaOrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(18, 4)
  currency String

  createdAt DateTime @default(now())

  @@unique([couponId, orderGroupId])
  @@index([userId])
  @@map("touma_coupon_redemptions")
}

// ── Fidélité ─────────────────────────────────────────────────────────────────

/// Compte de fidélité. Le solde n'est jamais écrit à la main : il est la somme
/// des événements, appliquée de façon atomique à chaque mouvement.
model ToumaLoyaltyAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance        Int    @default(0)
  lifetimePoints Int    @default(0)
  /// Niveau déduit des points cumulés (paliers configurables).
  tier           String @default("BRONZE")

  events ToumaLoyaltyEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_loyalty_accounts")
}

/// Mouvement de points, signé (positif = gagné, négatif = dépensé ou repris).
model ToumaLoyaltyEvent {
  id        String              @id @default(cuid())
  accountId String
  account   ToumaLoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      LoyaltyEventType
  points    Int

  orderId      String?
  order        ToumaOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderGroupId String?
  orderGroup   ToumaOrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: SetNull)

  reason String @default("")

  createdAt DateTime @default(now())

  /// Un seul **gain** par commande : rejouer une livraison ne crédite pas deux
  /// fois. La contrainte est posée en SQL sous forme d'index unique **partiel**
  /// (`WHERE type = 'EARNED'`), parce qu'elle ne vaut que pour le gain :
  /// une reprise de points peut légitimement se produire plusieurs fois sur la
  /// même commande — un remboursement partiel, puis un second. La version
  /// générale de cette contrainte faisait échouer le deuxième remboursement
  /// d'une commande, et le serveur répondait 500.
  /// Voir la migration `touma_v20_finance`.
  @@index([orderId, type])
  @@index([accountId])
  @@map("touma_loyalty_events")
}

// ── Documents commerciaux ────────────────────────────────────────────────────

/// Facture, avoir, reçu, bon de commande, bon de livraison.
///
/// Un document est **figé** : son contenu (parties, lignes, totaux) est copié
/// dans `payload` à l'émission et n'est plus jamais modifié. Corriger une
/// facture se fait par un avoir, jamais en réécrivant l'original — c'est la
/// règle de base d'une comptabilité vérifiable.
model ToumaDocument {
  id     String       @id @default(cuid())
  type   DocumentType
  /// Numéro affiché, unique : « FAC-2026-A1B2-00001 ».
  number String       @unique
  /// Série de numérotation : un émetteur, un type, une année.
  series String

  issuerKind DocumentIssuer

  /// Émetteur boutique, le cas échéant.
  storeId String?
  store   ToumaStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  /// Destinataire (ou émetteur, pour un bon de commande).
  buyerId String
  buyer   User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  orderId      String?
  order        ToumaOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderGroupId String?
  orderGroup   ToumaOrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: SetNull)

  currency    String
  totalAmount Decimal @db.Decimal(18, 4)
  /// Taxes effectivement facturées. Nul tant qu'aucun régime fiscal n'est
  /// configuré pour l'émetteur : mieux vaut ne rien annoncer qu'annoncer faux.
  taxAmount   Decimal @default(0) @db.Decimal(18, 4)

  /// Contenu figé du document (parties, lignes, totaux, mentions).
  payload Json

  /// Clé d'origine (« INVOICE:<orderId> ») : un même événement n'émet qu'un
  /// seul document, même rejoué.
  sourceKey String? @unique

  /// Document corrigé par celui-ci (un avoir référence sa facture).
  relatedDocumentId String?

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([buyerId])
  @@index([storeId])
  @@index([orderId])
  @@index([type])
  @@map("touma_documents")
}

/// Compteur d'une série de numérotation. Incrémenté de façon atomique : deux
/// factures ne peuvent pas porter le même numéro.
model ToumaDocumentSequence {
  id      String @id @default(cuid())
  /// « INVOICE:2026:<storeId> » ou « PAYMENT_RECEIPT:2026:platform ».
  key     String @unique
  counter Int    @default(0)

  updatedAt DateTime @updatedAt

  @@map("touma_document_sequences")
}

// ── Réputation vendeur ───────────────────────────────────────────────────────

/// Réputation d'une boutique, **calculée sur ses transactions réelles** :
/// délais tenus, annulations, litiges, retours, réactivité. Aucun indicateur
/// n'est affiché tant que l'échantillon est trop faible — un « 100 % de
/// livraisons à l'heure » sur deux commandes ne veut rien dire.
///
/// C'est un instantané recalculé, jamais une saisie : la source de vérité reste
/// les commandes, expéditions, litiges et messages.
model ToumaStoreReputation {
  id      String     @id @default(cuid())
  storeId String     @unique
  store   ToumaStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Volume sur lequel portent les indicateurs.
  ordersPaid      Int @default(0)
  ordersDelivered Int @default(0)

  /// Taux (0–1), nuls tant que le volume minimal n'est pas atteint.
  onTimeRate       Decimal? @db.Decimal(5, 4)
  cancellationRate Decimal? @db.Decimal(5, 4)
  disputeRate      Decimal? @db.Decimal(5, 4)
  returnRate       Decimal? @db.Decimal(5, 4)
  responseRate     Decimal? @db.Decimal(5, 4)

  /// Délais observés, en heures et en jours.
  avgPreparationHours Decimal? @db.Decimal(10, 2)
  avgDeliveryDays     Decimal? @db.Decimal(10, 2)
  medianResponseHours Decimal? @db.Decimal(10, 2)

  /// Note des avis, recopiée au moment du calcul.
  ratingAverage Decimal @default(0) @db.Decimal(3, 2)
  ratingCount   Int     @default(0)

  /// Score global 0–100 et palier. Nuls tant que l'échantillon est insuffisant.
  score Int?
  level String @default("NOUVEAU")

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("touma_store_reputations")
}

// ── Sourcing ─────────────────────────────────────────────────────────────────

/// Invitation d'un fournisseur à répondre à un appel d'offres.
///
/// Un appel d'offres ouvert reste visible de tous : l'invitation ne crée pas de
/// privilège, elle **sollicite** explicitement un fournisseur repéré par
/// l'acheteur — et le prévient. C'est la façon dont un acheteur en gros
/// travaille réellement : il ne publie pas dans le vide, il démarche.
model ToumaRfqInvitation {
  id      String     @id @default(cuid())
  rfqId   String
  rfq     ToumaRfq   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  storeId String
  store   ToumaStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation("InvitationAuthor", fields: [invitedById], references: [id], onDelete: SetNull)

  message String @default("")

  createdAt DateTime @default(now())

  @@unique([rfqId, storeId])
  @@index([storeId])
  @@map("touma_rfq_invitations")
}

/// Recherche effectuée dans le catalogue, conservée pour mesurer la **demande
/// non servie** : ce que les acheteurs cherchent et ne trouvent pas est la
/// meilleure indication de ce qui manque au catalogue.
///
/// Volontairement **anonyme** : le terme, le nombre de résultats et le pays
/// suffisent à cette mesure. Rattacher chaque recherche à un compte
/// constituerait un historique personnel dont personne n'a besoin ici.
model ToumaSearchQuery {
  id          String  @id @default(cuid())
  /// Terme normalisé (minuscules, espaces réduits) pour pouvoir être regroupé.
  term        String
  /// Terme tel qu'il a été saisi, pour l'afficher tel quel.
  rawTerm     String
  resultCount Int     @default(0)
  /// Pays de l'acheteur, quand il est connu — jamais son identité.
  countryCode String?

  createdAt DateTime @default(now())

  @@index([term])
  @@index([createdAt])
  @@map("touma_search_queries")
}

// ─────────────────────────────────────────────────────────────────────────────
// V21 — TOUMA TRUST
//
// Quatre concepts distincts, et les confondre serait la première erreur :
//
//   VERIFICATION — des **pièces** contrôlées par un humain ou un prestataire.
//   REPUTATION   — ce que les acheteurs déclarent (avis).
//   PERFORMANCE  — ce que les transactions démontrent (délais, litiges).
//   RISK         — des signaux de fraude, qui n'ont pas vocation à être publics.
//
// `ToumaStoreReputation` (V17) porte déjà la PERFORMANCE d'une boutique, et
// `ToumaRiskScore` le RISQUE d'un compte. Rien de tout cela n'est dupliqué
// ici : le score de confiance les **agrège**, il ne les recalcule pas.
// ─────────────────────────────────────────────────────────────────────────────

enum TrustEntityType {
  SELLER
  BUYER
  SUPPLIER
  PRODUCT
}

enum TrustLevel {
  /// Pas encore assez de données. Ce n'est pas un mauvais score : c'est aucun.
  INSUFFICIENT_DATA
  LOW
  MODERATE
  GOOD
  EXCELLENT
}

/// Score de confiance courant d'une entité. Une ligne par entité, remplacée à
/// chaque calcul — l'historique vit dans `ToumaTrustScoreSnapshot`.
model ToumaTrustScore {
  id         String          @id @default(cuid())
  entityType TrustEntityType
  entityId   String

  /// 0–100, ou null tant que le volume minimal n'est pas atteint. Un score
  /// absent se dit « pas encore mesurable », jamais zéro.
  score Int?
  level TrustLevel @default(INSUFFICIENT_DATA)

  /// Détail lisible : [{ code, label, weight, value, points, direction }].
  /// C'est ce qui rend le score explicable ; il n'est jamais affiché sans lui.
  breakdown Json @default("[]")

  /// Volume sur lequel porte le calcul, pour dire « sur 142 commandes ».
  sampleSize Int @default(0)

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, score])
  @@map("touma_trust_scores")
}

/// Historique : 90 → 87 → 84 → 88, avec la raison de chaque mouvement. Rien
/// n'est écrasé, et un vendeur peut donc contester une baisse datée.
model ToumaTrustScoreSnapshot {
  id         String          @id @default(cuid())
  entityType TrustEntityType
  entityId   String

  score     Int?
  level     TrustLevel
  breakdown Json       @default("[]")
  /// Événement déclencheur (`ORDER_COMPLETED`, `DISPUTE_OPENED`, `SCHEDULED`).
  reason    String
  /// Écart avec le score précédent, null au premier calcul.
  delta     Int?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("touma_trust_score_snapshots")
}

/// Badge attribué **par le serveur** à partir d'une règle. Le frontend ne fait
/// que l'afficher ; il ne peut ni en créer ni en retirer.
model ToumaTrustBadge {
  id         String          @id @default(cuid())
  entityType TrustEntityType
  entityId   String
  /// `IDENTITY_VERIFIED`, `RELIABLE_DELIVERY`, … — voir `trust/badges.ts`.
  code       String

  /// Ce qui justifie le badge au moment où il est posé : le chiffre exact,
  /// pour qu'on puisse relire la décision plus tard.
  evidence Json @default("{}")

  awardedAt DateTime  @default(now())
  /// Un badge se retire quand sa condition cesse d'être vraie. La ligne reste.
  revokedAt DateTime?

  @@unique([entityType, entityId, code])
  @@index([entityType, entityId, revokedAt])
  @@map("touma_trust_badges")
}

/// Fait qui peut faire bouger un score. Écrit par le domaine (commande,
/// litige, avis), consommé par le moteur de confiance.
model ToumaTrustEvent {
  id         String          @id @default(cuid())
  entityType TrustEntityType
  entityId   String
  /// `ORDER_COMPLETED`, `DISPUTE_OPENED`, `REVIEW_FLAGGED`, …
  type       String
  detail     Json            @default("{}")

  occurredAt  DateTime  @default(now())
  /// Null tant que le moteur ne l'a pas pris en compte.
  processedAt DateTime?

  @@index([entityType, entityId, occurredAt])
  @@index([processedAt])
  @@map("touma_trust_events")
}

/// État d'un compte vis-à-vis des règles de la place de marché.
///
/// `User.status` (ACTIVE | SUSPENDED | DELETED) reste l'état **technique** du
/// compte. Celui-ci est l'état **de confiance**, qui a besoin de nuances que
/// l'autre n'a pas : un compte restreint peut acheter mais plus vendre.
enum AccountStandingStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
}

enum TrustAppealStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model ToumaAccountStanding {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       AccountStandingStatus @default(ACTIVE)
  /// Motif interne (`FRAUD`, `REVIEW_MANIPULATION`, `POLICY_VIOLATION`, …).
  reason       String?
  /// Ce qui est dit à l'utilisateur. Une sanction sans motif lisible n'est pas
  /// contestable, et une décision non contestable n'a pas sa place ici.
  publicReason String?
  /// Pièces à l'appui de la décision — jamais exposées à l'intéressé en l'état.
  evidence     Json                  @default("{}")

  /// Qui a décidé. Une suspension automatique n'existe pas : un humain signe.
  actorId String?
  actor   User?   @relation("StandingActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// Une restriction peut être temporaire.
  expiresAt DateTime?

  decidedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("touma_account_standings")
}

/// Contestation d'une décision de confiance (refus de vérification, suspension,
/// avis masqué). Sans recours, une décision automatique devient arbitraire.
model ToumaTrustAppeal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("AppealAuthor", fields: [userId], references: [id], onDelete: Cascade)

  /// Ce qui est contesté : `VERIFICATION`, `STANDING`, `REVIEW`, `TRUST_SCORE`.
  subjectType String
  subjectId   String?

  status   TrustAppealStatus @default(SUBMITTED)
  message  String
  /// Pièces jointes par le contestataire : [{ kind, url }].
  evidence Json              @default("[]")

  reviewerId String?
  reviewer   User?     @relation("AppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  resolution String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@map("touma_trust_appeals")
}

/// Modération d'un avis. `ToumaReview.status` était une chaîne libre commentée
/// « PENDING | PUBLISHED | REJECTED » : un enum la remplace, avec les deux
/// états qui manquaient — masqué après publication, et signalé en attente
/// d'une décision humaine.
enum ReviewModerationStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
  FLAGGED
}

/// Ce que le moteur recommande de faire d'un avis. Il **recommande** : masquer
/// un avis reste une décision tracée, pas une conséquence automatique d'un
/// score probabiliste.
enum ReviewRiskAction {
  ALLOW
  FLAG
  HOLD
  REVIEW
}

/// Signaux de manipulation sur un avis.
model ToumaReviewRiskScore {
  id       String      @id @default(cuid())
  reviewId String      @unique
  review   ToumaReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  /// 0 (rien à signaler) → 100.
  score   Int              @default(0)
  action  ReviewRiskAction @default(ALLOW)
  /// [{ code, weight, detail }] — mêmes conventions que `ToumaRiskScore`.
  signals Json             @default("[]")

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([action])
  @@map("touma_review_risk_scores")
}

enum TransactionRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Ce qui est fait d'une transaction jugée risquée. `BLOCK` n'est jamais la
/// conséquence d'un score seul : il faut une règle nommée qui le dise.
enum TransactionRiskDecision {
  ALLOW
  REVIEW
  REQUIRE_VERIFICATION
  HOLD
  BLOCK
}

/// Évaluation d'une commande au moment où elle est passée. Conservée : c'est
/// la trace de ce que la plateforme savait quand elle a laissé passer.
model ToumaTransactionRisk {
  id      String     @id @default(cuid())
  orderId String     @unique
  order   ToumaOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  score    Int
  level    TransactionRiskLevel
  decision TransactionRiskDecision @default(ALLOW)
  /// [{ code, label, weight, detail }] — chaque facteur est nommé.
  factors  Json                    @default("[]")

  /// Renseignés quand un humain a tranché après coup.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@map("touma_transaction_risks")
}

/// Fiabilité d'un fournisseur B2B. Distincte de la réputation de détail : un
/// bon vendeur au détail n'est pas nécessairement un fournisseur fiable — le
/// MOQ, le délai annoncé et la tenue d'un devis ne s'y mesurent pas.
model ToumaSupplierScore {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("SupplierScore", fields: [userId], references: [id], onDelete: Cascade)

  /// Volumes réels observés.
  rfqsInvited     Int @default(0)
  quotesSubmitted Int @default(0)
  quotesAccepted  Int @default(0)
  b2bOrders       Int @default(0)

  /// Taux (0–1), nuls sous le volume minimal.
  responseRate     Decimal? @db.Decimal(5, 4)
  acceptanceRate   Decimal? @db.Decimal(5, 4)
  /// Délai médian de réponse à une demande, en heures.
  medianQuoteHours Decimal? @db.Decimal(10, 2)

  score Int?
  level TrustLevel @default(INSUFFICIENT_DATA)

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([score])
  @@map("touma_supplier_scores")
}

// ─────────────────────────────────────────────────────────────────────────────
// V22 — TOUMA GROWTH
//
// Ce que V22 **n'a pas refait** : `ToumaCoupon` porte déjà un moteur de remise
// serveur — fonction pure, financement tracé, répartition au centime près,
// limites par acheteur, plafond de remise. `ToumaLoyaltyAccount` porte déjà les
// points. Les dupliquer aurait produit deux moteurs divergents sur le même
// panier.
//
// Ce que V22 ajoute, et qui manquait vraiment :
//
//   • une **promotion sans code** — une remise qui s'applique parce que le
//     panier remplit des conditions, pas parce qu'on a tapé un mot ;
//   • des **conditions composables** stockées en structure, jamais évaluées
//     depuis une chaîne ;
//   • une **priorité** et un cumul explicites, parce que deux remises qui se
//     rencontrent doivent se départager de façon prévisible ;
//   • un **budget** qui arrête une campagne plutôt que de la laisser courir ;
//   • un **historique de prix**, sans lequel aucun « prix barré » n'est
//     vérifiable — et un prix barré invérifiable est un mensonge.
// ─────────────────────────────────────────────────────────────────────────────

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  TIERED_DISCOUNT
  BUNDLE_DISCOUNT
  FIRST_ORDER
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

/// Qui paie la remise. `PARTNER` existe pour un financement tiers ; tant
/// qu'aucun partenariat n'est signé, aucune promotion ne peut le porter — le
/// service le refuse, parce qu'une remise dont le financeur est imaginaire
/// fausserait le règlement du vendeur.
enum PromotionFunding {
  PLATFORM
  SELLER
  PARTNER
}

/// Comment une promotion se comporte face à une autre.
enum PromotionStacking {
  /// Peut s'ajouter à d'autres remises cumulables.
  STACKABLE
  /// S'applique seule parmi les non-cumulables ; la meilleure l'emporte.
  NON_STACKABLE
  /// Exclut toute autre remise, y compris un code saisi par l'acheteur.
  EXCLUSIVE
}

model ToumaPromotion {
  id          String          @id @default(cuid())
  name        String
  description String          @default("")
  type        PromotionType
  status      PromotionStatus @default(DRAFT)

  /// Boutique propriétaire, ou null pour une promotion de la place de marché.
  /// Un vendeur ne peut jamais créer une promotion financée par TOUMA : le
  /// service lie `storeId` et `funding`.
  storeId String?
  store   ToumaStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  funding  PromotionFunding  @default(PLATFORM)
  stacking PromotionStacking @default(NON_STACKABLE)
  /// Départage deux promotions concurrentes. Le plus grand l'emporte ; à
  /// égalité, la remise la plus avantageuse pour l'acheteur.
  priority Int               @default(0)

  /// Pourcentage (0–100) ou montant fixe selon `type`.
  value             Decimal  @default(0) @db.Decimal(18, 4)
  /// Obligatoire pour un montant fixe : aucune conversion approximative.
  currency          String?
  /// Plafond de remise pour un pourcentage.
  maxDiscountAmount Decimal? @db.Decimal(18, 4)

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  /// Campagne de rattachement, quand la promotion en fait partie.
  campaignId String?
  campaign   ToumaCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  rules  ToumaPromotionRule[]
  budget ToumaPromotionBudget?
  usages ToumaPromotionUsage[]

  createdById String?
  createdBy   User?   @relation("PromotionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([storeId, status])
  @@map("touma_promotions")
}

/// Condition d'application.
///
/// Stockée en **structure**, jamais en expression à évaluer : `eval()` sur une
/// règle commerciale, c'est une exécution de code arbitraire déguisée en
/// paramètre. Le moteur ne connaît que les opérateurs déclarés ci-dessous.
enum PromotionRuleKind {
  MIN_ORDER_AMOUNT
  MIN_QUANTITY
  PRODUCT
  CATEGORY
  SELLER
  COUNTRY
  PROVINCE
  FIRST_ORDER
  NEW_CUSTOMER
  CUSTOMER_SEGMENT
  MIN_STOCK
  MAX_STOCK
}

model ToumaPromotionRule {
  id          String            @id @default(cuid())
  promotionId String
  promotion   ToumaPromotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  kind        PromotionRuleKind

  /// Seuil numérique, pour les règles qui en ont un.
  threshold Decimal? @db.Decimal(18, 4)
  /// Identifiants visés (produits, catégories, boutiques, provinces, pays).
  /// Une liste vide signifie « aucune restriction sur cette dimension ».
  values    String[] @default([])
  /// `true` inverse la règle : « sauf ces catégories ».
  negated   Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([promotionId])
  @@map("touma_promotion_rules")
}

/// Budget d'une promotion.
///
/// `spent` n'est jamais écrit par une lecture-puis-écriture : l'incrément est
/// conditionnel en SQL, de sorte que deux commandes simultanées ne peuvent pas
/// dépasser l'enveloppe. Sans cela, une campagne à fort trafic déborde
/// exactement au moment où elle coûte le plus cher.
model ToumaPromotionBudget {
  id          String         @id @default(cuid())
  promotionId String         @unique
  promotion   ToumaPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  total    Decimal @db.Decimal(18, 4)
  spent    Decimal @default(0) @db.Decimal(18, 4)
  currency String

  /// Suspend la promotion dès que l'enveloppe est épuisée.
  stopWhenExhausted Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_promotion_budgets")
}

/// Une application effective, conservée pour l'analyse et le budget.
model ToumaPromotionUsage {
  id          String         @id @default(cuid())
  promotionId String
  promotion   ToumaPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  userId  String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId String?
  order   ToumaOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  amount   Decimal @db.Decimal(18, 4)
  currency String

  createdAt DateTime @default(now())

  @@index([promotionId, createdAt])
  @@index([userId])
  @@map("touma_promotion_usages")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}

/// Campagne : un regroupement de promotions sous un même nom et une même
/// période. Aucun événement culturel n'est codé en dur — ni Ramadan, ni
/// rentrée : une campagne est une ligne créée par un humain, avec ses dates.
model ToumaCampaign {
  id          String         @id @default(cuid())
  name        String
  description String         @default("")
  status      CampaignStatus @default(DRAFT)

  startsAt DateTime
  endsAt   DateTime

  /// Portée géographique. Vide = partout où TOUMA opère.
  countryCodes String[] @default([])
  provinceIds  String[] @default([])

  promotions ToumaPromotion[]

  createdById String?
  createdBy   User?   @relation("CampaignAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
  @@map("touma_campaigns")
}

/// Historique de prix.
///
/// **Sans lui, un « prix barré » n'est pas vérifiable.** Afficher « 25 000 →
/// 20 000 » suppose que 25 000 a réellement été demandé, et pendant combien de
/// temps. Cette table le prouve ou le dément ; l'affichage d'une économie s'y
/// adosse et se tait quand elle n'y trouve rien.
model ToumaProductPriceHistory {
  id        String       @id @default(cuid())
  productId String
  product   ToumaProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?

  price    Decimal @db.Decimal(18, 4)
  currency String
  /// Ce qui a produit ce prix : `SELLER`, `IMPORT`, `PROMOTION`, `ADMIN`.
  source   String  @default("SELLER")

  validFrom DateTime  @default(now())
  /// Null tant que ce prix est celui en vigueur.
  validTo   DateTime?

  createdAt DateTime @default(now())

  @@index([productId, validFrom])
  @@index([productId, validTo])
  @@map("touma_product_price_history")
}

/// Palier de fidélité.
///
/// Les noms sont des **lignes en base**, pas un enum : « BRONZE » n'a rien
/// d'universel, et une place de marché tchadienne doit pouvoir nommer ses
/// paliers en français, en arabe, ou autrement. `ToumaLoyaltyAccount.tier`
/// porte déjà une chaîne ; cette table lui donne un sens et des conditions.
model ToumaLoyaltyTier {
  id   String @id @default(cuid())
  /// Code stable, employé par `ToumaLoyaltyAccount.tier`.
  code String @unique
  name String
  /// Rang croissant : 0 est le palier d'entrée.
  rank Int    @unique

  /// Conditions d'accès. `null` = non exigé.
  minLifetimePoints Int?
  minOrders         Int?

  /// Avantages **réellement appliqués**. Un avantage listé ici sans code qui
  /// l'applique serait une promesse non tenue : le service refuse d'en
  /// déclarer un qu'il ne sait pas honorer.
  discountPercent  Decimal? @db.Decimal(5, 2)
  freeShipping     Boolean  @default(false)
  pointsMultiplier Decimal  @default(1) @db.Decimal(5, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_loyalty_tiers")
}

enum ReferralStatus {
  /// Le code a été employé, le filleul a créé son compte.
  REGISTERED
  /// Le filleul a rempli la condition (une commande terminée).
  QUALIFIED
  /// La récompense a été versée.
  REWARDED
  /// Écarté : auto-parrainage, fraude, ou condition jamais remplie.
  REJECTED
}

/// Code de parrainage. Un par compte, stable, insensible à la casse.
model ToumaReferralCode {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("ReferralOwner", fields: [userId], references: [id], onDelete: Cascade)
  code   String @unique

  createdAt DateTime @default(now())

  @@map("touma_referral_codes")
}

/// Un parrainage effectif.
///
/// `refereeId` est **unique** : un compte ne peut être parrainé qu'une fois,
/// et la contrainte est en base plutôt que dans le service — c'est la seule
/// façon qu'elle tienne sous deux inscriptions simultanées.
model ToumaReferral {
  id         String         @id @default(cuid())
  referrerId String
  referrer   User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId  String         @unique
  referee    User           @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  status     ReferralStatus @default(REGISTERED)

  /// Commande ayant rempli la condition.
  qualifyingOrderId String?
  qualifiedAt       DateTime?
  rewardedAt        DateTime?

  /// Pourquoi un parrainage a été écarté. Consigné, pas seulement appliqué.
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, status])
  @@map("touma_referrals")
}

/// Segment d'acheteurs, calculé depuis des faits.
///
/// **Aucune catégorie sensible.** Ni religion, ni origine, ni appartenance
/// politique : les règles ne portent que sur le comportement commercial —
/// nombre de commandes, montant dépensé, date du dernier achat. La donnée
/// sensible n'entre pas dans le calcul parce qu'elle n'est pas lue.
model ToumaCustomerSegment {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String @default("")

  /// Conditions, toutes facultatives et cumulatives.
  minOrders             Int?
  maxOrders             Int?
  minSpend              Decimal? @db.Decimal(18, 4)
  spendCurrency         String?
  /// Jours écoulés depuis la dernière commande.
  minDaysSinceLastOrder Int?
  maxDaysSinceLastOrder Int?

  active Boolean @default(true)

  members ToumaCustomerSegmentMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_customer_segments")
}

model ToumaCustomerSegmentMember {
  id        String               @id @default(cuid())
  segmentId String
  segment   ToumaCustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Ce qui a justifié l'appartenance au moment du calcul.
  evidence Json @default("{}")

  computedAt DateTime @default(now())

  @@unique([segmentId, userId])
  @@index([userId])
  @@map("touma_customer_segment_members")
}

enum FlashSaleStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

/// Vente flash : un prix réduit, une quantité bornée, une fenêtre de temps.
///
/// **Le seul risque qui compte ici est la survente.** Annoncer cent unités à
/// prix cassé et en vendre cent trente, c'est devoir annuler trente commandes
/// déjà payées — et perdre trente acheteurs qui avaient raison de faire
/// confiance. Tout le modèle est construit autour de cela : `reserved` n'est
/// jamais écrit par une lecture suivie d'une écriture, et la limite par
/// acheteur est une contrainte en base, pas une vérification dans un service.
model ToumaFlashSale {
  id     String          @id @default(cuid())
  name   String
  status FlashSaleStatus @default(DRAFT)

  storeId String
  store   ToumaStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId String
  product   ToumaProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Prix pendant la vente. Il doit être inférieur au prix courant du produit,
  /// sans quoi ce n'est pas une vente flash.
  price    Decimal @db.Decimal(18, 4)
  currency String

  startsAt DateTime
  endsAt   DateTime

  /// Unités offertes à ce prix, et unités déjà réservées.
  quantityLimit Int
  reserved      Int @default(0)
  /// Unités maximales par acheteur. 0 = pas de limite.
  perUserLimit  Int @default(1)

  claims ToumaFlashSaleClaim[]

  createdById String?
  createdBy   User?   @relation("FlashSaleAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([productId])
  @@map("touma_flash_sales")
}

/// Réservation d'un acheteur sur une vente flash.
///
/// L'unicité `(flashSaleId, userId)` **est** la limite par acheteur : la poser
/// en base plutôt que dans un service est la seule façon qu'elle tienne quand
/// le même acheteur ouvre deux onglets.
model ToumaFlashSaleClaim {
  id          String         @id @default(cuid())
  flashSaleId String
  flashSale   ToumaFlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  quantity Int
  orderId  String?

  createdAt DateTime @default(now())

  @@unique([flashSaleId, userId])
  @@index([userId])
  @@map("touma_flash_sale_claims")
}

// ── Touma Intelligence (V23) ─────────────────────────────────────────────────

/// Famille de tâche confiée à l'IA. Sert au routage de modèle et aux plafonds :
/// une classification ne coûte pas ce que coûte un raisonnement, et les deux
/// n'ont aucune raison de partager le même budget.
enum AiTaskKind {
  CLASSIFY
  GENERATE
  STRUCTURED
  EMBED
  MODERATE
  TRANSLATE
  REASON
}

/// Niveau de risque d'un outil. C'est ce niveau, et lui seul, qui décide si une
/// confirmation humaine est exigée avant exécution.
enum AiRiskLevel {
  READ_ONLY
  LOW_RISK
  MEDIUM_RISK
  HIGH_RISK
  FINANCIAL
}

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum AiConversationSurface {
  BUYER
  SELLER
  BUSINESS
  ADMIN
  SUPPORT
}

enum AiMemoryKind {
  SESSION
  PREFERENCE
  TASK
}

enum AiFeedbackVerdict {
  HELPFUL
  NOT_HELPFUL
  INCORRECT
  OUTDATED
  IRRELEVANT
  UNSAFE
  WRONG_PRODUCT
  WRONG_PRICE
}

enum AiConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum AiInsightKind {
  DEMAND
  INVENTORY
  PRICE_ANOMALY
  SELLER_PERFORMANCE
  FRAUD_SIGNAL
  MARKETING
}

/// Conversation avec l'assistant. La surface dit depuis quel espace elle est
/// ouverte : un vendeur ne pose pas les mêmes questions qu'un acheteur et
/// n'a pas droit aux mêmes outils.
model ToumaAiConversation {
  id      String                @id @default(cuid())
  userId  String?
  user    User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  surface AiConversationSurface @default(BUYER)
  title   String?
  locale  String                @default("fr")
  /// Boutique ou organisation concernée, quand la surface l'exige.
  scopeId String?

  messages      ToumaAiMessage[]
  toolCalls     ToumaAiToolCall[]
  usage         ToumaAiUsage[]
  feedback      ToumaAiFeedback[]
  confirmations ToumaAiActionConfirmation[]

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, lastMessageAt])
  @@map("touma_ai_conversations")
}

/// Un tour de conversation.
///
/// `content` est **rédigé** avant écriture : ce qui ressemble à un jeton, une
/// carte ou un secret est remplacé avant d'atteindre la base. Une conversation
/// n'a pas à devenir un dépôt de secrets parce que quelqu'un en a collé un.
model ToumaAiMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   ToumaAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String
  /// Cartes de résultat (produits, commandes, devis) attachées à la réponse.
  attachments    Json                @default("[]")
  /// Fournisseur et modèle ayant produit ce tour, quand il vient de l'IA.
  provider       String?
  model          String?
  /// Signal de l'analyseur d'injection sur le contenu d'origine.
  injectionScore Decimal?            @db.Decimal(5, 4)

  toolCalls ToumaAiToolCall[]
  feedback  ToumaAiFeedback[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("touma_ai_messages")
}

/// Appel d'outil, avec son résultat.
///
/// Le cahier des charges sépare `AiToolCall` et `AiToolResult`. Ils sont
/// fusionnés ici : un appel sans résultat et un résultat sans appel n'existent
/// pas, et deux tables obligeraient à une jointure sur chaque lecture d'audit
/// pour ne jamais rien apprendre de plus. L'échec est un résultat comme un
/// autre — il est porté par `ok` et `error`.
model ToumaAiToolCall {
  id             String               @id @default(cuid())
  conversationId String?
  conversation   ToumaAiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        ToumaAiMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  tool           String
  riskLevel      AiRiskLevel @default(READ_ONLY)
  /// Empreinte des arguments : permet de reconnaître un appel identique
  /// (boucle d'outil) sans conserver les arguments eux-mêmes.
  argsHash       String
  /// Arguments après rédaction. Jamais de secret, jamais de donnée KYC.
  args           Json        @default("{}")
  /// Résumé du résultat, pas le résultat entier : l'audit doit dire ce qui a
  /// été lu, pas recopier le catalogue.
  summary        String?
  ok             Boolean     @default(true)
  error          String?
  /// Confirmation humaine attachée, pour un outil qui l'exigeait.
  confirmationId String?

  latencyMs Int      @default(0)
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([tool, createdAt])
  @@index([userId, createdAt])
  @@map("touma_ai_tool_calls")
}

/// Consommation d'un appel au fournisseur. Alimente les plafonds et le tableau
/// de bord des coûts. Le coût est estimé, et le champ le dit.
model ToumaAiUsage {
  id             String               @id @default(cuid())
  userId         String?
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   ToumaAiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// Organisation B2B ou boutique, pour les plafonds par vendeur/entreprise.
  scopeId        String?

  feature  String
  task     AiTaskKind
  provider String
  model    String

  inputTokens   Int     @default(0)
  outputTokens  Int     @default(0)
  /// Coût **estimé** dans la devise du tarif fournisseur, jamais facturé tel
  /// quel. Un fournisseur local coûte zéro et l'écrit.
  estimatedCost Decimal @default(0) @db.Decimal(12, 6)
  costCurrency  String  @default("USD")

  ok        Boolean  @default(true)
  latencyMs Int      @default(0)
  /// Jour (UTC) précalculé : les plafonds quotidiens s'interrogent dessus sans
  /// recalculer une troncature de date sur chaque ligne.
  day       DateTime @db.Date

  createdAt DateTime @default(now())

  @@index([userId, day])
  @@index([scopeId, day])
  @@index([feature, createdAt])
  @@index([provider, model, createdAt])
  @@map("touma_ai_usage")
}

/// Retour d'un utilisateur sur une réponse de l'IA (§39).
model ToumaAiFeedback {
  id             String               @id @default(cuid())
  conversationId String?
  conversation   ToumaAiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        ToumaAiMessage?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  verdict   AiFeedbackVerdict
  comment   String?
  /// Traité par un administrateur ?
  handledAt DateTime?
  handledBy String?

  createdAt DateTime @default(now())

  @@index([verdict, createdAt])
  @@index([messageId])
  @@map("touma_ai_feedback")
}

/// Mesure de qualité agrégée par fonctionnalité et par période (§38).
model ToumaAiEvaluation {
  id      String     @id @default(cuid())
  feature String
  task    AiTaskKind
  /// Début de la fenêtre mesurée (UTC, jour).
  day     DateTime   @db.Date

  requests       Int     @default(0)
  toolCalls      Int     @default(0)
  toolFailures   Int     @default(0)
  errors         Int     @default(0)
  helpful        Int     @default(0)
  notHelpful     Int     @default(0)
  hallucinations Int     @default(0)
  p95LatencyMs   Int     @default(0)
  estimatedCost  Decimal @default(0) @db.Decimal(12, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feature, task, day])
  @@map("touma_ai_evaluations")
}

/// Mémoire de l'assistant. Bornée par construction : tout ce qui est écrit ici
/// porte une expiration, et rien n'y entre sans que l'utilisateur l'ait dit.
model ToumaAiMemory {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind    AiMemoryKind
  /// Clé stable (`budget_max`, `province_livraison`, `langue`…).
  key     String
  value   String
  /// Conversation d'origine, pour une mémoire de session.
  scopeId String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, key])
  @@index([expiresAt])
  @@map("touma_ai_memories")
}

/// Observation produite par un travail périodique (demande, stock, anomalie de
/// prix…). C'est une **observation datée**, pas une vérité : elle porte les
/// faits qui l'ont produite.
model ToumaAiInsight {
  id          String        @id @default(cuid())
  kind        AiInsightKind
  /// Entité concernée : produit, boutique, province…
  subjectType String
  subjectId   String
  /// Code stable de l'observation (`LOW_STOCK`, `SEARCH_SURGE`…).
  code        String
  severity    Int           @default(0)
  /// Faits mesurés ayant produit l'observation. Aucune interprétation ici.
  evidence    Json          @default("{}")
  /// Piste d'action, jamais exécutée automatiquement.
  suggestion  String?

  /// Fenêtre observée, pour qu'une observation ne soit pas rejouée deux fois.
  windowStart DateTime
  windowEnd   DateTime

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([kind, subjectType, subjectId, code, windowEnd])
  @@index([subjectType, subjectId, createdAt])
  @@index([kind, createdAt])
  @@map("touma_ai_insights")
}

/// Demande de confirmation avant une action sensible (§42).
///
/// L'IA ne confirme jamais elle-même : elle dépose ici ce qu'elle propose de
/// faire, et attend qu'un humain le valide avant expiration.
model ToumaAiActionConfirmation {
  id             String               @id @default(cuid())
  conversationId String?
  conversation   ToumaAiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  tool       String
  riskLevel  AiRiskLevel
  /// Paramètres exacts qui seront exécutés si l'humain confirme. Les modifier
  /// après coup reviendrait à faire signer autre chose que ce qui a été lu.
  parameters Json                 @default("{}")
  /// Résumé lisible de ce qui sera fait, en français.
  summary    String
  status     AiConfirmationStatus @default(PENDING)

  expiresAt   DateTime
  confirmedAt DateTime?
  rejectedAt  DateTime?
  /// Résultat de l'exécution, une fois confirmée.
  executedAt  DateTime?
  resultRef   String?

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("touma_ai_action_confirmations")
}

/// Version d'une invite système (§59). Permet de savoir quelle consigne a
/// produit quelle réponse, et de revenir en arrière.
model ToumaAiPromptVersion {
  id      String  @id @default(cuid())
  feature String
  version Int
  body    String
  notes   String?
  /// Une seule version active par fonctionnalité — l'unicité partielle est
  /// posée par la migration, Prisma ne sait pas l'exprimer.
  active  Boolean @default(false)

  createdBy String?
  createdAt DateTime @default(now())

  @@unique([feature, version])
  @@index([feature, active])
  @@map("touma_ai_prompt_versions")
}

/// Exécution d'un travail périodique d'intelligence. Sert à l'idempotence :
/// un travail ne retraite pas une fenêtre déjà traitée.
model ToumaAiJobRun {
  id          String   @id @default(cuid())
  job         String
  /// Fenêtre traitée. L'unicité `(job, windowEnd)` est ce qui rend le travail
  /// idempotent, quel que soit le nombre de fois où le cron le déclenche.
  windowStart DateTime
  windowEnd   DateTime

  ok         Boolean @default(true)
  produced   Int     @default(0)
  error      String?
  durationMs Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([job, windowEnd])
  @@index([job, createdAt])
  @@map("touma_ai_job_runs")
}

// ── TOUMA TRADE (V24) ────────────────────────────────────────────────────────
//
// Le transfrontalier n'est pas une seconde application : c'est une couche de
// **configuration et de vérification** au-dessus des commandes, paiements et
// expéditions existants. Ces modèles disent ce qui est possible ; ils ne
// pilotent ni le paiement, ni l'expédition, ni le grand livre, qui restent
// seuls maîtres de leur domaine.

/// État d'un corridor. `ACTIVE` ne se décrète pas : il se constate.
enum TradeCorridorStatus {
  ACTIVE
  LIMITED
  SUSPENDED
  COMING_SOON
}

enum TradeEligibilityVerdict {
  ELIGIBLE
  NOT_ELIGIBLE
  REQUIRES_REVIEW
  REQUIRES_DOCUMENT
}

enum TradeDocumentKind {
  COMMERCIAL_INVOICE
  PACKING_LIST
  PROFORMA_INVOICE
  PURCHASE_ORDER
  CERTIFICATE_OF_ORIGIN
  SHIPPING_DOCUMENT
  OTHER
}

enum TradeDocumentStatus {
  DRAFT
  ISSUED
  UPLOADED
  VERIFIED
  REJECTED
  EXPIRED
}

/// Origine déclarée par le vendeur, ou vérifiée par une autorité.
///
/// `DECLARED` est l'état par défaut et le restera tant qu'aucun prestataire de
/// vérification n'est branché (§11). Afficher `VERIFIED` sans vérification
/// serait exactement le faux certificat que §69 interdit.
enum TradeOriginStatus {
  UNKNOWN
  DECLARED
  VERIFIED
  DISPUTED
}

/// Fiabilité d'une ligne de coût. Le mélange des trois est interdit : un total
/// qui additionne du confirmé et de l'estimé n'est plus ni l'un ni l'autre.
enum TradeCostConfidence {
  CONFIRMED
  ESTIMATED
  UNKNOWN
}

enum TradeRuleStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  WITHDRAWN
}

enum TradeExceptionKind {
  CUSTOMS_DELAY
  DOCUMENT_MISSING
  ADDRESS_ISSUE
  CARRIER_DELAY
  WEATHER
  SECURITY
  UNKNOWN
}

/// Étapes réelles d'une opération transfrontalière (§40).
enum TradeEventKind {
  RFQ_CREATED
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  PROFORMA_CREATED
  ORDER_CREATED
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  DOCUMENTS_READY
  SHIPMENT_CREATED
  IN_TRANSIT
  CUSTOMS_REVIEW
  OUT_FOR_DELIVERY
  DELIVERED
  SETTLED
  EXCEPTION_RAISED
  CANCELLED
}

/// Source d'un taux de change. `NONE` est l'état réel aujourd'hui.
enum FxRateSource {
  EXTERNAL_PROVIDER
  CENTRAL_BANK
  MANUAL_ADMIN
  NONE
}

/// Configuration commerciale d'un pays (§6).
///
/// Distincte de `Country`, qui porte l'identité du pays (nom, devise,
/// indicatif, fuseau). Ici vit ce qui relève du **commerce** : ce pays
/// échange-t-il, avec quels moyens de paiement, quels transporteurs, quels
/// documents. Fondre les deux ferait dépendre l'existence d'un pays de sa
/// capacité commerciale, alors qu'un pays peut exister sans commercer.
model ToumaTradeCountryConfig {
  id          String  @id @default(cuid())
  countryCode String  @unique
  country     Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  /// Le pays participe-t-il au commerce transfrontalier ?
  tradeEnabled      Boolean             @default(false)
  /// Langues d'échange, codes ISO-639-1 (`fr`, `ar`, `en`).
  languages         String[]            @default([])
  /// Devises acceptées **en plus** de la devise du pays.
  currencies        String[]            @default([])
  /// Codes de moyens de paiement réellement disponibles dans ce pays.
  paymentMethods    String[]            @default([])
  /// Codes de transporteurs desservant ce pays.
  shippingProviders String[]            @default([])
  /// Types de documents que ce pays exige ou accepte.
  documentKinds     TradeDocumentKind[] @default([])
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_trade_country_configs")
}

/// Corridor commercial entre deux pays (§4, §7).
///
/// **Orienté** : TD → CM et CM → TD sont deux lignes distinctes. Ce n'est pas
/// une redondance — les moyens de paiement, les transporteurs et les documents
/// exigés diffèrent selon le sens, et un corridor symétrique forcerait à
/// mentir dans un des deux sens.
model ToumaTradeCorridor {
  id                 String              @id @default(cuid())
  /// Code lisible : `TD_CM`.
  code               String              @unique
  originCountry      String
  destinationCountry String
  status             TradeCorridorStatus @default(COMING_SOON)

  supportedCurrencies      String[]            @default([])
  supportedPaymentMethods  String[]            @default([])
  supportedShippingMethods String[]            @default([])
  requiredDocuments        TradeDocumentKind[] @default([])

  /// Transit annoncé par les transporteurs, en jours. Jamais une garantie.
  estimatedTransitMinDays Int?
  estimatedTransitMaxDays Int?

  /// Réglages libres, propres au corridor.
  configuration Json    @default("{}")
  notes         String?

  rules       ToumaTradeRuleVersion[]
  checks      ToumaTradeEligibilityCheck[]
  tradeOrders ToumaTradeOrder[]
  routes      ToumaTradeRoute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([originCountry, destinationCountry])
  @@index([status])
  @@map("touma_trade_corridors")
}

/// Règle commerciale, **versionnée et sourcée** (§19, §20).
///
/// Une règle sans source est une réglementation inventée. Le champ `source`
/// est obligatoire : il oblige celui qui saisit à dire d'où elle vient, et
/// permet à celui qui la lit de la contester.
///
/// Une version n'est jamais modifiée : elle est remplacée, et l'ancienne passe
/// à `SUPERSEDED`. Une commande passée sous une règle garde la règle qui
/// s'appliquait ce jour-là.
model ToumaTradeRuleVersion {
  id          String              @id @default(cuid())
  corridorId  String?
  corridor    ToumaTradeCorridor? @relation(fields: [corridorId], references: [id], onDelete: Cascade)
  /// Règle propre à un pays plutôt qu'à un corridor.
  countryCode String?

  /// `DOCUMENT_REQUIREMENT`, `PRODUCT_RESTRICTION`, `PAYMENT_RESTRICTION`…
  ruleType String
  version  Int
  status   TradeRuleStatus @default(DRAFT)
  /// Contenu de la règle, interprété selon `ruleType`.
  body     Json            @default("{}")

  /// D'où vient la règle. Sans cela, elle n'est pas opposable.
  sourceName    String
  sourceUrl     String?
  /// Date d'entrée en vigueur telle que l'annonce la source.
  effectiveFrom DateTime
  effectiveTo   DateTime?
  /// Dernière relecture humaine. Une règle jamais relue vieillit en silence.
  reviewedAt    DateTime?
  reviewedById  String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([corridorId, countryCode, ruleType, version])
  @@index([ruleType, status])
  @@index([effectiveFrom])
  @@map("touma_trade_rule_versions")
}

/// Restriction produit pour le transfrontalier (§9).
///
/// Aucune liste universelle de produits interdits n'est livrée avec Touma :
/// elle serait une réglementation inventée. Chaque restriction est saisie,
/// sourcée par une `ToumaTradeRuleVersion`, et s'applique à ce qui est
/// explicitement désigné.
model ToumaCrossBorderProductRule {
  id         String         @id @default(cuid())
  productId  String?
  product    ToumaProduct?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Restriction par catégorie plutôt que par produit.
  categoryId String?
  category   ToumaCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  allowedCountries  String[]            @default([])
  blockedCountries  String[]            @default([])
  allowedCorridors  String[]            @default([])
  requiresReview    Boolean             @default(false)
  requiredDocuments TradeDocumentKind[] @default([])

  /// Version de règle qui fonde cette restriction. Obligatoire en pratique :
  /// une restriction sans fondement est un refus arbitraire.
  ruleVersionId String?
  active        Boolean @default(true)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([categoryId])
  @@map("touma_cross_border_product_rules")
}

/// Volet commercial d'une commande (§3).
///
/// N'duplique **rien** de `ToumaOrder` : ni montants, ni articles, ni statut.
/// Ne porte que ce que la commande ne sait pas — le corridor emprunté, la
/// devise de règlement, l'itinéraire, la chronologie.
model ToumaTradeOrder {
  id      String     @id @default(cuid())
  orderId String     @unique
  order   ToumaOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  corridorId String?
  corridor   ToumaTradeCorridor? @relation(fields: [corridorId], references: [id], onDelete: SetNull)
  routeId    String?
  route      ToumaTradeRoute?    @relation(fields: [routeId], references: [id], onDelete: SetNull)

  /// Devise dans laquelle le vendeur sera réglé, quand elle diffère de celle
  /// payée par l'acheteur. Égale à la devise de commande le plus souvent.
  settlementCurrency String?
  /// Instantané du taux employé, s'il y en a eu un. Jamais recalculé après.
  fxSnapshotId       String?

  documents  ToumaTradeDocument[]
  events     ToumaTradeEvent[]
  exceptions ToumaTradeShipmentException[]
  costs      ToumaTradeCostEstimate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([corridorId])
  @@map("touma_trade_orders")
}

/// Itinéraire configuré (§32).
///
/// N'Djamena → Kousseri → Douala est un exemple, pas une donnée livrée : un
/// itinéraire n'est officiel que si un transporteur ou une source le dit.
/// Touma porte la structure ; le contenu est saisi.
model ToumaTradeRoute {
  id         String             @id @default(cuid())
  corridorId String
  corridor   ToumaTradeCorridor @relation(fields: [corridorId], references: [id], onDelete: Cascade)

  name       String
  /// Étapes : [{ name, countryCode, kind }]. `kind` : `ORIGIN`, `BORDER`, `HUB`, `DESTINATION`.
  legs       Json    @default("[]")
  /// Qui affirme cet itinéraire. Vide = personne, et l'écran le dira.
  sourceName String?
  sourceUrl  String?
  active     Boolean @default(true)

  tradeOrders ToumaTradeOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([corridorId, active])
  @@map("touma_trade_routes")
}

/// Résultat d'une vérification d'éligibilité (§8).
///
/// Conservé : un refus doit pouvoir être expliqué plus tard à celui qui l'a
/// reçu, et une commande acceptée doit garder la trace de ce qui l'autorisait.
model ToumaTradeEligibilityCheck {
  id         String              @id @default(cuid())
  corridorId String?
  corridor   ToumaTradeCorridor? @relation(fields: [corridorId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  buyerCountry  String
  sellerCountry String
  productId     String?
  currency      String?
  paymentMethod String?

  verdict           TradeEligibilityVerdict
  /// [{ code, ok, detail }] — chaque critère nommé, réussi ou non.
  criteria          Json                    @default("[]")
  /// Documents exigés par ce verdict, quand il y en a.
  requiredDocuments TradeDocumentKind[]     @default([])
  reason            String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([verdict, createdAt])
  @@map("touma_trade_eligibility_checks")
}

/// Document commercial (§12).
///
/// Touma **émet** ce qu'elle peut légitimement émettre — facture commerciale,
/// proforma, liste de colisage — à partir de ses propres données. Elle
/// n'émet jamais un certificat d'origine : celui-là vient d'une autorité, et
/// ne peut être que **téléversé** puis vérifié.
model ToumaTradeDocument {
  id           String           @id @default(cuid())
  tradeOrderId String?
  tradeOrder   ToumaTradeOrder? @relation(fields: [tradeOrderId], references: [id], onDelete: Cascade)
  /// Un document peut précéder la commande (proforma sur devis accepté).
  quoteId      String?
  rfqId        String?

  kind   TradeDocumentKind
  status TradeDocumentStatus @default(DRAFT)
  /// Numéro propre au document (facture, proforma). Unique quand il existe.
  number String?

  /// Contenu structuré des documents que Touma émet elle-même.
  payload Json @default("{}")

  /// Clé de stockage privé. Jamais une URL publique permanente (§13).
  storageKey  String?
  fileName    String?
  contentType String?
  sizeBytes   Int?

  /// Émetteur revendiqué, pour un document téléversé.
  issuerName String?
  issuedAt   DateTime?
  expiresAt  DateTime?

  /// Vérification : par qui, quand, et par quel moyen.
  verifiedById       String?
  verifiedAt         DateTime?
  verificationMethod String?
  rejectionReason    String?

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([number])
  @@index([tradeOrderId, kind])
  @@index([status])
  @@map("touma_trade_documents")
}

/// Estimation de coût rendu (§21, §22, §65).
///
/// Chaque ligne porte sa fiabilité. Un total additionnant du confirmé et de
/// l'estimé n'est ni l'un ni l'autre : les sous-totaux sont donc séparés, et
/// une ligne inconnue ne vaut pas zéro — elle rend le total incomplet, et le
/// dit.
model ToumaTradeCostEstimate {
  id           String           @id @default(cuid())
  tradeOrderId String?
  tradeOrder   ToumaTradeOrder? @relation(fields: [tradeOrderId], references: [id], onDelete: Cascade)

  currency String
  /// [{ code, label, amount, confidence, source }]
  lines    Json   @default("[]")

  confirmedTotal    Decimal             @default(0) @db.Decimal(18, 4)
  estimatedTotal    Decimal             @default(0) @db.Decimal(18, 4)
  /// Composants dont le montant est inconnu. Leur présence interdit d'annoncer
  /// un coût rendu définitif.
  unknownComponents String[]            @default([])
  /// Fiabilité de l'ensemble : `CONFIRMED` si toutes les lignes le sont,
  /// `ESTIMATED` s'il y a de l'estimé sans inconnu, `UNKNOWN` dès qu'une ligne
  /// manque. Consignée, parce qu'une estimation relue dans six mois doit dire
  /// elle-même ce qu'elle valait.
  overallConfidence TradeCostConfidence @default(UNKNOWN)

  fxSnapshotId String?
  createdAt    DateTime @default(now())

  @@index([tradeOrderId, createdAt])
  @@map("touma_trade_cost_estimates")
}

/// Instantané de taux de change (§24, §25).
///
/// Un taux sans source ni horodatage n'est pas un taux : c'est un chiffre.
/// Les trois champs sont obligatoires, et `source = NONE` signifie qu'aucune
/// conversion ne doit être présentée comme réelle.
model ToumaFxRateSnapshot {
  id            String       @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal      @db.Decimal(20, 10)
  source        FxRateSource
  sourceName    String?
  sourceUrl     String?
  /// Horodatage **du taux**, pas de son enregistrement.
  rateAt        DateTime
  /// Au-delà, le taux n'est plus employé pour une décision.
  expiresAt     DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([baseCurrency, quoteCurrency, rateAt])
  @@map("touma_fx_rate_snapshots")
}

/// Événement de la chronologie commerciale (§40).
///
/// Tous proviennent des systèmes réels : le paiement écrit ses événements, la
/// logistique les siens. Aucun n'est fabriqué pour remplir une frise.
model ToumaTradeEvent {
  id           String          @id @default(cuid())
  tradeOrderId String
  tradeOrder   ToumaTradeOrder @relation(fields: [tradeOrderId], references: [id], onDelete: Cascade)

  kind        TradeEventKind
  /// Quel système a produit l'événement : `ORDERS`, `PAYMENTS`, `LOGISTICS`…
  origin      String
  /// Faits rattachés. Jamais de donnée sensible.
  detail      Json           @default("{}")
  /// Référence dans le système d'origine (id de paiement, d'expédition).
  referenceId String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tradeOrderId, occurredAt])
  @@index([kind, occurredAt])
  @@map("touma_trade_events")
}

/// Incident d'acheminement (§34).
///
/// La cause n'est renseignée que si le transporteur ou une source fiable la
/// donne. `UNKNOWN` est un état légitime, et de loin le plus fréquent : un
/// colis en retard n'est pas un colis bloqué en douane.
model ToumaTradeShipmentException {
  id           String          @id @default(cuid())
  tradeOrderId String
  tradeOrder   ToumaTradeOrder @relation(fields: [tradeOrderId], references: [id], onDelete: Cascade)
  shipmentId   String?

  kind       TradeExceptionKind @default(UNKNOWN)
  /// Qui affirme cette cause. Vide = personne, et l'écran ne l'affirme pas.
  sourceName String?
  detail     String?

  raisedAt   DateTime  @default(now())
  resolvedAt DateTime?
  resolution String?

  @@index([tradeOrderId, raisedAt])
  @@index([kind])
  @@map("touma_trade_shipment_exceptions")
}

// ── Plateforme multi-pays (V26) ──────────────────────────────────────────────

/// Changement de statut d'un marché.
///
/// Une activation n'est pas un `UPDATE` : c'est une décision. Qui l'a prise,
/// quand, depuis quel état, et ce que disait le contrôle de préparation à cet
/// instant. Sans cette trace, « pourquoi le Cameroun est-il passé actif ? »
/// n'a pas de réponse (§44, et V25 §84 : jamais de modification sans trace).
model ToumaCountryStatusChange {
  id          String        @id @default(cuid())
  countryCode String
  country     Country       @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  fromStatus  CountryStatus
  toStatus    CountryStatus
  /// Motif écrit par l'administrateur. Obligatoire : une activation sans
  /// justification est une activation qu'on ne saura pas relire.
  reason      String
  /// Instantané du contrôle de préparation au moment de la décision. Recalculer
  /// plus tard donnerait l'état du jour, pas celui sur lequel on a décidé.
  readiness   Json?
  changedById String?
  changedBy   User?         @relation("CountryStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([countryCode, createdAt])
  @@map("touma_country_status_changes")
}

/// Un niveau administratif, tel que ce pays le nomme (§7).
///
/// La hiérarchie stockée (province → département → sous-préfecture →
/// localité) est celle des découpages ADM1/ADM2/ADM3 des Nations unies : elle
/// convient à la quasi-totalité des pays africains. Ce qui ne convient pas,
/// ce sont les **noms** : « province » se dit « région » au Cameroun, et
/// « sous-préfecture » y est un « arrondissement ». Afficher un vocabulaire
/// tchadien à un Camerounais, c'est lui dire que ce marché n'est pas le sien.
///
/// Cette table nomme donc les niveaux par pays au lieu de renommer les tables.
/// Le choix est délibéré : remplacer la hiérarchie par un modèle générique
/// `AdministrativeDivision` aurait touché dix tables et toutes les adresses du
/// Tchad, pour un gain nul — les rattachements sont déjà tous facultatifs, un
/// pays qui n'a que deux niveaux en laisse simplement deux vides.
model ToumaCountryDivisionLevel {
  id          String  @id @default(cuid())
  countryCode String
  country     Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  /// 1 = ADM1 (province/région), 2 = ADM2 (département), 3 = ADM3, 4 = localité.
  level       Int
  /// Nom du niveau au singulier, dans la langue par défaut du pays.
  name        String
  /// Nom au pluriel — « des régions », pas « des régions(s) ».
  namePlural  String
  /// Nom arabe, quand le pays a l'arabe parmi ses langues.
  nameAr      String?
  /// Ce pays utilise-t-il ce niveau ? Un pays à deux niveaux met les autres à
  /// faux plutôt que d'inventer un découpage.
  used        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode, level])
  @@index([countryCode])
  @@map("touma_country_division_levels")
}

/// Nature d'un prestataire raccordé à un marché (§11).
enum CountryProviderType {
  PAYMENT
  SHIPPING
  SMS
  EMAIL
  FX
  KYC
  COMPLIANCE
  MAPS
  SEARCH
}

/// Où en est un prestataire sur un marché donné.
///
/// Le même prestataire peut être `ACTIVE` au Tchad et `TESTING` au Cameroun :
/// un contrat signé dans un pays ne vaut pas dans l'autre.
enum CountryProviderStatus {
  PLANNED
  CONFIGURING
  TESTING
  ACTIVE
  SUSPENDED
}

/// Un prestataire, sur un marché, pour un métier (§11, §12).
///
/// **Le problème résolu.** Le prestataire de paiement était une variable
/// d'environnement unique, globale à l'instance. Un TOUMA présent au Tchad et
/// au Cameroun ne peut pas fonctionner ainsi : les opérateurs de monnaie
/// mobile, les transporteurs et les passerelles SMS diffèrent d'un pays à
/// l'autre, et un contrat signé dans l'un ne vaut pas dans l'autre.
///
/// **Aucun secret ici.** `configuration` porte des identifiants publics — un
/// nom de marchand, une URL de rappel, un identifiant d'expéditeur. Les clés
/// d'API et les secrets de signature restent dans l'environnement du serveur,
/// jamais en base (V25 §4). Une vérification refuse l'écriture d'une clé dont
/// le nom évoque un secret.
model ToumaCountryProvider {
  id          String              @id @default(cuid())
  countryCode String
  country     Country             @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  type        CountryProviderType
  /// Code technique de l'adaptateur (`orange-money`, `mock`…).
  code        String
  name        String

  /// Ordre d'essai : 1 d'abord. Deux prestataires au même rang sont départagés
  /// par leur code, pour que la sélection soit déterministe — un choix qui
  /// change d'une requête à l'autre rend tout incident irreproductible.
  priority Int                   @default(100)
  status   CountryProviderStatus @default(PLANNED)

  /// Adaptateur de simulation. Un tel prestataire n'est **jamais** sélectionné
  /// pour une opération réelle, quel que soit son statut : il répond à tout,
  /// y compris à ce que personne ne peut faire.
  simulation Boolean @default(false)

  /// Moyens couverts (`MOBILE_MONEY`, `CASH_ON_DELIVERY`…), selon le métier.
  supportedMethods String[] @default([])
  /// Identifiants publics uniquement. Jamais de clé ni de secret.
  configuration    Json?

  /// Dernière vérification réelle de disponibilité, et son résultat.
  /// Nuls tant qu'aucune sonde n'a tourné : « jamais vérifié » n'est pas
  /// « en panne », et les confondre ferait basculer un prestataire sain.
  lastCheckedAt DateTime?
  lastHealthyAt DateTime?
  healthDetail  String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode, type, code])
  @@index([countryCode, type, status])
  @@map("touma_country_providers")
}

// ── Journal des mouvements de stock (V27) ────────────────────────────────────

/// Nature d'un mouvement de stock.
///
/// Un type n'est pas une étiquette décorative : c'est ce qui permet de
/// répondre à « pourquoi ce produit est-il passé de 12 à 9 ? » sans recouper
/// des horodatages à la main.
enum StockMovementType {
  /// Création d'un produit ou d'une variante avec une quantité de départ.
  INITIAL
  /// Vente : décrément au passage de commande.
  SALE
  /// Retour reçu et remis en stock.
  RETURN
  /// Commande annulée, réservation libérée avec remise en stock.
  CANCELLATION
  /// Réservation libérée sans remise en stock (panier expiré).
  RESERVATION_RELEASE
  /// Correction saisie par le vendeur.
  ADJUSTMENT
  /// Import de catalogue.
  IMPORT
  /// Réception d'une commande fournisseur.
  PURCHASE
  /// Transfert entre points de stockage.
  TRANSFER_OUT
  TRANSFER_IN
  /// Marchandise abîmée ou perdue, constatée.
  DAMAGE
  LOSS
  /// Écart constaté lors d'un inventaire physique.
  COUNT_CORRECTION
}

/// Un mouvement de stock, tel qu'il s'est produit.
///
/// **Le manque qu'il comble.** Le stock se modifiait par `UPDATE quantity`
/// depuis six endroits du code, sans laisser la moindre trace. Un vendeur qui
/// constatait un écart n'avait aucun moyen de savoir d'où il venait, et
/// l'équipe non plus : le commentaire de `reservation-counter.ts` dit noir sur
/// blanc qu'on ignore lequel des trois chemins de libération décrémente deux
/// fois — un contrôle d'intégrité avait trouvé 101 lignes à `reserved = -1`
/// sans pouvoir désigner le coupable. Cette table est la réponse à cette
/// question, et à toutes celles de la même famille.
///
/// **`quantityAfter` est le champ qui compte.** Il fige l'état **après**
/// application. Il permet deux choses qu'un simple delta ne permet pas :
/// rejouer l'histoire d'un article, et détecter une dérive — si le dernier
/// mouvement dit 9 et que la table d'inventaire dit 11, deux unités sont
/// apparues sans passer par ici.
model ToumaStockMovement {
  id        String               @id @default(cuid())
  productId String
  product   ToumaProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ToumaProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  type StockMovementType

  /// Variation de la quantité vendable. Signée : négative pour une sortie.
  /// Peut valoir 0 quand seule la réservation bouge.
  quantityDelta Int
  /// Variation du compteur de réservation. Signée elle aussi.
  reservedDelta Int @default(0)
  /// État après application. Le cœur du dispositif — voir l'en-tête du modèle.
  quantityAfter Int
  reservedAfter Int @default(0)

  /// Ce qui a causé le mouvement, en clair. Jamais « mise à jour ».
  reason String?

  /// L'objet à l'origine : commande, retour, import, réception fournisseur.
  /// Deux colonnes plutôt qu'une relation : les origines sont hétérogènes, et
  /// une clé étrangère par type ferait une table pleine de colonnes nulles.
  referenceType String?
  referenceId   String?

  /// Qui. Nul pour un mouvement déclenché par une tâche planifiée.
  actorId   String?
  actor     User?   @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Identifiant de requête (V25) : relie ce mouvement aux journaux d'accès.
  requestId String?

  createdAt DateTime @default(now())

  @@index([productId, variantId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@map("touma_stock_movements")
}

// Schéma de base de données — Toumai
// Plateforme d'automatisation e-commerce / dropshipping.
// Base : PostgreSQL (production, ex. Render). DATABASE_URL fournit la connexion.
//
// Les 4 piliers du logiciel :
//   1. Analyse marché  -> MarketOpportunity
//   2. Génération      -> Product / GenerationRun
//   3. Achat & envoi   -> Customer / Order / OrderItem / PurchaseOrder
//   4. Sourcing        -> Supplier / Offer / SearchRequest / SupplierMatch

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Réglage de l'application (clé/valeur).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Boutique concurrente suivie (veille marché).
model Competitor {
  id         String    @id @default(cuid())
  /// ebay | etsy | amazon
  platform   String    @default("ebay")
  shopName   String
  shopUrl    String?
  /// Suivie automatiquement pour les nouveaux produits.
  followed   Boolean   @default(false)
  status     String    @default("ACTIVE")
  lastScanAt DateTime?

  products CompetitorProduct[]

  createdAt DateTime @default(now())

  @@index([platform])
}

/// Produit gagnant détecté chez un concurrent.
model CompetitorProduct {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  externalId   String?
  title        String
  category     String     @default("divers")
  price        Float?
  currency     String     @default("EUR")
  soldCount    Int        @default(0)
  imageUrl     String?
  url          String?
  favorited    Boolean    @default(false)

  foundAt DateTime @default(now())

  @@unique([competitorId, externalId])
  @@index([competitorId])
  @@index([soldCount])
}

/// Produit mis en favori (issu d'une recherche ou d'un concurrent) à sourcer/publier.
model Favorite {
  id        String  @id @default(cuid())
  /// competitor | search-text | search-photo | search-barcode | manual
  source    String  @default("manual")
  title     String
  category  String  @default("divers")
  keywords  String  @default("")
  price     Float?
  currency  String  @default("EUR")
  imageUrl  String?
  url       String?
  /// Renseigné une fois le favori transformé en produit du catalogue.
  productId String?

  createdAt DateTime @default(now())
}

/// Publicité générée pour un produit.
model Ad {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// meta | google | ebay | tiktok
  platform  String  @default("meta")
  headline  String
  body      String
  budget    Float   @default(0)
  /// DRAFT | ACTIVE | PAUSED
  status    String  @default("DRAFT")

  createdAt DateTime @default(now())

  @@index([productId])
}

/// Demande de retrait des bénéfices (payout).
model Withdrawal {
  id          String  @id @default(cuid())
  amount      Float
  currency    String  @default("EUR")
  /// bank | paypal | card | stripe
  method      String
  /// Destination masquée (IBAN partiel / email PayPal / carte / compte Stripe).
  destination String
  /// PENDING | APPROVED | PAID | REJECTED
  status      String  @default("PENDING")
  note        String?

  /// manual (traité à la main) | stripe (virement automatique Stripe Payouts).
  provider   String  @default("manual")
  /// Identifiant du transfert/versement chez le prestataire (ex. Stripe tr_...).
  externalId String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
}

/// Canal de vente connecté (Etsy, eBay, Amazon...).
model SalesChannel {
  id         String    @id @default(cuid())
  /// etsy | ebay | amazon
  type       String
  name       String
  /// CONNECTED | DISCONNECTED | ERROR
  status     String    @default("DISCONNECTED")
  /// Identifiants / jetons OAuth (JSON sérialisé). Jamais renvoyé tel quel par l'API.
  config     String    @default("{}")
  error      String?
  lastSyncAt DateTime?

  listings ChannelListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
}

/// Annonce d'un produit publiée sur un canal de vente.
model ChannelListing {
  id         String       @id @default(cuid())
  channelId  String
  channel    SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Identifiant de l'annonce côté marketplace.
  externalId String?
  /// PUBLISHED | DRAFT | ERROR | UNPUBLISHED
  status     String       @default("DRAFT")
  url        String?
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channelId, productId])
  @@index([channelId])
}

/// Utilisateur de l'application (authentification).
model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  /// admin | user
  role         String @default("user")

  /// Double authentification (TOTP — application d'authentification).
  totpSecret    String? // chiffré ; secret partagé de l'application d'authentification
  totpEnabled   Boolean @default(false)
  /// Codes de récupération (JSON de hachages, chiffré). Usage unique.
  recoveryCodes String?

  /// Version des jetons : incrémentée pour révoquer toutes les sessions.
  tokenVersion Int @default(0)

  // ── Place de marché Touma ────────────────────────────────────────────────
  /// Rôle sur la place de marché (indépendant du rôle historique du logiciel
  /// d'automatisation ci-dessus, conservé pour ne rien casser).
  toumaRole ToumaRole  @default(BUYER)
  status    UserStatus @default(ACTIVE)

  /// Permissions d'administration effectivement accordées (V25 §25).
  ///
  /// N'a de sens que pour un compte `ADMIN`. Vide sur tous les autres.
  adminPermissions String[] @default([])

  /// Ce compte a-t-il été **cadré** ?
  ///
  /// Deux champs pour une notion, et c'est voulu. Un tableau vide est
  /// ambigu : « aucun droit » ou « droits jamais définis » ? Les confondre
  /// mène à l'un des deux accidents — soit tous les administrateurs existants
  /// perdent l'accès au déploiement, soit un nouvel administrateur sans
  /// permission les obtient toutes en silence.
  ///
  /// `false` : compte antérieur au cadrage, accès complet, signalé comme tel.
  /// `true`  : seules les permissions listées s'appliquent.
  ///
  /// Accorder une permission bascule ce drapeau : un compte cadré ne
  /// redevient jamais non cadré.
  adminScoped Boolean @default(false)

  phone       String?  @unique
  /// Pays de résidence (ISO-3166-1 alpha-2) — voir Country.
  countryCode String?
  country     Country? @relation(fields: [countryCode], references: [code], onDelete: SetNull)
  locale      String   @default("fr")

  credentials WebAuthnCredential[]
  loginEvents LoginEvent[]

  refreshTokens         ToumaRefreshToken[]
  addresses             ToumaAddress[]
  stores                ToumaStore[]
  carts                 ToumaCart[]
  toumaOrders           ToumaOrder[]
  reviews               ToumaReview[]
  favorites             ToumaFavorite[]
  notifications         ToumaNotification[]
  disputes              ToumaDispute[]
  disputeMessages       ToumaDisputeMessage[]
  riskScore             ToumaRiskScore?
  fraudEvents           ToumaFraudEvent[]
  aiRequests            ToumaAiRequest[]
  aiConversations       ToumaAiConversation[]
  aiToolCalls           ToumaAiToolCall[]
  aiUsage               ToumaAiUsage[]
  aiFeedback            ToumaAiFeedback[]
  aiMemories            ToumaAiMemory[]
  aiConfirmations       ToumaAiActionConfirmation[]
  auditLogs             ToumaAuditLog[]
  reviewedVerifications ToumaSellerVerification[]   @relation("VerificationReviewer")
  commissionRules       ToumaCommissionRule[]       @relation("ToumaCommissionRuleAuthor")

  orderGroups         ToumaOrderGroup[]
  evidenceUploaded    ToumaDisputeEvidence[]         @relation("EvidenceAuthor")
  disputesAssigned    ToumaDispute[]                 @relation("DisputeAssignee")
  businessProfile     ToumaBusinessProfile?
  rfqs                ToumaRfq[]
  quotes              ToumaQuote[]                   @relation("QuoteSeller")
  negotiationMessages ToumaNegotiationMessage[]
  conversations       ToumaConversationParticipant[]
  messages            ToumaMessage[]
  conversationsOpened ToumaConversation[]            @relation("ConversationCreator")
  messageReports      ToumaMessageReport[]
  blocksMade          ToumaUserBlock[]               @relation("BlockAuthor")
  blocksReceived      ToumaUserBlock[]               @relation("BlockTarget")
  savedReplies        ToumaSavedReply[]
  notificationPrefs   ToumaNotificationPreference[]

  returnRequests    ToumaReturnRequest[]
  refundsInitiated  ToumaRefund[]           @relation("RefundInitiator")
  supportTickets    ToumaSupportTicket[]    @relation("TicketRequester")
  assignedTickets   ToumaSupportTicket[]    @relation("TicketAssignee")
  supportMessages   ToumaSupportMessage[]
  coupons           ToumaCoupon[]           @relation("CouponAuthor")
  couponRedemptions ToumaCouponRedemption[]
  loyaltyAccount    ToumaLoyaltyAccount?
  documents         ToumaDocument[]
  rfqInvitations    ToumaRfqInvitation[]    @relation("InvitationAuthor")

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  /// Encaissements à la livraison constatés par cette personne.
  cashCollections ToumaCashCollection[] @relation("CashCollector")

  /// Colis remis par cette personne en point relais.
  pickupReleases ToumaOrder[] @relation("PickupRelease")

  /// Clés d'idempotence des opérations financières de ce compte.
  idempotencyKeys ToumaIdempotencyKey[]

  /// Versements décidés par cette personne.
  payoutDecisions ToumaSellerPayout[] @relation("PayoutDecider")

  // V21 — confiance
  accountStanding   ToumaAccountStanding?
  standingDecisions ToumaAccountStanding[] @relation("StandingActor")
  trustAppeals      ToumaTrustAppeal[]     @relation("AppealAuthor")
  appealsReviewed   ToumaTrustAppeal[]     @relation("AppealReviewer")
  supplierScore     ToumaSupplierScore?    @relation("SupplierScore")

  // V22 — croissance
  promotionsCreated      ToumaPromotion[]              @relation("PromotionAuthor")
  campaignsCreated       ToumaCampaign[]               @relation("CampaignAuthor")
  promotionUsages        ToumaPromotionUsage[]
  referralCode           ToumaReferralCode?            @relation("ReferralOwner")
  referralsMade          ToumaReferral[]               @relation("Referrer")
  referralReceived       ToumaReferral?                @relation("Referee")
  segmentMemberships     ToumaCustomerSegmentMember[]
  flashSalesCreated      ToumaFlashSale[]              @relation("FlashSaleAuthor")
  flashSaleClaims        ToumaFlashSaleClaim[]
  /// Vérifications d'éligibilité transfrontalière demandées par ce compte.
  tradeEligibilityChecks ToumaTradeEligibilityCheck[]
  /// Demandes de suppression de compte (V25 §68).
  deletionRequests       ToumaAccountDeletionRequest[]
  /// Drapeaux de fonctionnalité modifiés par ce compte (V25 §28).
  featureFlagChanges     ToumaFeatureFlag[]

  /// Incidents d'exploitation (V25 §48).
  incidentsOwned       ToumaIncident[]            @relation("IncidentOwner")
  incidentsOpened      ToumaIncident[]            @relation("IncidentOpener")
  incidentEvents       ToumaIncidentEvent[]
  countryStatusChanges ToumaCountryStatusChange[] @relation("CountryStatusChangedBy")
  stockMovements       ToumaStockMovement[]       @relation("StockMovementActor")
}

/// Événement de connexion (journal de sécurité).
model LoginEvent {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// password | totp | recovery | webauthn
  method    String
  success   Boolean @default(true)
  ip        String?
  userAgent String?
  /// Première connexion depuis cet appareil (empreinte IP+navigateur).
  newDevice Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Clé de sécurité / passkey (WebAuthn) d'un utilisateur.
model WebAuthnCredential {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identifiant de la clé (base64url), unique.
  credentialId String @unique
  publicKey    String // clé publique (base64url)
  counter      Int    @default(0)
  transports   String @default("")
  name         String @default("Clé de sécurité")

  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. ANALYSE MARCHÉ
// ─────────────────────────────────────────────────────────────────────────────

/// Opportunité produit détectée par l'analyse de marché (produit gagnant potentiel).
model MarketOpportunity {
  id         String  @id @default(cuid())
  source     String // connecteur d'origine (trends, marketplace...)
  externalId String // identifiant stable côté source (déduplication)
  title      String
  category   String
  keywords   String  @default("")
  niche      String?
  region     String?
  currency   String  @default("EUR")

  /// Scores 0..100 issus de l'analyse.
  demandScore      Float @default(0)
  competitionScore Float @default(0)
  trendScore       Float @default(0)
  /// Score global de recommandation (0..100).
  opportunityScore Float @default(0)

  estimatedCostPrice Float?
  estimatedSalePrice Float?
  estimatedMargin    Float?

  /// NEW | EVALUATED | IMPORTED | REJECTED
  status     String @default("NEW")
  /// Métriques brutes de la source (JSON sérialisé).
  rawMetrics String @default("{}")

  products Product[]

  discoveredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status])
  @@index([opportunityScore])
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. CATALOGUE / GÉNÉRATION
// ─────────────────────────────────────────────────────────────────────────────

/// Produit du catalogue (créé manuellement ou généré en masse depuis une opportunité).
model Product {
  id          String  @id @default(cuid())
  sku         String? @unique
  name        String
  description String?
  category    String
  keywords    String  @default("")
  currency    String  @default("EUR")

  /// Économie du produit (dropshipping).
  costPrice Float? // prix d'achat fournisseur
  salePrice Float? // prix de vente client
  margin    Float? // marge = salePrice - costPrice

  /// DRAFT | ACTIVE | ARCHIVED
  status String @default("DRAFT")
  /// Origine : manual | generated | import
  source String @default("manual")
  images String @default("") // URLs séparées par des virgules

  // Critères de sourcing (pilier 4)
  targetUnitPrice        Float?
  targetQuantity         Int?
  region                 String?
  requiredCertifications String  @default("")

  opportunityId String?
  opportunity   MarketOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  searchRequests SearchRequest[]
  orderItems     OrderItem[]
  listings       ChannelListing[]
  ads            Ad[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  generatedAt DateTime?

  @@index([category])
  @@index([status])
}

/// Lot de génération de produits (traçabilité de la fonctionnalité "centaines/jour").
model GenerationRun {
  id        String  @id @default(cuid())
  source    String  @default("opportunities")
  requested Int     @default(0)
  generated Int     @default(0)
  skipped   Int     @default(0)
  failed    Int     @default(0)
  /// RUNNING | COMPLETED | FAILED
  status    String  @default("RUNNING")
  params    String  @default("{}")
  error     String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. COMMANDES / ACHAT & EXPÉDITION
// ─────────────────────────────────────────────────────────────────────────────

/// Client final.
model Customer {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  address String?
  city    String?
  country String?
  zip     String?

  orders          Order[]
  supportMessages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Commande client.
model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// PENDING | PAID | FULFILLING | SHIPPED | DELIVERED | CANCELLED
  status   String @default("PENDING")
  currency String @default("EUR")
  total    Float  @default(0)

  /// Origine de la commande : manual | etsy | ebay | amazon
  channel    String  @default("manual")
  /// Identifiant de la commande côté marketplace (déduplication à l'import).
  externalId String?

  /// En attente de vérification manuelle (ex. adresse à confirmer avant l'envoi
  /// au fournisseur). Les commandes « en attente » sont ignorées par le pilote
  /// automatique tant qu'elles ne sont pas confirmées.
  onHold Boolean @default(false)

  items          OrderItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, externalId])
  @@index([status])
}

/// Message d'une conversation de service client (sauvegardée).
/// customerId nul = conversation générale avec l'assistant (chat direct).
/// role : 'user' (message reçu / saisi par le vendeur) | 'assistant' (agent IA).
model SupportMessage {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  role       String
  content    String
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// Ligne de commande.
model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int     @default(1)
  unitSalePrice Float
  unitCostPrice Float?

  @@index([orderId])
}

/// Bon d'achat passé automatiquement chez un fournisseur pour honorer une commande.
model PurchaseOrder {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  offerId    String?
  offer      Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)

  /// CREATED | PLACED | SHIPPED | DELIVERED | FAILED
  status         String  @default("CREATED")
  cost           Float   @default(0)
  currency       String  @default("EUR")
  trackingNumber String?
  carrier        String?
  error          String?

  createdAt DateTime  @default(now())
  placedAt  DateTime?
  shippedAt DateTime?

  @@index([orderId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. SOURCING / FOURNISSEURS
// ─────────────────────────────────────────────────────────────────────────────

/// Fournisseur référencé dans la base.
model Supplier {
  id             String  @id @default(cuid())
  name           String
  country        String?
  region         String?
  website        String?
  email          String?
  phone          String?
  rating         Float   @default(0)
  verified       Boolean @default(false)
  certifications String  @default("")
  leadTimeDays   Int?
  minOrderValue  Float?
  currency       String  @default("EUR")
  source         String  @default("manual")

  offers         Offer[]
  matches        SupplierMatch[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
  @@index([rating])
}

/// Offre (produit proposé) d'un fournisseur. Alimentée par les connecteurs.
model Offer {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  title        String
  category     String
  keywords     String   @default("")
  unitPrice    Float?
  currency     String   @default("EUR")
  moq          Int?
  leadTimeDays Int?
  inStock      Boolean  @default(true)

  matches        SupplierMatch[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([category])
}

/// Demande de recherche de fournisseurs (synchrone ou asynchrone).
model SearchRequest {
  id                     String   @id @default(cuid())
  productId              String?
  product                Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  query                  String   @default("")
  category               String?
  keywords               String   @default("")
  targetUnitPrice        Float?
  targetQuantity         Int?
  region                 String?
  requiredCertifications String   @default("")
  /// PENDING | RUNNING | COMPLETED | FAILED
  status                 String   @default("PENDING")
  error                  String?

  matches SupplierMatch[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
}

/// Résultat de matching : un fournisseur candidat classé pour une recherche.
model SupplierMatch {
  id              String        @id @default(cuid())
  searchRequestId String
  searchRequest   SearchRequest @relation(fields: [searchRequestId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  offerId         String?
  offer           Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  score           Float
  rank            Int
  breakdown       String        @default("{}")

  createdAt DateTime @default(now())

  @@index([searchRequestId])
  @@index([score])
}

// ═════════════════════════════════════════════════════════════════════════════
// TOUMA — PLACE DE MARCHÉ AFRICAINE (marketplace B2B / B2C)
//
// Domaine ajouté au logiciel existant, isolé par le préfixe `Touma` (modèles)
// et `touma_` (tables) afin de ne rien casser du produit d'automatisation.
// Corridor pilote : Tchad (TD) ↔ Cameroun (CM). Aucun pays n'est codé en dur :
// tout passe par la table `Country`.
//
// Règle absolue : tout montant financier est un `Decimal`, jamais un `Float`.
// ═════════════════════════════════════════════════════════════════════════════

enum ToumaRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

/// États d'un dossier de vérification.
///
/// V21 demandait le vocabulaire NOT_STARTED / SUBMITTED / VERIFIED. Les quatre
/// premières valeurs existaient déjà et sont câblées dans les commandes, les
/// vues, les seeds et les tests : `APPROVED` **est** « vérifié ». Les renommer
/// aurait touché une centaine d'appels pour un synonyme. Les trois états qui
/// manquaient vraiment — une revue en cours, une vérification retirée, une
/// vérification périmée — sont ajoutés.
enum VerificationStatus {
  /// Aucun dossier déposé (équivaut à NOT_STARTED).
  UNVERIFIED
  /// Dossier déposé, pas encore pris en main (équivaut à SUBMITTED).
  PENDING
  /// Un examinateur l'a pris en main.
  UNDER_REVIEW
  /// Vérifié (équivaut à VERIFIED).
  APPROVED
  REJECTED
  /// Vérification retirée à la suite d'une décision de confiance.
  SUSPENDED
  /// Vérification arrivée à échéance : les pièces doivent être refournies.
  EXPIRED
}

/// Niveau de vérification atteint. Chaque niveau exige les signaux du
/// précédent plus les siens — voir `trust/verification-levels.ts`.
enum VerificationLevel {
  NONE
  BASIC
  BUSINESS
  PRO
  ENTERPRISE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SUSPENDED
}

enum ToumaOrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  /// Colis prêt, transporteur pas encore passé. Sans cet état, un vendeur doit
  /// choisir entre mentir (« expédié ») et laisser croire que rien n'avance.
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

/// États d'un encaissement à la livraison.
///
/// Les noms viennent du cahier des charges (§28) et sont portés **par
/// l'encaissement**, non par la commande. Ajouter trois statuts à
/// `ToumaOrderStatus` aurait traversé la machine d'état, le calcul du statut de
/// groupe, la réputation et chaque liste de « statuts payés » — pour dire une
/// chose qui ne concerne que l'argent. La commande, elle, suit son cours
/// normal : ce qui ne doit pas arriver, c'est qu'elle soit dite « payée ».
/// État d'une zone de livraison.
enum DeliveryZoneStatus {
  /// Desservie : le transporteur y va, au tarif et au délai configurés.
  SERVED
  /// Desservie sur demande : il faut convenir du passage. Un délai est rendu,
  /// mais l'interface doit dire que ce n'est pas une tournée régulière.
  ON_REQUEST
  /// Non desservie. Le dire est plus utile que d'afficher un délai inventé.
  UNSERVED
}

/// Zone de livraison d'un transporteur (§15).
///
/// **Le défaut corrigé.** L'unique transporteur branché facturait et datait
/// toutes les livraisons nationales à l'identique : 1 500 de prise en charge,
/// 1 200 par kilogramme, 1 à 3 jours. Autrement dit, N'Djamena → N'Djamena et
/// N'Djamena → Faya-Largeau — un millier de kilomètres de piste saharienne —
/// recevaient le **même prix et le même délai**. Le fichier était honnêtement
/// nommé « mock », mais c'était le seul, donc l'acheteur voyait toujours une
/// estimation, et cette estimation n'avait aucun fondement.
///
/// Une zone est une déclaration d'exploitant : « ce transporteur dessert cette
/// province, à ce prix, en tant de jours ». Rien n'est deviné. Quand aucune zone
/// ne couvre une destination, le système **ne sait pas** — et le dit.
model ToumaDeliveryZone {
  id           String           @id @default(cuid())
  /// Code du transporteur concerné.
  providerCode String
  countryCode  String
  /// Portée : de la plus large (pays seul) à la plus fine (localité). La plus
  /// précise l'emporte.
  provinceId   String?
  province     ToumaProvince?   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  departmentId String?
  department   ToumaDepartment? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  localityId   String?
  locality     ToumaLocality?   @relation(fields: [localityId], references: [id], onDelete: Cascade)

  status DeliveryZoneStatus @default(SERVED)

  /// Délais annoncés par l'exploitant, en jours.
  estimatedMinDays Int
  estimatedMaxDays Int

  /// Prise en charge, et supplément par kilogramme entamé. Les deux sont
  /// configurés : aucun tarif n'est calculé par le code.
  basePrice  Decimal  @db.Decimal(18, 4)
  pricePerKg Decimal? @db.Decimal(18, 4)
  currency   String

  /// Nom du service tel qu'il doit apparaître à l'acheteur.
  serviceName String  @default("Standard")
  active      Boolean @default(true)
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerCode, countryCode])
  @@index([provinceId])
  @@index([localityId])
  @@map("touma_delivery_zones")
}

/// État d'une clé d'idempotence.
/// Part de règlement d'un vendeur dans un paiement (§9).
///
/// **Pourquoi ce modèle existe.** Le panier multi-vendeurs est payé une fois et
/// donne une commande par boutique, chacune avec sa commission. Mais il
/// n'existait **aucun objet** qui dise, pour un paiement donné : quelle part
/// revient à quelle boutique, quelle commission, quel transport, quel
/// remboursement, quel net. La réponse se reconstituait en croisant trois
/// tables — ce qui suffit pour afficher, pas pour régler, et surtout pas pour
/// expliquer un écart à un vendeur qui conteste.
///
/// **Ce n'est pas un portefeuille.** Aucune somme n'est détenue pour le compte
/// d'un vendeur : cette table dit ce qui lui est **dû**, pas ce qu'il possède
/// chez TOUMA. Voir `docs/payments/compliance-boundaries.md`.
model ToumaSettlementAllocation {
  id        String       @id @default(cuid())
  paymentId String
  payment   ToumaPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// Sous-commande d'une boutique : c'est l'unité de règlement.
  orderId   String       @unique
  order     ToumaOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId   String
  store     ToumaStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Montants figés au moment de l'encaissement, sauf le remboursement qui suit
  /// la vie de la commande.
  grossAmount      Decimal @db.Decimal(18, 4)
  commissionAmount Decimal @db.Decimal(18, 4)
  shippingAmount   Decimal @db.Decimal(18, 4)
  refundedAmount   Decimal @default(0) @db.Decimal(18, 4)
  currency         String

  status     SettlementStatus @default(PENDING)
  /// Date à partir de laquelle la part devient réglable, si rien ne s'y oppose.
  eligibleAt DateTime?

  payoutId String?
  payout   ToumaSellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, status])
  @@index([paymentId])
  @@index([payoutId])
  @@map("touma_settlement_allocations")
}

enum IdempotencyStatus {
  /// Une requête portant cette clé est en cours. Une seconde ne passe pas.
  IN_PROGRESS
  /// La requête a abouti : la réponse d'origine est rejouée telle quelle.
  COMPLETED
  /// La requête a échoué : la clé est libérée, on peut réessayer.
  FAILED
}

/// Clé d'idempotence d'une opération financière (§5).
///
/// **Pourquoi elle existe.** Au Tchad, un réseau qui coupe entre l'envoi et la
/// réponse est la situation normale, pas l'exception : l'acheteur renvoie, le
/// navigateur rejoue, l'application réessaie. Sans clé, la seconde requête est
/// une opération de plus — un second remboursement, un second versement.
///
/// Ce que cette table garantit, et qui va plus loin qu'un simple verrou : la
/// requête rejouée reçoit **la réponse d'origine**, pas une erreur. Un client
/// qui redemande poliment la même chose doit obtenir la même réponse, sans quoi
/// il redemande encore.
///
/// L'empreinte du corps est conservée : réutiliser une clé pour une **autre**
/// requête est une erreur du client, et elle est signalée plutôt que servie.
model ToumaIdempotencyKey {
  id        String @id @default(cuid())
  /// Clé fournie par le client (en-tête `Idempotency-Key`).
  key       String
  /// Portée au demandeur : deux clients peuvent employer la même clé.
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Opération concernée : une même clé ne vaut pas d'une route à l'autre.
  operation String

  /// Empreinte du corps de la requête (SHA-256).
  requestHash String
  status      IdempotencyStatus @default(IN_PROGRESS)

  /// Réponse d'origine, rejouée à l'identique. Ne contient jamais de secret :
  /// c'est le corps que l'API a réellement rendu au client.
  responseStatus Int?
  responseBody   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Au-delà, la clé n'a plus de sens : la conserver indéfiniment ferait de
  /// cette table un journal, ce qu'elle n'est pas.
  expiresAt DateTime

  @@unique([userId, operation, key])
  @@index([expiresAt])
  @@map("touma_idempotency_keys")
}

enum CashCollectionStatus {
  /// Commande acceptée, argent pas encore collecté.
  COD_PENDING
  /// Le vendeur ou le transporteur confirme qu'il collectera.
  COD_CONFIRMED
  /// L'argent est réellement entre les mains du vendeur. C'est **seulement
  /// ici** que le paiement devient un paiement.
  COD_COLLECTED
  /// Refus au seuil de la porte, destinataire introuvable, colis retourné.
  COD_FAILED
}

/// Encaissement à la livraison.
///
/// **Le défaut corrigé.** `CASH_ON_DELIVERY` était proposé comme n'importe
/// quelle autre méthode, et l'adaptateur de démonstration le confirmait
/// `SUCCEEDED`. Conséquence, dans l'ordre : la commande passait à « payée », la
/// facture et le reçu étaient émis, le vendeur recevait « commande payée :
/// préparez l'expédition », et la vente entrait au registre comptable — **avant
/// qu'un seul franc ait été collecté**. Au Tchad, où le paiement à la livraison
/// est courant, cela revenait à mentir sur l'argent à grande échelle.
model ToumaCashCollection {
  id        String       @id @default(cuid())
  paymentId String       @unique
  payment   ToumaPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  status          CashCollectionStatus @default(COD_PENDING)
  /// Montant à collecter, figé à la création. Le suivre est l'exigence même du
  /// §28 : sans lui, personne ne sait combien le livreur doit rapporter.
  amountDue       Decimal              @db.Decimal(18, 4)
  /// Montant réellement collecté. Nul tant que rien n'a été remis.
  amountCollected Decimal?             @db.Decimal(18, 4)
  currency        String

  /// Qui a constaté l'encaissement. Un mouvement d'argent sans auteur n'est pas
  /// vérifiable.
  collectedById String?
  collectedBy   User?     @relation("CashCollector", fields: [collectedById], references: [id], onDelete: SetNull)
  collectedAt   DateTime?
  /// Motif d'un échec (refus, destinataire absent…).
  failureReason String?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("touma_cash_collections")
}

/// Règle d'ouverture du paiement à la livraison (§26).
///
/// Le paiement à la livraison ne s'active pas d'un bloc : il dépend de qui
/// livre, où, et de combien d'argent un livreur peut raisonnablement porter.
/// Une règle sans province s'applique à tout le pays ; une règle sans boutique
/// s'applique à toutes. La règle la plus précise l'emporte.
model ToumaCodRule {
  id          String         @id @default(cuid())
  countryCode String
  provinceId  String?
  province    ToumaProvince? @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  storeId     String?
  store       ToumaStore?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ToumaCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Plafond au-delà duquel le paiement à la livraison n'est pas proposé. Nul
  /// veut dire « sans plafond », ce qui doit rester un choix explicite.
  maxAmount Decimal? @db.Decimal(18, 4)
  /// Une règle peut aussi **interdire** : c'est ainsi qu'on ferme une province
  /// sans toucher au reste.
  allowed   Boolean  @default(true)
  active    Boolean  @default(true)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([provinceId])
  @@index([storeId])
  @@map("touma_cod_rules")
}

/// Zone de service déclarée par un **vendeur** : où sa boutique livre.
///
/// À ne pas confondre avec `ToumaDeliveryZone`, qui dit où un **transporteur**
/// va. Les deux se combinent : une commande n'est livrable que si le vendeur
/// accepte de servir la destination *et* qu'un transporteur la dessert.
///
/// **Sans déclaration, un vendeur ne restreint rien.** C'est l'inverse du
/// paiement à la livraison, fermé par défaut, et la différence est réelle :
/// encaisser du liquide est un engagement qu'on prend explicitement, alors que
/// refuser de livrer une province est une limitation qu'on choisit. Fermer par
/// défaut couperait du jour au lendemain toutes les boutiques existantes.
model ToumaStoreServiceZone {
  id      String     @id @default(cuid())
  storeId String
  store   ToumaStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Portée, de la plus large à la plus fine. Province et département nuls = le
  /// pays entier.
  countryCode  String
  provinceId   String?
  province     ToumaProvince?   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  departmentId String?
  department   ToumaDepartment? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// Une règle peut **exclure** : c'est ainsi qu'on sert tout un pays sauf une
  /// province, sans énumérer les vingt-deux autres.
  served Boolean @default(true)

  /// Délai propre au vendeur — préparation, pas transport. Nul = non annoncé,
  /// et rien n'est alors affiché : un délai deviné est une promesse inventée.
  handlingDays Int?

  /// Motif visible de l'acheteur quand la zone est exclue. Un refus sans raison
  /// est incompréhensible pour qui voulait acheter.
  note String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, active])
  @@index([provinceId])
  @@map("touma_store_service_zones")
}

/// Règle de commission. Le taux cessait d'être une variable d'environnement
/// unique le jour où une catégorie, un pays ou un vendeur négocié devait
/// différer — c'est-à-dire tout de suite.
///
/// Portée croissante : globale, pays, catégorie, boutique. La plus précise
/// l'emporte ; à précision égale, la plus récemment entrée en vigueur.
///
/// Une règle n'est **jamais modifiée ni supprimée** une fois qu'elle a servi :
/// on la clôt en posant `effectiveUntil` et on en ouvre une autre. Une commande
/// passée doit rester explicable par la règle qui l'a produite.
model ToumaCommissionRule {
  id String @id @default(cuid())

  /// Nul à chaque niveau = « toutes ». Les quatre nuls = la règle globale.
  countryCode String?
  categoryId  String?
  category    ToumaCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  storeId     String?
  store       ToumaStore?    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Taux appliqué au sous-total encaissé par le vendeur (0.05 = 5 %).
  /// `Decimal`, pas un flottant : un taux multiplie de l'argent.
  rate Decimal @db.Decimal(9, 6)

  /// Plancher et plafond **du montant de commission**, en `feeCurrency`.
  /// Une borne sans devise n'a pas de sens ; une borne dans une autre devise
  /// que la commande rendrait la règle inapplicable plutôt qu'approximative.
  minFee      Decimal? @db.Decimal(18, 4)
  maxFee      Decimal? @db.Decimal(18, 4)
  feeCurrency String?

  /// Période de validité. `effectiveUntil` nul = toujours en vigueur.
  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime?

  active Boolean @default(true)
  note   String?

  /// Qui l'a posée. Un taux qui change sans auteur est ingérable.
  createdById String?
  createdBy   User?   @relation("ToumaCommissionRuleAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode, effectiveFrom])
  @@index([categoryId])
  @@index([storeId])
  @@index([active, effectiveFrom])
  @@map("touma_commission_rules")
}


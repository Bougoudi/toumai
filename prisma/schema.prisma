// Schéma de base de données — Toumai
// Plateforme d'automatisation e-commerce / dropshipping.
// Base : PostgreSQL (production, ex. Render). DATABASE_URL fournit la connexion.
//
// Les 4 piliers du logiciel :
//   1. Analyse marché  -> MarketOpportunity
//   2. Génération      -> Product / GenerationRun
//   3. Achat & envoi   -> Customer / Order / OrderItem / PurchaseOrder
//   4. Sourcing        -> Supplier / Offer / SearchRequest / SupplierMatch

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Réglage de l'application (clé/valeur).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Boutique concurrente suivie (veille marché).
model Competitor {
  id         String    @id @default(cuid())
  /// ebay | etsy | amazon
  platform   String    @default("ebay")
  shopName   String
  shopUrl    String?
  /// Suivie automatiquement pour les nouveaux produits.
  followed   Boolean   @default(false)
  status     String    @default("ACTIVE")
  lastScanAt DateTime?

  products CompetitorProduct[]

  createdAt DateTime @default(now())

  @@index([platform])
}

/// Produit gagnant détecté chez un concurrent.
model CompetitorProduct {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  externalId   String?
  title        String
  category     String     @default("divers")
  price        Float?
  currency     String     @default("EUR")
  soldCount    Int        @default(0)
  imageUrl     String?
  url          String?
  favorited    Boolean    @default(false)

  foundAt DateTime @default(now())

  @@unique([competitorId, externalId])
  @@index([competitorId])
  @@index([soldCount])
}

/// Produit mis en favori (issu d'une recherche ou d'un concurrent) à sourcer/publier.
model Favorite {
  id        String  @id @default(cuid())
  /// competitor | search-text | search-photo | search-barcode | manual
  source    String  @default("manual")
  title     String
  category  String  @default("divers")
  keywords  String  @default("")
  price     Float?
  currency  String  @default("EUR")
  imageUrl  String?
  url       String?
  /// Renseigné une fois le favori transformé en produit du catalogue.
  productId String?

  createdAt DateTime @default(now())
}

/// Publicité générée pour un produit.
model Ad {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// meta | google | ebay | tiktok
  platform  String  @default("meta")
  headline  String
  body      String
  budget    Float   @default(0)
  /// DRAFT | ACTIVE | PAUSED
  status    String  @default("DRAFT")

  createdAt DateTime @default(now())

  @@index([productId])
}

/// Demande de retrait des bénéfices (payout).
model Withdrawal {
  id          String  @id @default(cuid())
  amount      Float
  currency    String  @default("EUR")
  /// bank | paypal | card | stripe
  method      String
  /// Destination masquée (IBAN partiel / email PayPal / carte / compte Stripe).
  destination String
  /// PENDING | APPROVED | PAID | REJECTED
  status      String  @default("PENDING")
  note        String?

  /// manual (traité à la main) | stripe (virement automatique Stripe Payouts).
  provider   String  @default("manual")
  /// Identifiant du transfert/versement chez le prestataire (ex. Stripe tr_...).
  externalId String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
}

/// Canal de vente connecté (Etsy, eBay, Amazon...).
model SalesChannel {
  id         String    @id @default(cuid())
  /// etsy | ebay | amazon
  type       String
  name       String
  /// CONNECTED | DISCONNECTED | ERROR
  status     String    @default("DISCONNECTED")
  /// Identifiants / jetons OAuth (JSON sérialisé). Jamais renvoyé tel quel par l'API.
  config     String    @default("{}")
  error      String?
  lastSyncAt DateTime?

  listings ChannelListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
}

/// Annonce d'un produit publiée sur un canal de vente.
model ChannelListing {
  id         String       @id @default(cuid())
  channelId  String
  channel    SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Identifiant de l'annonce côté marketplace.
  externalId String?
  /// PUBLISHED | DRAFT | ERROR | UNPUBLISHED
  status     String       @default("DRAFT")
  url        String?
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channelId, productId])
  @@index([channelId])
}

/// Utilisateur de l'application (authentification).
model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  /// admin | user
  role         String @default("user")

  /// Double authentification (TOTP — application d'authentification).
  totpSecret    String? // chiffré ; secret partagé de l'application d'authentification
  totpEnabled   Boolean @default(false)
  /// Codes de récupération (JSON de hachages, chiffré). Usage unique.
  recoveryCodes String?

  /// Version des jetons : incrémentée pour révoquer toutes les sessions.
  tokenVersion Int @default(0)

  // ── Place de marché Touma ────────────────────────────────────────────────
  /// Rôle sur la place de marché (indépendant du rôle historique du logiciel
  /// d'automatisation ci-dessus, conservé pour ne rien casser).
  toumaRole   ToumaRole  @default(BUYER)
  status      UserStatus @default(ACTIVE)
  phone       String?    @unique
  /// Pays de résidence (ISO-3166-1 alpha-2) — voir Country.
  countryCode String?
  country     Country?   @relation(fields: [countryCode], references: [code], onDelete: SetNull)
  locale      String     @default("fr")

  credentials WebAuthnCredential[]
  loginEvents LoginEvent[]

  refreshTokens         ToumaRefreshToken[]
  addresses             ToumaAddress[]
  stores                ToumaStore[]
  carts                 ToumaCart[]
  toumaOrders           ToumaOrder[]
  reviews               ToumaReview[]
  favorites             ToumaFavorite[]
  notifications         ToumaNotification[]
  disputes              ToumaDispute[]
  disputeMessages       ToumaDisputeMessage[]
  riskScore             ToumaRiskScore?
  fraudEvents           ToumaFraudEvent[]
  aiRequests            ToumaAiRequest[]
  auditLogs             ToumaAuditLog[]
  reviewedVerifications ToumaSellerVerification[] @relation("VerificationReviewer")

  orderGroups         ToumaOrderGroup[]
  businessProfile     ToumaBusinessProfile?
  rfqs                ToumaRfq[]
  quotes              ToumaQuote[]                   @relation("QuoteSeller")
  negotiationMessages ToumaNegotiationMessage[]
  conversations       ToumaConversationParticipant[]
  messages            ToumaMessage[]

  returnRequests    ToumaReturnRequest[]
  refundsInitiated  ToumaRefund[]           @relation("RefundInitiator")
  supportTickets    ToumaSupportTicket[]    @relation("TicketRequester")
  assignedTickets   ToumaSupportTicket[]    @relation("TicketAssignee")
  supportMessages   ToumaSupportMessage[]
  coupons           ToumaCoupon[]           @relation("CouponAuthor")
  couponRedemptions ToumaCouponRedemption[]
  loyaltyAccount    ToumaLoyaltyAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Événement de connexion (journal de sécurité).
model LoginEvent {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// password | totp | recovery | webauthn
  method    String
  success   Boolean @default(true)
  ip        String?
  userAgent String?
  /// Première connexion depuis cet appareil (empreinte IP+navigateur).
  newDevice Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Clé de sécurité / passkey (WebAuthn) d'un utilisateur.
model WebAuthnCredential {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identifiant de la clé (base64url), unique.
  credentialId String @unique
  publicKey    String // clé publique (base64url)
  counter      Int    @default(0)
  transports   String @default("")
  name         String @default("Clé de sécurité")

  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. ANALYSE MARCHÉ
// ─────────────────────────────────────────────────────────────────────────────

/// Opportunité produit détectée par l'analyse de marché (produit gagnant potentiel).
model MarketOpportunity {
  id         String  @id @default(cuid())
  source     String // connecteur d'origine (trends, marketplace...)
  externalId String // identifiant stable côté source (déduplication)
  title      String
  category   String
  keywords   String  @default("")
  niche      String?
  region     String?
  currency   String  @default("EUR")

  /// Scores 0..100 issus de l'analyse.
  demandScore      Float @default(0)
  competitionScore Float @default(0)
  trendScore       Float @default(0)
  /// Score global de recommandation (0..100).
  opportunityScore Float @default(0)

  estimatedCostPrice Float?
  estimatedSalePrice Float?
  estimatedMargin    Float?

  /// NEW | EVALUATED | IMPORTED | REJECTED
  status     String @default("NEW")
  /// Métriques brutes de la source (JSON sérialisé).
  rawMetrics String @default("{}")

  products Product[]

  discoveredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status])
  @@index([opportunityScore])
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. CATALOGUE / GÉNÉRATION
// ─────────────────────────────────────────────────────────────────────────────

/// Produit du catalogue (créé manuellement ou généré en masse depuis une opportunité).
model Product {
  id          String  @id @default(cuid())
  sku         String? @unique
  name        String
  description String?
  category    String
  keywords    String  @default("")
  currency    String  @default("EUR")

  /// Économie du produit (dropshipping).
  costPrice Float? // prix d'achat fournisseur
  salePrice Float? // prix de vente client
  margin    Float? // marge = salePrice - costPrice

  /// DRAFT | ACTIVE | ARCHIVED
  status String @default("DRAFT")
  /// Origine : manual | generated | import
  source String @default("manual")
  images String @default("") // URLs séparées par des virgules

  // Critères de sourcing (pilier 4)
  targetUnitPrice        Float?
  targetQuantity         Int?
  region                 String?
  requiredCertifications String  @default("")

  opportunityId String?
  opportunity   MarketOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  searchRequests SearchRequest[]
  orderItems     OrderItem[]
  listings       ChannelListing[]
  ads            Ad[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  generatedAt DateTime?

  @@index([category])
  @@index([status])
}

/// Lot de génération de produits (traçabilité de la fonctionnalité "centaines/jour").
model GenerationRun {
  id        String  @id @default(cuid())
  source    String  @default("opportunities")
  requested Int     @default(0)
  generated Int     @default(0)
  skipped   Int     @default(0)
  failed    Int     @default(0)
  /// RUNNING | COMPLETED | FAILED
  status    String  @default("RUNNING")
  params    String  @default("{}")
  error     String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. COMMANDES / ACHAT & EXPÉDITION
// ─────────────────────────────────────────────────────────────────────────────

/// Client final.
model Customer {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  address String?
  city    String?
  country String?
  zip     String?

  orders          Order[]
  supportMessages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Commande client.
model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// PENDING | PAID | FULFILLING | SHIPPED | DELIVERED | CANCELLED
  status   String @default("PENDING")
  currency String @default("EUR")
  total    Float  @default(0)

  /// Origine de la commande : manual | etsy | ebay | amazon
  channel    String  @default("manual")
  /// Identifiant de la commande côté marketplace (déduplication à l'import).
  externalId String?

  /// En attente de vérification manuelle (ex. adresse à confirmer avant l'envoi
  /// au fournisseur). Les commandes « en attente » sont ignorées par le pilote
  /// automatique tant qu'elles ne sont pas confirmées.
  onHold Boolean @default(false)

  items          OrderItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, externalId])
  @@index([status])
}

/// Message d'une conversation de service client (sauvegardée).
/// customerId nul = conversation générale avec l'assistant (chat direct).
/// role : 'user' (message reçu / saisi par le vendeur) | 'assistant' (agent IA).
model SupportMessage {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  role       String
  content    String
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// Ligne de commande.
model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int     @default(1)
  unitSalePrice Float
  unitCostPrice Float?

  @@index([orderId])
}

/// Bon d'achat passé automatiquement chez un fournisseur pour honorer une commande.
model PurchaseOrder {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  offerId    String?
  offer      Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)

  /// CREATED | PLACED | SHIPPED | DELIVERED | FAILED
  status         String  @default("CREATED")
  cost           Float   @default(0)
  currency       String  @default("EUR")
  trackingNumber String?
  carrier        String?
  error          String?

  createdAt DateTime  @default(now())
  placedAt  DateTime?
  shippedAt DateTime?

  @@index([orderId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. SOURCING / FOURNISSEURS
// ─────────────────────────────────────────────────────────────────────────────

/// Fournisseur référencé dans la base.
model Supplier {
  id             String  @id @default(cuid())
  name           String
  country        String?
  region         String?
  website        String?
  email          String?
  phone          String?
  rating         Float   @default(0)
  verified       Boolean @default(false)
  certifications String  @default("")
  leadTimeDays   Int?
  minOrderValue  Float?
  currency       String  @default("EUR")
  source         String  @default("manual")

  offers         Offer[]
  matches        SupplierMatch[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
  @@index([rating])
}

/// Offre (produit proposé) d'un fournisseur. Alimentée par les connecteurs.
model Offer {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  title        String
  category     String
  keywords     String   @default("")
  unitPrice    Float?
  currency     String   @default("EUR")
  moq          Int?
  leadTimeDays Int?
  inStock      Boolean  @default(true)

  matches        SupplierMatch[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([category])
}

/// Demande de recherche de fournisseurs (synchrone ou asynchrone).
model SearchRequest {
  id                     String   @id @default(cuid())
  productId              String?
  product                Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  query                  String   @default("")
  category               String?
  keywords               String   @default("")
  targetUnitPrice        Float?
  targetQuantity         Int?
  region                 String?
  requiredCertifications String   @default("")
  /// PENDING | RUNNING | COMPLETED | FAILED
  status                 String   @default("PENDING")
  error                  String?

  matches SupplierMatch[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
}

/// Résultat de matching : un fournisseur candidat classé pour une recherche.
model SupplierMatch {
  id              String        @id @default(cuid())
  searchRequestId String
  searchRequest   SearchRequest @relation(fields: [searchRequestId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  offerId         String?
  offer           Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  score           Float
  rank            Int
  breakdown       String        @default("{}")

  createdAt DateTime @default(now())

  @@index([searchRequestId])
  @@index([score])
}

// ═════════════════════════════════════════════════════════════════════════════
// TOUMA — PLACE DE MARCHÉ AFRICAINE (marketplace B2B / B2C)
//
// Domaine ajouté au logiciel existant, isolé par le préfixe `Touma` (modèles)
// et `touma_` (tables) afin de ne rien casser du produit d'automatisation.
// Corridor pilote : Tchad (TD) ↔ Cameroun (CM). Aucun pays n'est codé en dur :
// tout passe par la table `Country`.
//
// Règle absolue : tout montant financier est un `Decimal`, jamais un `Float`.
// ═════════════════════════════════════════════════════════════════════════════

enum ToumaRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SUSPENDED
}

enum ToumaOrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  REJECTED
  CLOSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum AddressKind {
  SHIPPING
  BILLING
  PICKUP
}

// ── Après-vente : retours, remboursements, assistance ────────────────────────

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  CANCELLED
}

/// Motif déclaré par l'acheteur. Détermine qui supporte les frais de retour.
enum ReturnReason {
  DAMAGED
  NOT_AS_DESCRIBED
  WRONG_ITEM
  MISSING_PARTS
  NOT_DELIVERED
  CHANGED_MIND
  OTHER
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  ORDER
  PAYMENT
  DELIVERY
  RETURN
  ACCOUNT
  STORE
  VERIFICATION
  OTHER
}

// ── Promotions et fidélité ───────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

/// Qui finance la remise. Déterminant : une promotion de la plateforme ne doit
/// jamais être payée par le vendeur, et inversement.
enum DiscountFunding {
  PLATFORM
  STORE
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
  EXHAUSTED
}

enum LoyaltyEventType {
  EARNED
  REDEEMED
  REVERSED
  ADJUSTED
}

// ── Référentiels ─────────────────────────────────────────────────────────────

/// Pays desservi par Touma. Le corridor pilote (TD, CM) est une simple donnée :
/// ouvrir un nouveau marché = insérer une ligne, sans toucher au code.
model Country {
  /// ISO-3166-1 alpha-2 (TD, CM, NG, CI…).
  code           String  @id
  name           String
  /// Devise par défaut du pays (ISO-4217, ex. XAF).
  currency       String
  /// Indicatif téléphonique international (ex. +235).
  dialCode       String  @default("")
  /// Le pays accepte-t-il les commandes / les vendeurs ?
  buyingEnabled  Boolean @default(true)
  sellingEnabled Boolean @default(true)
  active         Boolean @default(true)

  users     User[]
  stores    ToumaStore[]
  addresses ToumaAddress[]
  products  ToumaProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_countries")
}

/// Adresse d'un utilisateur (livraison, facturation, enlèvement).
model ToumaAddress {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        AddressKind @default(SHIPPING)
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?
  countryCode String
  country     Country     @relation(fields: [countryCode], references: [code])
  isDefault   Boolean     @default(false)

  /// Réalité des adresses d'Afrique centrale : beaucoup de lieux n'ont ni rue
  /// nommée ni code postal. Le quartier et le point de repère sont ce qui
  /// permet réellement au livreur de trouver le destinataire.
  district     String?
  landmark     String?
  instructions String?
  /// Coordonnées facultatives. Donnée sensible : jamais exposée publiquement,
  /// transmise au seul transporteur de la commande concernée.
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)

  orders ToumaOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("touma_addresses")
}

// ── Vendeurs & boutiques ─────────────────────────────────────────────────────

/// Boutique d'un vendeur.
model ToumaStore {
  id                 String             @id @default(cuid())
  ownerId            String
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  slug               String             @unique
  description        String?
  logoUrl            String?
  bannerUrl          String?
  countryCode        String
  country            Country            @relation(fields: [countryCode], references: [code])
  city               String?
  phone              String?
  status             StoreStatus        @default(DRAFT)
  /// Confiance Touma Verified (dénormalisé depuis la dernière vérification).
  verificationStatus VerificationStatus @default(UNVERIFIED)
  /// Note moyenne (0–5) et nombre d'avis, recalculés à chaque avis publié.
  ratingAverage      Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount        Int                @default(0)

  products      ToumaProduct[]
  orders        ToumaOrder[]
  quotes        ToumaQuote[]
  conversations ToumaConversation[]
  verifications ToumaSellerVerification[]
  payouts       ToumaSellerPayout[]
  commissions   ToumaCommission[]
  returns       ToumaReturnRequest[]
  tickets       ToumaSupportTicket[]
  coupons       ToumaCoupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([countryCode])
  @@map("touma_stores")
}

/// Dossier « Touma Verified » : vérification d'identité / d'entreprise d'un vendeur.
model ToumaSellerVerification {
  id      String     @id @default(cuid())
  storeId String
  store   ToumaStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// INDIVIDUAL | COMPANY
  businessType    String
  legalName       String
  registrationNo  String?
  taxId           String?
  contactPhone    String
  contactEmail    String
  /// Documents (privés) : [{ kind, url, uploadedAt }] — jamais exposés publiquement.
  documents       Json               @default("[]")
  status          VerificationStatus @default(PENDING)
  reviewerId      String?
  reviewer        User?              @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerComment String?
  reviewedAt      DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@map("touma_seller_verifications")
}

// ── Catalogue ────────────────────────────────────────────────────────────────

/// Catégorie du catalogue (arborescence simple parent → enfants).
model ToumaCategory {
  id       String          @id @default(cuid())
  name     String
  slug     String          @unique
  parentId String?
  parent   ToumaCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ToumaCategory[] @relation("CategoryTree")
  rfqItems ToumaRfqItem[]
  /// B2B | B2C | BOTH — segment principal visé.
  segment  String          @default("BOTH")
  position Int             @default(0)
  active   Boolean         @default(true)

  products ToumaProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("touma_categories")
}

/// Produit publié par une boutique.
model ToumaProduct {
  id         String         @id @default(cuid())
  storeId    String
  store      ToumaStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ToumaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title          String
  slug           String        @unique
  description    String        @default("")
  brand          String?
  sku            String?
  /// Prix unitaire TTC exprimé dans `currency` (jamais un Float).
  price          Decimal       @db.Decimal(18, 4)
  /// Prix barré (avant remise), facultatif.
  compareAtPrice Decimal?      @db.Decimal(18, 4)
  currency       String
  /// Quantité minimale de commande (B2B : lots / gros).
  minOrderQty    Int           @default(1)
  status         ProductStatus @default(DRAFT)
  /// Note moyenne et nombre d'avis publiés, recalculés à chaque avis : évite une
  /// agrégation par produit à chaque affichage du catalogue.
  ratingAverage  Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount    Int           @default(0)
  /// Pays d'origine / d'expédition de la marchandise.
  countryCode    String
  country        Country       @relation(fields: [countryCode], references: [code])
  /// Poids unitaire en grammes (devis de transport).
  weightGrams    Int           @default(500)
  keywords       String        @default("")

  images     ToumaProductImage[]
  variants   ToumaProductVariant[]
  inventory  ToumaInventory[]
  cartItems  ToumaCartItem[]
  orderItems ToumaOrderItem[]
  reviews    ToumaReview[]
  favorites  ToumaFavorite[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([countryCode])
  @@map("touma_products")
}

/// Image d'un produit.
model ToumaProductImage {
  id        String       @id @default(cuid())
  productId String
  product   ToumaProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int          @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("touma_product_images")
}

/// Variante (taille, couleur, conditionnement…). `priceDelta` s'ajoute au prix produit.
model ToumaProductVariant {
  id         String       @id @default(cuid())
  productId  String
  product    ToumaProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?      @unique
  priceDelta Decimal      @default(0) @db.Decimal(18, 4)
  position   Int          @default(0)
  active     Boolean      @default(true)

  inventory  ToumaInventory?
  cartItems  ToumaCartItem[]
  orderItems ToumaOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("touma_product_variants")
}

/// Stock d'un produit (ou d'une variante). Une ligne par couple produit/variante.
model ToumaInventory {
  id                String               @id @default(cuid())
  productId         String
  product           ToumaProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?              @unique
  variant           ToumaProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Quantité disponible à la vente (déjà nette des réservations).
  quantity          Int                  @default(0)
  /// Quantité réservée par des commandes non encore expédiées.
  reserved          Int                  @default(0)
  /// Seuil d'alerte de réapprovisionnement.
  lowStockThreshold Int                  @default(5)

  updatedAt DateTime @updatedAt

  @@unique([productId, variantId])
  @@index([productId])
  @@map("touma_inventory")
}

// ── Panier ───────────────────────────────────────────────────────────────────

/// Panier d'un acheteur (un panier actif par utilisateur).
model ToumaCart {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency String?

  items ToumaCartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_carts")
}

/// Ligne de panier. `unitPrice` = prix vu par l'acheteur (revérifié au checkout).
model ToumaCartItem {
  id        String               @id @default(cuid())
  cartId    String
  cart      ToumaCart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   ToumaProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ToumaProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int                  @default(1)
  unitPrice Decimal              @db.Decimal(18, 4)
  currency  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("touma_cart_items")
}

// ── Commandes ────────────────────────────────────────────────────────────────

/// Commande passée auprès d'UNE boutique (un panier multi-boutiques crée
/// plusieurs commandes, chacune avec son paiement et son expédition).
model ToumaOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  buyerId     String
  buyer       User             @relation(fields: [buyerId], references: [id])
  storeId     String
  store       ToumaStore       @relation(fields: [storeId], references: [id])
  status      ToumaOrderStatus @default(PENDING)

  /// Groupe de commande : un panier multi-vendeurs produit un paiement unique
  /// et autant de sous-commandes que de boutiques.
  groupId String?
  group   ToumaOrderGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  /// Mode de remise : domicile, point relais ou retrait chez le vendeur.
  deliveryMethod DeliveryMethod    @default(HOME)
  pickupPointId  String?
  pickupPoint    ToumaPickupPoint? @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)

  currency             String
  /// Somme des lignes (hors livraison).
  subtotal             Decimal @db.Decimal(18, 4)
  shippingTotal        Decimal @default(0) @db.Decimal(18, 4)
  /// Commission Touma retenue sur la commande.
  commissionTotal      Decimal @default(0) @db.Decimal(18, 4)
  /// Part de la remise du panier imputée à cette sous-commande — ce que
  /// l'acheteur ne paie pas.
  discountTotal        Decimal @default(0) @db.Decimal(18, 4)
  /// Part de cette remise réellement financée par le vendeur. Le reste est à la
  /// charge de TOUMA : sa commission reste alors assise sur le sous-total plein,
  /// pour qu'une campagne de la plateforme ne coûte rien à la boutique.
  sellerFundedDiscount Decimal @default(0) @db.Decimal(18, 4)
  total                Decimal @db.Decimal(18, 4)

  /// Adresse de livraison : référence + copie figée (l'adresse peut être modifiée après coup).
  shippingAddressId String?
  shippingAddress   ToumaAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingSnapshot  Json

  /// Commande transfrontalière (pays acheteur ≠ pays vendeur) — cœur de la promesse Touma.
  crossBorder   Boolean @default(false)
  buyerCountry  String?
  sellerCountry String?

  note         String?
  cancelReason String?
  /// Clé d'idempotence du checkout : rejouer la requête ne crée pas de doublon.
  checkoutKey  String?
  placedAt     DateTime  @default(now())
  paidAt       DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  items          ToumaOrderItem[]
  payments       ToumaPayment[]
  conversations  ToumaConversation[]
  shipments      ToumaShipment[]
  quotes         ToumaShippingQuote[]
  reviews        ToumaReview[]
  disputes       ToumaDispute[]
  commissions    ToumaCommission[]
  returnRequests ToumaReturnRequest[]
  refunds        ToumaRefund[]
  tickets        ToumaSupportTicket[]
  loyaltyEvents  ToumaLoyaltyEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, storeId, checkoutKey])
  @@index([groupId])
  @@index([buyerId])
  @@index([storeId])
  @@index([status])
  @@map("touma_orders")
}

/// Ligne de commande : instantané figé du produit au moment de l'achat.
/// Modifier le produit plus tard ne doit JAMAIS changer une commande passée.
model ToumaOrderItem {
  id        String               @id @default(cuid())
  orderId   String
  order     ToumaOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   ToumaProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ToumaProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// Instantané (snapshot) — source de vérité de la commande.
  titleSnapshot   String
  skuSnapshot     String?
  variantSnapshot String?
  imageSnapshot   String?
  unitPrice       Decimal @db.Decimal(18, 4)
  quantity        Int
  lineTotal       Decimal @db.Decimal(18, 4)
  currency        String

  returnItems ToumaReturnItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("touma_order_items")
}

// ── Touma Pay ────────────────────────────────────────────────────────────────

/// Paiement d'une commande, orchestré via un adaptateur (mock, PSP réel…).
model ToumaPayment {
  id             String           @id @default(cuid())
  /// Un paiement porte SOIT une commande unique, SOIT un groupe multi-vendeurs
  /// (l'acheteur paie une fois ; la somme est répartie par commande).
  orderId        String?
  order          ToumaOrder?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderGroupId   String?
  orderGroup     ToumaOrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  /// Code de l'adaptateur : mock | (PSP réel plus tard).
  provider       String
  /// Identifiant du paiement chez le prestataire.
  providerRef    String?
  /// Méthode retenue : MOBILE_MONEY | CARD | BANK_TRANSFER | CASH_ON_DELIVERY…
  method         String
  status         PaymentStatus    @default(PENDING)
  amount         Decimal          @db.Decimal(18, 4)
  currency       String
  refundedAmount Decimal          @default(0) @db.Decimal(18, 4)
  /// Clé d'idempotence fournie par le client (un seul paiement par clé).
  idempotencyKey String?          @unique
  /// Données NON sensibles renvoyées par le prestataire (jamais de données bancaires).
  metadata       Json             @default("{}")
  failureReason  String?

  events  ToumaPaymentEvent[]
  refunds ToumaRefund[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  succeededAt DateTime?

  @@index([orderId])
  @@index([orderGroupId])
  @@index([status])
  @@map("touma_payments")
}

/// Journal d'audit d'un paiement (création, webhooks, remboursements).
model ToumaPaymentEvent {
  id         String       @id @default(cuid())
  paymentId  String
  payment    ToumaPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type       String
  /// Identifiant de l'événement chez le prestataire : rejoue = ignoré (unicité).
  externalId String?      @unique
  payload    Json         @default("{}")

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("touma_payment_events")
}

/// Commission Touma calculée sur une commande (part plateforme).
model ToumaCommission {
  id       String             @id @default(cuid())
  orderId  String
  order    ToumaOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId  String
  store    ToumaStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Taux appliqué (ex. 0.0500 = 5 %) — jamais codé en dur, voir la configuration.
  rate     Decimal            @db.Decimal(6, 4)
  amount   Decimal            @db.Decimal(18, 4)
  currency String
  payoutId String?
  payout   ToumaSellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([storeId])
  @@map("touma_commissions")
}

/// Versement au vendeur (net de commission).
model ToumaSellerPayout {
  id        String       @id @default(cuid())
  storeId   String
  store     ToumaStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  amount    Decimal      @db.Decimal(18, 4)
  currency  String
  status    PayoutStatus @default(PENDING)
  reference String?
  paidAt    DateTime?

  commissions ToumaCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@map("touma_seller_payouts")
}

// ── Touma Logistics ──────────────────────────────────────────────────────────

/// Transporteur raccordé (un adaptateur par transporteur).
model ToumaShippingProvider {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  /// Pays desservis (codes ISO séparés par des virgules ; vide = tous).
  countries String  @default("")
  active    Boolean @default(true)

  quotes    ToumaShippingQuote[]
  shipments ToumaShipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_shipping_providers")
}

/// Devis de transport (prix + délai) proposé pour une commande / un panier.
model ToumaShippingQuote {
  id           String                 @id @default(cuid())
  providerId   String?
  provider     ToumaShippingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerCode String
  serviceName  String
  orderId      String?
  order        ToumaOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  originCountry      String
  originCity         String?
  destinationCountry String
  destinationCity    String?
  weightGrams        Int
  /// Dimensions en cm : { length, width, height }.
  dimensions         Json     @default("{}")
  amount             Decimal  @db.Decimal(18, 4)
  currency           String
  etaMinDays         Int
  etaMaxDays         Int
  /// Expire pour empêcher l'utilisation d'un vieux tarif.
  expiresAt          DateTime

  shipments ToumaShipment[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("touma_shipping_quotes")
}

/// Expédition réelle rattachée à une commande.
model ToumaShipment {
  id                 String                 @id @default(cuid())
  orderId            String
  order              ToumaOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteId            String?
  quote              ToumaShippingQuote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  providerId         String?
  provider           ToumaShippingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerCode       String
  trackingNumber     String                 @unique
  labelUrl           String?
  status             ShipmentStatus         @default(PENDING)
  amount             Decimal                @db.Decimal(18, 4)
  currency           String
  etaMinDays         Int                    @default(0)
  etaMaxDays         Int                    @default(0)
  originCountry      String
  destinationCountry String

  events ToumaTrackingEvent[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shippedAt   DateTime?
  deliveredAt DateTime?

  @@index([orderId])
  @@index([status])
  @@map("touma_shipments")
}

/// Événement de suivi d'une expédition.
model ToumaTrackingEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   ToumaShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  label      String
  location   String?
  occurredAt DateTime       @default(now())

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@map("touma_tracking_events")
}

// ── Avis, litiges, confiance ─────────────────────────────────────────────────

/// Avis d'un acheteur : uniquement sur un produit réellement acheté et livré.
model ToumaReview {
  id        String       @id @default(cuid())
  orderId   String
  order     ToumaOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   ToumaProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  /// PENDING | PUBLISHED | REJECTED — modération.
  status    String       @default("PUBLISHED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([productId])
  @@map("touma_reviews")
}

/// Litige ouvert sur une commande.
model ToumaDispute {
  id           String        @id @default(cuid())
  orderId      String
  order        ToumaOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedById   String
  openedBy     User          @relation(fields: [openedById], references: [id], onDelete: Cascade)
  reason       String
  details      String?
  status       DisputeStatus @default(OPEN)
  /// Décision de l'administrateur (auditée dans ToumaAuditLog).
  resolution   String?
  refundAmount Decimal?      @db.Decimal(18, 4)
  resolvedAt   DateTime?

  messages ToumaDisputeMessage[]
  evidence ToumaDisputeEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("touma_disputes")
}

/// Message échangé dans un litige.
model ToumaDisputeMessage {
  id        String       @id @default(cuid())
  disputeId String
  dispute   ToumaDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  /// Message interne (visible des seuls administrateurs).
  internal  Boolean      @default(false)

  createdAt DateTime @default(now())

  @@index([disputeId])
  @@map("touma_dispute_messages")
}

/// Preuve jointe à un litige (photo, facture…). Stockage privé.
model ToumaDisputeEvidence {
  id        String       @id @default(cuid())
  disputeId String
  dispute   ToumaDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  kind      String
  url       String
  note      String?

  createdAt DateTime @default(now())

  @@index([disputeId])
  @@map("touma_dispute_evidence")
}

// ── Risque & fraude ──────────────────────────────────────────────────────────

/// Score de risque d'un utilisateur (informatif : ne bannit jamais tout seul).
model ToumaRiskScore {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 0 (sûr) → 100 (très risqué).
  score   Int    @default(0)
  /// LOW | MEDIUM | HIGH
  level   String @default("LOW")
  /// Signaux ayant contribué au score : [{ code, weight, detail }].
  signals Json   @default("[]")

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("touma_risk_scores")
}

/// Signal de fraude observé (paiement échoué, incohérence pays/adresse…).
model ToumaFraudEvent {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  code   String
  weight Int     @default(1)
  detail Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([code])
  @@map("touma_fraud_events")
}

// ── Divers ───────────────────────────────────────────────────────────────────

/// Produit mis en favori par un acheteur.
model ToumaFavorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   ToumaProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("touma_favorites")
}

/// Notification métier. Le canal (email/SMS/WhatsApp/push) est branché plus tard :
/// le domaine ne dépend d'aucun fournisseur.
model ToumaNotification {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ORDER_CREATED | PAYMENT_SUCCEEDED | SHIPMENT_UPDATED | VERIFICATION_APPROVED…
  type     String
  title    String
  body     String
  data     Json      @default("{}")
  readAt   DateTime?
  /// Canaux de diffusion demandés (IN_APP par défaut).
  channels String    @default("IN_APP")

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("touma_notifications")
}

/// Jeton de rafraîchissement (rotation + révocation). Seul le hash est stocké.
model ToumaRefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 du jeton : un vol de base ne permet pas de rejouer le jeton.
  tokenHash  String    @unique
  /// Famille de jetons : une réutilisation détectée révoque toute la famille.
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Jeton émis en remplacement (chaîne de rotation).
  replacedBy String?
  userAgent  String?
  ip         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("touma_refresh_tokens")
}

// ── Touma AI ─────────────────────────────────────────────────────────────────

/// Requête envoyée à un fournisseur d'IA (traçabilité, quotas, coûts).
model ToumaAiRequest {
  id        String  @id @default(cuid())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider  String
  /// generate | classify | recommend
  kind      String
  /// Cas d'usage : product_description | product_title | category_suggestion…
  useCase   String
  input     Json    @default("{}")
  output    Json    @default("{}")
  /// OK | ERROR
  status    String  @default("OK")
  latencyMs Int     @default(0)
  error     String?

  recommendations ToumaAiRecommendation[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("touma_ai_requests")
}

/// Recommandation produite par l'IA. Toute action critique reste validée par un humain.
model ToumaAiRecommendation {
  id         String          @id @default(cuid())
  requestId  String?
  request    ToumaAiRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  /// PRODUCT | SUPPLIER | PRICE | CATEGORY
  targetType String
  targetId   String?
  score      Decimal         @default(0) @db.Decimal(6, 4)
  reason     String?
  payload    Json            @default("{}")
  /// L'utilisateur a-t-il accepté la recommandation ?
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@map("touma_ai_recommendations")
}

/// Journal d'audit : toute action sensible (admin, litige, vérification, paiement).
model ToumaAuditLog {
  id       String  @id @default(cuid())
  actorId  String?
  actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Ex. verification.approve, order.status.update, dispute.resolve.
  action   String
  entity   String
  entityId String?
  /// Détail non sensible (jamais de secrets, jetons ou données bancaires).
  metadata Json    @default("{}")
  ip       String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@map("touma_audit_logs")
}

// ═════════════════════════════════════════════════════════════════════════════
// TOUMA — COMMANDE MULTI-VENDEURS, POINTS RELAIS, B2B (RFQ) ET MESSAGERIE
// ═════════════════════════════════════════════════════════════════════════════

enum DeliveryMethod {
  /// Livraison à l'adresse de l'acheteur.
  HOME
  /// Retrait dans un point relais partenaire.
  PICKUP_POINT
  /// Retrait chez le vendeur.
  SELLER_PICKUP
}

enum OrderGroupStatus {
  PENDING
  PAID
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
}

/// Groupe de commande : le panier validé en une fois. Il porte le paiement
/// unique de l'acheteur ; chaque boutique reçoit sa propre sous-commande, avec
/// sa préparation, son expédition et sa commission.
model ToumaOrderGroup {
  id        String           @id @default(cuid())
  reference String           @unique
  buyerId   String
  buyer     User             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status    OrderGroupStatus @default(PENDING)

  currency      String
  itemsTotal    Decimal @db.Decimal(18, 4)
  shippingTotal Decimal @default(0) @db.Decimal(18, 4)
  discountTotal Decimal @default(0) @db.Decimal(18, 4)
  total         Decimal @db.Decimal(18, 4)

  /// Copie figée de l'adresse de livraison au moment de la validation.
  shippingSnapshot Json
  /// Clé d'idempotence du checkout (rejouer la requête ne crée pas de doublon).
  checkoutKey      String?
  /// Vrai dès qu'au moins une sous-commande franchit une frontière.
  crossBorder      Boolean @default(false)

  orders        ToumaOrder[]
  payments      ToumaPayment[]
  quotes        ToumaQuote[]
  redemptions   ToumaCouponRedemption[]
  loyaltyEvents ToumaLoyaltyEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@unique([buyerId, checkoutKey])
  @@index([buyerId])
  @@index([status])
  @@map("touma_order_groups")
}

/// Point relais partenaire : essentiel là où la livraison à domicile est peu
/// fiable. Les horaires et le point de repère comptent autant que l'adresse.
model ToumaPickupPoint {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  countryCode  String
  city         String
  district     String?
  landmark     String?
  addressLine  String
  phone        String?
  /// Horaires d'ouverture en clair (ex. « Lun–Sam 8h–18h »).
  openingHours String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  active       Boolean  @default(true)

  orders ToumaOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode, city])
  @@map("touma_pickup_points")
}

// ── TOUMA Business & appels d'offres (RFQ) ───────────────────────────────────

enum RfqStatus {
  /// Publié : les fournisseurs peuvent répondre.
  OPEN
  /// Au moins une offre reçue.
  QUOTED
  /// Une offre a été retenue.
  AWARDED
  CLOSED
  EXPIRED
  CANCELLED
}

enum QuoteStatus {
  SUBMITTED
  /// Contre-proposition en cours de négociation.
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum NegotiationKind {
  MESSAGE
  COUNTER_OFFER
  ACCEPT
  REJECT
}

/// Profil entreprise d'un acheteur professionnel (TOUMA Business).
model ToumaBusinessProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  legalName      String
  registrationNo String?
  taxId          String?
  /// Secteur d'activité déclaré (agroalimentaire, distribution, BTP…).
  sector         String?
  countryCode    String
  city           String?
  phone          String?
  website        String?
  /// Volume d'achat annuel déclaré, à titre indicatif (jamais présenté comme vérifié).
  annualVolume   String?

  rfqs ToumaRfq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_business_profiles")
}

/// Appel d'offres : « je recherche 500 kg de cacao au Cameroun ».
model ToumaRfq {
  id                String                @id @default(cuid())
  reference         String                @unique
  buyerId           String
  buyer             User                  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  businessProfileId String?
  business          ToumaBusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  title         String
  description   String    @default("")
  /// Pays de livraison souhaité.
  countryCode   String
  city          String?
  currency      String
  /// Pays d'origine souhaité pour la marchandise (facultatif).
  sourceCountry String?
  status        RfqStatus @default(OPEN)
  /// Date limite de réception des offres.
  deadline      DateTime?

  items  ToumaRfqItem[]
  quotes ToumaQuote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([buyerId])
  @@index([status])
  @@index([countryCode])
  @@map("touma_rfqs")
}

/// Ligne d'un appel d'offres (produit recherché et quantité).
model ToumaRfqItem {
  id    String   @id @default(cuid())
  rfqId String
  rfq   ToumaRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  quantity        Int
  /// Unité : kg, tonne, sac, carton, pièce…
  unit            String         @default("pièce")
  /// Prix unitaire cible indiqué par l'acheteur (facultatif).
  targetUnitPrice Decimal?       @db.Decimal(18, 4)
  categoryId      String?
  category        ToumaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  quoteItems ToumaQuoteItem[]

  createdAt DateTime @default(now())

  @@index([rfqId])
  @@map("touma_rfq_items")
}

/// Offre d'un fournisseur en réponse à un appel d'offres.
model ToumaQuote {
  id        String     @id @default(cuid())
  reference String     @unique
  rfqId     String
  rfq       ToumaRfq   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  storeId   String
  store     ToumaStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User       @relation("QuoteSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  currency      String
  itemsTotal    Decimal     @db.Decimal(18, 4)
  shippingTotal Decimal     @default(0) @db.Decimal(18, 4)
  total         Decimal     @db.Decimal(18, 4)
  /// Délai de mise à disposition annoncé, en jours.
  leadTimeDays  Int         @default(7)
  /// Une offre expirée ne peut plus être acceptée.
  validUntil    DateTime
  status        QuoteStatus @default(SUBMITTED)
  message       String?

  /// Commande créée lorsque l'acheteur accepte l'offre.
  orderGroupId String?
  orderGroup   ToumaOrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: SetNull)

  items        ToumaQuoteItem[]
  negotiations ToumaNegotiationMessage[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  acceptedAt DateTime?

  @@unique([rfqId, storeId])
  @@index([rfqId])
  @@index([storeId])
  @@index([status])
  @@map("touma_quotes")
}

/// Ligne d'une offre fournisseur.
model ToumaQuoteItem {
  id        String        @id @default(cuid())
  quoteId   String
  quote     ToumaQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItemId String?
  rfqItem   ToumaRfqItem? @relation(fields: [rfqItemId], references: [id], onDelete: SetNull)

  name      String
  quantity  Int
  unit      String  @default("pièce")
  unitPrice Decimal @db.Decimal(18, 4)
  lineTotal Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("touma_quote_items")
}

/// Échange de négociation sur une offre : message, contre-proposition, décision.
/// L'historique complet est conservé — il fait foi en cas de litige.
model ToumaNegotiationMessage {
  id            String          @id @default(cuid())
  quoteId       String
  quote         ToumaQuote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  authorId      String
  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind          NegotiationKind @default(MESSAGE)
  body          String
  /// Total proposé par l'auteur lors d'une contre-proposition.
  proposedTotal Decimal?        @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("touma_negotiation_messages")
}

// ── Messagerie ───────────────────────────────────────────────────────────────

enum ConversationKind {
  /// Acheteur ↔ vendeur, éventuellement rattachée à une commande.
  BUYER_SELLER
  /// Négociation d'un appel d'offres.
  RFQ
  /// Assistance TOUMA.
  SUPPORT
}

/// Fil de discussion entre participants identifiés.
model ToumaConversation {
  id      String           @id @default(cuid())
  kind    ConversationKind @default(BUYER_SELLER)
  subject String?

  /// Rattachements facultatifs, qui donnent son contexte à la conversation.
  storeId String?
  store   ToumaStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  orderId String?
  order   ToumaOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rfqId   String?

  lastMessageAt DateTime @default(now())

  participants ToumaConversationParticipant[]
  messages     ToumaMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([lastMessageAt])
  @@map("touma_conversations")
}

/// Participation à une conversation : c'est elle qui autorise l'accès au fil.
model ToumaConversationParticipant {
  id             String            @id @default(cuid())
  conversationId String
  conversation   ToumaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Rôle tenu dans ce fil : BUYER | SELLER | ADMIN.
  role           String            @default("BUYER")
  lastReadAt     DateTime?

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("touma_conversation_participants")
}

model ToumaMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   ToumaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String

  attachments ToumaMessageAttachment[]

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("touma_messages")
}

/// Pièce jointe d'un message. Le type et la taille sont contrôlés au dépôt.
model ToumaMessageAttachment {
  id        String       @id @default(cuid())
  messageId String
  message   ToumaMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  name      String
  mimeType  String
  sizeBytes Int          @default(0)

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("touma_message_attachments")
}

// ── Après-vente : retours, remboursements ────────────────────────────────────

/// Demande de retour émise par l'acheteur sur une commande livrée.
///
/// Le montant n'est **jamais** transmis par le client : il est recalculé à
/// partir des instantanés de la commande. Un retour ne rembourse rien par
/// lui-même — le remboursement est un acte financier distinct (ToumaRefund),
/// tracé et réversible uniquement par une décision humaine.
model ToumaReturnRequest {
  id        String       @id @default(cuid())
  reference String       @unique
  orderId   String
  order     ToumaOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  storeId   String
  store     ToumaStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status    ReturnStatus @default(REQUESTED)
  reason    ReturnReason
  comment   String       @default("")

  currency        String
  /// Montant réclamé, recalculé côté serveur à partir des lignes retournées.
  requestedAmount Decimal  @db.Decimal(18, 4)
  /// Montant validé par le vendeur ou l'administration (≤ montant réclamé).
  approvedAmount  Decimal? @db.Decimal(18, 4)
  /// Les frais de livraison sont remboursés quand le tort vient du vendeur.
  refundShipping  Boolean  @default(false)

  /// Preuves déposées par l'acheteur (URL + type), jamais de données sensibles.
  evidence Json @default("[]")

  sellerNote     String?
  rejectionNote  String?
  /// Numéro de suivi du colis retourné, fourni par l'acheteur.
  trackingNumber String?

  decidedById String?
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  receivedAt  DateTime?
  refundedAt  DateTime?
  closedAt    DateTime?

  items   ToumaReturnItem[]
  refunds ToumaRefund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([buyerId])
  @@index([storeId])
  @@index([status])
  @@map("touma_return_requests")
}

/// Ligne retournée : rattachée à une ligne de commande, au prix figé d'achat.
model ToumaReturnItem {
  id              String             @id @default(cuid())
  returnRequestId String
  returnRequest   ToumaReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       ToumaOrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  titleSnapshot String
  quantity      Int
  unitPrice     Decimal @db.Decimal(18, 4)
  lineTotal     Decimal @db.Decimal(18, 4)
  currency      String
  /// État constaté à réception (renseigné par le vendeur).
  condition     String?

  createdAt DateTime @default(now())

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("touma_return_items")
}

/// Remboursement : mouvement d'argent réel exécuté via le prestataire de
/// paiement. Toujours rattaché à une commande, et à la demande de retour
/// lorsqu'il en découle. Aucune donnée bancaire n'y est stockée.
model ToumaRefund {
  id        String        @id @default(cuid())
  reference String        @unique
  orderId   String
  order     ToumaOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId String?
  payment   ToumaPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  returnRequestId String?
  returnRequest   ToumaReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  amount   Decimal      @db.Decimal(18, 4)
  currency String
  status   RefundStatus @default(PENDING)
  reason   String       @default("")

  /// Adaptateur ayant exécuté le remboursement et référence renvoyée.
  provider      String
  providerRef   String?
  failureReason String?
  metadata      Json    @default("{}")

  /// Auteur de la décision : toujours un humain (vendeur ou administration).
  initiatedById String?
  initiatedBy   User?   @relation("RefundInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([orderId])
  @@index([paymentId])
  @@index([returnRequestId])
  @@index([status])
  @@map("touma_refunds")
}

// ── Assistance ───────────────────────────────────────────────────────────────

/// Ticket d'assistance. Un acheteur, un vendeur ou une entreprise ouvre un
/// ticket ; l'administration répond. Les notes internes ne sont jamais
/// visibles par le demandeur.
model ToumaSupportTicket {
  id          String         @id @default(cuid())
  reference   String         @unique
  requesterId String
  requester   User           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  subject     String
  category    TicketCategory @default(OTHER)
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)

  orderId String?
  order   ToumaOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  storeId String?
  store   ToumaStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  lastReplyAt DateTime  @default(now())
  resolvedAt  DateTime?
  closedAt    DateTime?

  messages ToumaSupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
  @@index([assignedToId])
  @@map("touma_support_tickets")
}

/// Message d'un ticket. `internal = true` : note d'équipe, jamais renvoyée au
/// demandeur.
model ToumaSupportMessage {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      ToumaSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  internal    Boolean            @default(false)
  /// Pièces jointes contrôlées au dépôt (type et taille).
  attachments Json               @default("[]")

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("touma_support_messages")
}

// ── Promotions ───────────────────────────────────────────────────────────────

/// Code de réduction. Deux natures bien distinctes :
///   • `PLATFORM` — promotion TOUMA : le vendeur est payé plein tarif, la
///     plateforme absorbe la remise sur sa commission ;
///   • `STORE` — promotion du vendeur : elle réduit son propre revenu.
/// Confondre les deux reviendrait à faire financer nos campagnes par les
/// boutiques.
model ToumaCoupon {
  id      String          @id @default(cuid())
  /// Normalisé en majuscules : la saisie de l'acheteur est insensible à la casse.
  code    String          @unique
  funding DiscountFunding @default(PLATFORM)
  /// Renseigné si et seulement si la promotion appartient à une boutique.
  storeId String?
  store   ToumaStore?     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  type        DiscountType
  /// Pourcentage (0–100) ou montant fixe, selon `type`. Ignoré pour la livraison offerte.
  value       Decimal      @default(0) @db.Decimal(18, 4)
  /// Devise obligatoire pour un montant fixe : aucune conversion approximative.
  currency    String?
  description String       @default("")

  /// Conditions d'éligibilité, toutes facultatives.
  minOrderAmount    Decimal? @db.Decimal(18, 4)
  /// Plafond de remise pour un pourcentage (évite qu'un -20 % sur un gros panier coûte une fortune).
  maxDiscountAmount Decimal? @db.Decimal(18, 4)
  /// Pays de livraison éligibles (codes ISO séparés par des virgules). Vide = tous.
  countryCodes      String   @default("")
  /// Réservé à une première commande.
  firstOrderOnly    Boolean  @default(false)

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  /// Nombre total d'utilisations autorisées, et par acheteur.
  usageLimit        Int?
  usageLimitPerUser Int?
  usageCount        Int          @default(0)
  status            CouponStatus @default(ACTIVE)

  createdById String?
  createdBy   User?   @relation("CouponAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  redemptions ToumaCouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@map("touma_coupons")
}

/// Utilisation effective d'un code sur un panier validé. L'unicité par panier
/// empêche qu'un même code soit compté deux fois sur la même commande.
model ToumaCouponRedemption {
  id           String          @id @default(cuid())
  couponId     String
  coupon       ToumaCoupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderGroupId String
  orderGroup   ToumaOrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(18, 4)
  currency String

  createdAt DateTime @default(now())

  @@unique([couponId, orderGroupId])
  @@index([userId])
  @@map("touma_coupon_redemptions")
}

// ── Fidélité ─────────────────────────────────────────────────────────────────

/// Compte de fidélité. Le solde n'est jamais écrit à la main : il est la somme
/// des événements, appliquée de façon atomique à chaque mouvement.
model ToumaLoyaltyAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance        Int    @default(0)
  lifetimePoints Int    @default(0)
  /// Niveau déduit des points cumulés (paliers configurables).
  tier           String @default("BRONZE")

  events ToumaLoyaltyEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("touma_loyalty_accounts")
}

/// Mouvement de points, signé (positif = gagné, négatif = dépensé ou repris).
model ToumaLoyaltyEvent {
  id        String              @id @default(cuid())
  accountId String
  account   ToumaLoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      LoyaltyEventType
  points    Int

  orderId      String?
  order        ToumaOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderGroupId String?
  orderGroup   ToumaOrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: SetNull)

  reason String @default("")

  createdAt DateTime @default(now())

  /// Un seul gain par commande : rejouer une livraison ne crédite pas deux fois.
  @@unique([orderId, type])
  @@index([accountId])
  @@map("touma_loyalty_events")
}

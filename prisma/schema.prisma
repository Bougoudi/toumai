// Schéma de base de données — Toumai
// Plateforme d'automatisation e-commerce / dropshipping.
// Base : SQLite (par défaut). Migrable vers PostgreSQL en changeant `provider`.
//
// Les 4 piliers du logiciel :
//   1. Analyse marché  -> MarketOpportunity
//   2. Génération      -> Product / GenerationRun
//   3. Achat & envoi   -> Customer / Order / OrderItem / PurchaseOrder
//   4. Sourcing        -> Supplier / Offer / SearchRequest / SupplierMatch

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. ANALYSE MARCHÉ
// ─────────────────────────────────────────────────────────────────────────────

/// Opportunité produit détectée par l'analyse de marché (produit gagnant potentiel).
model MarketOpportunity {
  id                 String  @id @default(cuid())
  source             String // connecteur d'origine (trends, marketplace...)
  externalId         String // identifiant stable côté source (déduplication)
  title              String
  category           String
  keywords           String  @default("")
  niche              String?
  region             String?
  currency           String  @default("EUR")

  /// Scores 0..100 issus de l'analyse.
  demandScore        Float   @default(0)
  competitionScore   Float   @default(0)
  trendScore         Float   @default(0)
  /// Score global de recommandation (0..100).
  opportunityScore   Float   @default(0)

  estimatedCostPrice Float?
  estimatedSalePrice Float?
  estimatedMargin    Float?

  /// NEW | EVALUATED | IMPORTED | REJECTED
  status             String  @default("NEW")
  /// Métriques brutes de la source (JSON sérialisé).
  rawMetrics         String  @default("{}")

  products Product[]

  discoveredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status])
  @@index([opportunityScore])
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. CATALOGUE / GÉNÉRATION
// ─────────────────────────────────────────────────────────────────────────────

/// Produit du catalogue (créé manuellement ou généré en masse depuis une opportunité).
model Product {
  id                     String             @id @default(cuid())
  sku                    String?            @unique
  name                   String
  description            String?
  category               String
  keywords               String             @default("")
  currency               String             @default("EUR")

  /// Économie du produit (dropshipping).
  costPrice              Float? // prix d'achat fournisseur
  salePrice              Float? // prix de vente client
  margin                 Float? // marge = salePrice - costPrice

  /// DRAFT | ACTIVE | ARCHIVED
  status                 String             @default("DRAFT")
  /// Origine : manual | generated | import
  source                 String             @default("manual")
  images                 String             @default("") // URLs séparées par des virgules

  // Critères de sourcing (pilier 4)
  targetUnitPrice        Float?
  targetQuantity         Int?
  region                 String?
  requiredCertifications String             @default("")

  opportunityId String?
  opportunity   MarketOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  searchRequests SearchRequest[]
  orderItems     OrderItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  generatedAt DateTime?

  @@index([category])
  @@index([status])
}

/// Lot de génération de produits (traçabilité de la fonctionnalité "centaines/jour").
model GenerationRun {
  id        String   @id @default(cuid())
  source    String   @default("opportunities")
  requested Int      @default(0)
  generated Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  /// RUNNING | COMPLETED | FAILED
  status    String   @default("RUNNING")
  params    String   @default("{}")
  error     String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. COMMANDES / ACHAT & EXPÉDITION
// ─────────────────────────────────────────────────────────────────────────────

/// Client final.
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  address   String?
  city      String?
  country   String?
  zip       String?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Commande client.
model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// PENDING | PAID | FULFILLING | SHIPPED | DELIVERED | CANCELLED
  status   String  @default("PENDING")
  currency String  @default("EUR")
  total    Float   @default(0)

  items          OrderItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Ligne de commande.
model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int     @default(1)
  unitSalePrice Float
  unitCostPrice Float?

  @@index([orderId])
}

/// Bon d'achat passé automatiquement chez un fournisseur pour honorer une commande.
model PurchaseOrder {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  offerId    String?
  offer      Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)

  /// CREATED | PLACED | SHIPPED | DELIVERED | FAILED
  status         String  @default("CREATED")
  cost           Float   @default(0)
  currency       String  @default("EUR")
  trackingNumber String?
  carrier        String?
  error          String?

  createdAt DateTime  @default(now())
  placedAt  DateTime?
  shippedAt DateTime?

  @@index([orderId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. SOURCING / FOURNISSEURS
// ─────────────────────────────────────────────────────────────────────────────

/// Fournisseur référencé dans la base.
model Supplier {
  id             String  @id @default(cuid())
  name           String
  country        String?
  region         String?
  website        String?
  email          String?
  phone          String?
  rating         Float   @default(0)
  verified       Boolean @default(false)
  certifications String  @default("")
  leadTimeDays   Int?
  minOrderValue  Float?
  currency       String  @default("EUR")
  source         String  @default("manual")

  offers         Offer[]
  matches        SupplierMatch[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
  @@index([rating])
}

/// Offre (produit proposé) d'un fournisseur. Alimentée par les connecteurs.
model Offer {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  title        String
  category     String
  keywords     String   @default("")
  unitPrice    Float?
  currency     String   @default("EUR")
  moq          Int?
  leadTimeDays Int?
  inStock      Boolean  @default(true)

  matches        SupplierMatch[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([category])
}

/// Demande de recherche de fournisseurs (synchrone ou asynchrone).
model SearchRequest {
  id                     String   @id @default(cuid())
  productId              String?
  product                Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  query                  String   @default("")
  category               String?
  keywords               String   @default("")
  targetUnitPrice        Float?
  targetQuantity         Int?
  region                 String?
  requiredCertifications String   @default("")
  /// PENDING | RUNNING | COMPLETED | FAILED
  status                 String   @default("PENDING")
  error                  String?

  matches SupplierMatch[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
}

/// Résultat de matching : un fournisseur candidat classé pour une recherche.
model SupplierMatch {
  id              String        @id @default(cuid())
  searchRequestId String
  searchRequest   SearchRequest @relation(fields: [searchRequestId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  offerId         String?
  offer           Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  score           Float
  rank            Int
  breakdown       String        @default("{}")

  createdAt DateTime @default(now())

  @@index([searchRequestId])
  @@index([score])
}

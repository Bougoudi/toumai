# Copiez ce fichier vers .env puis adaptez les valeurs.

# Base de données (SQLite par défaut — aucun serveur requis)
DATABASE_URL="file:./dev.db"

# Serveur HTTP
PORT=3000
NODE_ENV=development

# Automatisation (planificateur de tâches)
# Activer/désactiver le worker cron intégré au serveur
ENABLE_SCHEDULER=true
# Rafraîchissement des données fournisseurs (cron)
CRON_REFRESH_SUPPLIERS="0 * * * *"
# Traitement des recherches en attente (cron)
CRON_RUN_SEARCHES="*/2 * * * *"

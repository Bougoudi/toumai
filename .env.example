# Copiez ce fichier vers .env puis adaptez les valeurs.

# ═══════════════════════════════════════════════════════════════════════════
# TOUMA — place de marché du commerce africain (API /api/v1, interface /touma)
# ═══════════════════════════════════════════════════════════════════════════

# Base de données : PostgreSQL (requis).
DATABASE_URL="postgresql://touma:touma@localhost:5432/touma?schema=public"

# Base dédiée aux tests automatisés : ils créent et suppriment de vraies
# données, jamais dans votre base de travail.
TEST_DATABASE_URL="postgresql://touma:touma@localhost:5432/touma_test?schema=public"

# Cache / files d'attente (optionnel : l'API démarre sans, /ready le signale).
REDIS_URL="redis://localhost:6379"

# ── Authentification Touma ──────────────────────────────────
# Secrets distincts pour le jeton d'accès (court) et le jeton de
# rafraîchissement (rotation + révocation). 32 caractères aléatoires minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TOUMA_ACCESS_TTL_SECONDS=900        # 15 minutes
TOUMA_REFRESH_TTL_SECONDS=2592000   # 30 jours

# ── Règles de la place de marché ────────────────────────────
TOUMA_COMMISSION_RATE=0.05          # commission plateforme (0.05 = 5 %)
TOUMA_DEFAULT_CURRENCY=XAF          # devise de repli si le pays n'en déclare pas
TOUMA_RETURN_WINDOW_DAYS=14         # délai d'ouverture d'un retour après livraison
TOUMA_PAGE_SIZE=20
TOUMA_MAX_PAGE_SIZE=100

# ── Adaptateurs (aucun prestataire réel n'est raccordé à ce stade) ──
# Chaque adaptateur est remplaçable sans toucher au cœur de l'application.
TOUMA_PAYMENT_PROVIDER=mock         # Touma Pay
TOUMA_LOGISTICS_PROVIDER=mock       # Touma Logistics
TOUMA_AI_PROVIDER=mock              # Touma AI
# Secret de signature des webhooks de paiement (HMAC-SHA256 du corps brut).
TOUMA_PAYMENT_WEBHOOK_SECRET=

# ── Stockage objet compatible S3 (images produits, documents privés) ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# URL publique de l'API consommée par un front séparé (facultatif : l'interface
# fournie est servie par le même serveur).
NEXT_PUBLIC_API_URL=

# ═══════════════════════════════════════════════════════════════════════════
# Logiciel d'automatisation e-commerce (produit historique, conservé)
# ═══════════════════════════════════════════════════════════════════════════

# Serveur HTTP
PORT=3000
NODE_ENV=development

# Mode démonstration (données factices) vs production réelle.
#   true  = l'appli génère de fausses commandes/fournisseurs/opportunités (prise en main).
#   false = production réelle : aucune donnée simulée ; seules les vraies sources
#           connectées (API fournisseurs, canaux de vente, Stripe) alimentent l'appli.
DEMO_MODE=true

# Règles commerciales (dropshipping)
DEFAULT_MARKUP=2.5            # prix de vente = prix d'achat x markup
MIN_OPPORTUNITY_SCORE=60      # score minimum pour générer un produit
DEFAULT_CURRENCY=EUR

# Quotas d'automatisation
PRODUCTS_PER_RUN=200          # produits générés par cycle

# Automatisation (planificateur de tâches)
ENABLE_SCHEDULER=true
CRON_MARKET_SCAN="*/30 * * * *"        # analyse marché toutes les 30 min
CRON_GENERATE_PRODUCTS="0 */6 * * *"   # génération de produits toutes les 6 h
CRON_FULFILL_ORDERS="*/1 * * * *"      # traitement des commandes chaque minute
CRON_REFRESH_SUPPLIERS="0 * * * *"     # rafraîchissement fournisseurs (horaire)
CRON_RUN_SEARCHES="*/2 * * * *"        # recherches en file (2 min)
CRON_SIMULATE_DEMAND="*/3 * * * *"     # commandes clients simulées (3 min)
CRON_SYNC_CHANNELS="*/5 * * * *"       # import des commandes marketplace (5 min)

# Pilote automatique
AUTOPILOT_RUN_ON_START=true            # cycle complet dès le démarrage
AUTOPILOT_INTERVAL_SECONDS=60          # intervalle entre cycles (npm run autopilot)
SIMULATE_DEMAND=true                   # génère des commandes clients automatiquement
SIMULATED_ORDERS_PER_CYCLE=3           # nb de commandes simulées par cycle

# ── Sources réelles (optionnel) ──────────────────────────────
# Si renseignées, le connecteur HTTP réel remplace le connecteur de démo.
# Laisser vide = mode démonstration (mock).
# MARKET_API_URL=https://api.exemple.com/trends
# MARKET_API_KEY=...
# SUPPLIER_API_URL=https://api.exemple.com/suppliers
# SUPPLIER_API_KEY=...
# FULFILLMENT_API_URL=https://api.fournisseur.com
# FULFILLMENT_API_KEY=...
# Reconnaissance d'image (recherche produit par photo / caméra). Sans clé, la
# recherche par photo utilise le mot-clé saisi. Contrat : POST {url} avec
# Authorization: Bearer {key} et { "image": "<base64>" } → { "labels":[{label,confidence}] }.
# Google Cloud Vision (recommandé) : mettez VISION_PROVIDER=google + la clé API.
# VISION_PROVIDER=google
# VISION_API_KEY=AIza...
# — ou un service générique (POST {url}, Authorization: Bearer, { image }) :
# VISION_API_URL=https://api.vision.exemple.com/detect
# VISION_API_KEY=...
#
# Base de données de codes-barres (scanner EAN/UPC → vrai produit). Sans URL, le
# scan renvoie un produit de démonstration. La lecture du code par la caméra est
# native (aucun service requis). Utilisez {code} dans l'URL pour l'insérer,
# sinon ?code= est ajouté. Clé optionnelle (Open Food Facts est gratuit, sans clé).
# Open Food Facts (gratuit, sans clé) :
# BARCODE_API_URL=https://world.openfoodfacts.org/api/v2/product/{code}.json
# — ou UPCitemdb / Barcode Lookup (avec clé) :
# BARCODE_API_URL=https://api.barcodelookup.com/v3/products?barcode={code}
# BARCODE_API_KEY=...
#
# Recherche de produits AliExpress (« Trouver des produits » par texte / photo).
# App Key + App Secret depuis AliExpress Open Platform (openservice.aliexpress.com).
# Sans clés, la recherche par texte utilise le catalogue de démonstration.
# ALIEXPRESS_APP_KEY=...
# ALIEXPRESS_APP_SECRET=...
# ALIEXPRESS_TRACKING_ID=            # facultatif (identifiant de suivi affilié)

# ── Sécurité ─────────────────────────────────────────────────
# Clé de signature des jetons JWT. OBLIGATOIRE en production : ≥ 32 caractères
# aléatoires (ex: openssl rand -base64 48). Le serveur refuse de démarrer en prod
# si elle est absente/faible.
JWT_SECRET=dev-secret-change-me
JWT_TTL_SECONDS=604800
# Clé de chiffrement des identifiants sensibles en base (canaux de vente).
# ≥ 32 caractères aléatoires. À défaut, JWT_SECRET est utilisé.
ENCRYPTION_KEY=
# Origines autorisées en cross-origin (séparées par des virgules). Vide = même origine.
CORS_ORIGINS=

# ── Canaux de vente (Etsy / eBay / Amazon) ───────────────────
# Les identifiants se saisissent depuis l'onglet « Canaux de vente » de l'app
# (stockés en base par canal), pas ici. Voir docs pour ce que chaque canal exige.

# ── Paiement par carte — iyzico (Turquie) ────────────────────
# Modèle « carte → portefeuille → retrait IBAN » : le client paie par carte sur
# la page hébergée iyzico, l'argent arrive dans le portefeuille de l'appli, puis
# vous retirez vers votre IBAN (onglet Portefeuille → « Demander un retrait »).
#
# Par défaut, IYZICO_URI pointe vers le BAC À SABLE (sandbox) : gratuit, sans
# document, pour tout tester. Récupérez des clés de test sur
# https://sandbox-merchant.iyzipay.com  (compte sandbox gratuit).
# En production réelle (après ouverture du compte marchand iyzico, qui nécessite
# une auto-entreprise / şahıs şirketi), mettez les vraies clés et
# IYZICO_URI=https://api.iyzipay.com
# IYZICO_API_KEY=sandbox-...
# IYZICO_SECRET_KEY=sandbox-...
# IYZICO_URI=https://sandbox-api.iyzipay.com

# Prestataire de paiement carte : auto (défaut) = iyzico s'il est configuré,
# sinon Stripe. Forcer si besoin : PAYMENT_PROVIDER=iyzico  (ou stripe)
# PAYMENT_PROVIDER=iyzico

# ── Paiement par carte — Stripe (Europe / international) ──────
# Sans clé, le paiement est désactivé (les commandes restent en mode démo).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Retraits (Stripe Payouts via Stripe Connect) ─────────────
# Réutilise STRIPE_SECRET_KEY ci-dessus. Le marchand connecte un compte
# Stripe Express (onboarding hébergé) ; les retraits deviennent des virements
# réels vers son compte bancaire. Sans clé, les retraits restent en mode manuel.
# (Réservé aux tests) pointer le SDK Stripe vers un serveur factice :
# STRIPE_API_HOST=localhost
# STRIPE_API_PORT=12111
# STRIPE_API_PROTOCOL=http

# URL publique de l'app (redirections de paiement et retour d'onboarding Stripe)
PUBLIC_URL=http://localhost:3000

# ── Mise en production ───────────────────────────────────────
# En production, mets NODE_ENV=production et une vraie base PostgreSQL :
# DATABASE_URL="postgresql://user:mot_de_passe@hote:5432/toumai"
#
# Compte administrateur initial : créé automatiquement au 1er démarrage si la
# base est vide (aucune donnée de démo). Renseigne :
# ADMIN_EMAIL=toi@exemple.com
# ADMIN_PASSWORD=un_mot_de_passe_fort   # ≥ 10 caractères
# ADMIN_NAME=Ton Nom
#
# Génère des secrets forts : openssl rand -base64 48

# ── Publication Play Store (Android TWA) — voir docs/stores.md ─
# Empreintes SHA-256 de ta clé de signature (fournies par PWABuilder/Bubblewrap).
# Active /.well-known/assetlinks.json → app plein écran sans barre d'adresse.
# ANDROID_PACKAGE_NAME=app.toumai.twa
# ANDROID_SHA256_FINGERPRINTS=AB:CD:...:EF
